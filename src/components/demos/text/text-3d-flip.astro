---
// Text 3D Flip 데모 — 마우스를 올리면(.is-active) 글자마다 가로축으로 굴러 뒷면(아랫면)의 새 글자를 보이고, --i 로 차례차례 넘어간다
// 글자 칸은 앞면과 아랫면 두 장으로 된 상자 — 상자를 90도 돌리면 아랫면이 앞으로 온다
const pairs = [
  ['A', 'G'],
  ['B', 'H'],
  ['C', 'I'],
  ['D', 'J'],
  ['E', 'K'],
  ['F', 'L'],
];
---
<div class="text-3d-flip" data-demo-root aria-hidden="true">
  <span class="t3f-word">
    {pairs.map(([front, back], i) => (
      <span class="t3f-cell">
        <span class="t3f-cube" style={`--i: ${i}`}>
          <span class="t3f-face">{front}</span>
          <span class="t3f-face t3f-back">{back}</span>
        </span>
      </span>
    ))}
  </span>
</div>

<style>
  .text-3d-flip {
    display: grid;
    place-items: center;
    container-type: inline-size;
  }
  .t3f-word {
    display: flex;
    font-size: clamp(2rem, 13cqi, 4.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }
  .t3f-cell {
    perspective: 4em;
  }
  .t3f-cube {
    display: grid;
    transform-style: preserve-3d;
    transform: translateZ(-0.5em);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 60ms);
  }
  .t3f-face {
    grid-area: 1 / 1;
    height: 1em;
    text-align: center;
    backface-visibility: hidden;
    transform: translateZ(0.5em);
  }
  .t3f-back {
    color: var(--accent);
    transform: rotateX(-90deg) translateZ(0.5em);
  }
  .text-3d-flip.is-active .t3f-cube {
    transform: translateZ(-0.5em) rotateX(90deg);
  }
</style>

---
// Text Hover Effect 데모 — 평소엔 윤곽선 글자, 마우스를 올리면(.is-active) 채운 사본이 왼쪽에서 오른쪽으로 드러나고 떼면 되감긴다
---
<div class="text-hover-effect" data-demo-root aria-hidden="true">
  <span class="the-word">
    <span class="the-outline">ABCD</span>
    <span class="the-fill">ABCD</span>
  </span>
</div>

<style>
  .text-hover-effect {
    display: grid;
    place-items: center;
    container-type: inline-size;
  }
  .the-word {
    display: grid;
    font-size: clamp(2.25rem, 17cqi, 6rem);
    font-weight: 900;
    line-height: 1.1;
  }
  .the-word > span {
    grid-area: 1 / 1;
  }
  .the-outline {
    color: transparent;
    -webkit-text-stroke: 0.02em var(--ink);
  }
  .the-fill {
    color: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 600ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .text-hover-effect.is-active .the-fill {
    clip-path: inset(0 0 0 0);
  }
</style>

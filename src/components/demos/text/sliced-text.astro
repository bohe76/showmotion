---
// Sliced Text 데모 — 작은 페이지([data-scroller])를 스크롤한 만큼(--scroll, 0~1) 제목을 세 가로 조각으로 잘라 서로 반대 방향으로 민다
// 같은 글자를 세 번 겹치고 조각마다 다른 높이만 남긴다(clip-path). 맨 위(0)에서는 조각이 맞물려 온전한 글자다
const slices = [
  { clip: 'inset(0 0 66% 0)', shift: -0.8 },
  { clip: 'inset(33% 0 33% 0)', shift: 0.6 },
  { clip: 'inset(66% 0 0 0)', shift: -0.4 },
];
---
<div class="sliced-text" data-demo-root aria-hidden="true">
  <div class="slc-page" data-scroller>
    <div class="slc-sticky">
      <span class="slc-word">
        {slices.map(({ clip, shift }) => (
          <span class="slc-slice" style={`clip-path: ${clip}; --shift: ${shift}em`}>ABC</span>
        ))}
      </span>
    </div>
    <div class="slc-spacer"></div>
  </div>
</div>

<style>
  .sliced-text {
    position: relative;
    container-type: inline-size;
  }
  .slc-page {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    /* 끝까지 스크롤해도 바깥 페이지로 넘어가지 않는다 */
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .slc-sticky {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
  }
  .slc-spacer {
    height: 200%;
  }
  .slc-word {
    display: grid;
    font-size: clamp(2.5rem, 20cqi, 7rem);
    font-weight: 900;
    line-height: 1;
    color: var(--ink);
  }
  .slc-slice {
    grid-area: 1 / 1;
    transform: translateX(calc(var(--scroll, 0) * var(--shift)));
  }
  .slc-slice:nth-child(2) {
    color: var(--accent);
  }
</style>

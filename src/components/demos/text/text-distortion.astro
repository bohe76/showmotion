---
// Text Distortion 데모 — 카드에서는 스크롤로 움직일 수 없어 흐르는 글자 줄로 대신 보인다(loop)
// 띠에 고정된 잡음 변위 필터를 걸고 그 안에서 글자 줄만 옆으로 흘려, 글자가 지나가며 일렁인다
// 같은 줄을 두 번 이어 붙이고 -50% 이동해 이음매를 숨긴다
const text = 'ABCDEFGHIJ';
---
<div class="text-distortion" data-demo-root aria-hidden="true">
  <svg class="td-defs" width="0" height="0">
    <filter id="text-distortion-warp" x="-5%" y="-30%" width="110%" height="160%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.03" numOctaves="2" seed="4" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="22" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <div class="td-band">
    <div class="td-track">
      <span>{text}</span>
      <span>{text}</span>
    </div>
  </div>
</div>

<style>
  .text-distortion {
    display: grid;
    align-content: center;
    overflow: hidden;
    container-type: inline-size;
  }
  .td-defs {
    position: absolute;
  }
  .td-band {
    padding: 0.15em 0;
    font-size: clamp(2.5rem, 16cqi, 7rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--ink);
    filter: url(#text-distortion-warp);
  }
  .td-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    animation: text-distortion-flow 14s linear infinite;
  }
  .td-track span {
    padding-right: 0.4em;
  }
  @keyframes text-distortion-flow {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

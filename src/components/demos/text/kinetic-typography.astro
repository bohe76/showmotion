---
// Kinetic Typography 데모 — 큰 글자 줄 세 개가 번갈아 반대 방향으로 흐른다
// 줄마다 같은 글을 두 번 이어 붙이고 -50% 이동해 이음매를 숨긴다. 한 벌 폭(약 10em)이 스테이지 폭보다 넓어야 틈이 보이지 않는다
const rows = ['ABC DEF GHI JKL', 'MNO PQR STU VWX', 'YZA BCD EFG HIJ'];
---
<div class="kinetic-typography" data-demo-root aria-hidden="true">
  {rows.map((text) => (
    <div class="kt-row">
      <span>{text}</span>
      <span>{text}</span>
    </div>
  ))}
</div>

<style>
  .kinetic-typography {
    display: grid;
    align-content: center;
    gap: 0.1em;
    overflow: hidden;
    container-type: inline-size;
  }
  .kt-row {
    display: flex;
    width: max-content;
    font-size: clamp(1.5rem, 11cqi, 6rem);
    font-weight: 800;
    line-height: 1.05;
    white-space: nowrap;
    color: var(--ink);
    animation: kinetic-typography-slide 16s linear infinite;
  }
  .kt-row span {
    padding-right: 0.4em;
  }
  /* 가운데 줄은 강조색으로, 반대 방향으로 흐른다 */
  .kt-row:nth-child(2) {
    color: var(--accent);
    animation-direction: reverse;
  }
  @keyframes kinetic-typography-slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

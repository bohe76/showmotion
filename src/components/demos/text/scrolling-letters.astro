---
// Scrolling Letters 데모 — 스테이지 안의 작은 페이지([data-scroller])를 스크롤한 만큼(--scroll, 0~1) 고정된 제목의 글자 띠가 다음 글자로 굴러간다
// 글자마다 굴러가기 시작하는 지점을 --i 만큼 늦춰 왼쪽 글자부터 차례로 바뀐다 (진행도 = clamp(0, 스크롤×1.6 − i×0.15, 1))
const reels = ['AEIM', 'BFJN', 'CGKO', 'DHLP', 'QRST'].map((letters) => letters.split('').join('\n'));
---
<div class="scrolling-letters" data-demo-root aria-hidden="true">
  <div class="sl-page" data-scroller>
    <div class="sl-sticky">
      <span class="sl-title">
        {reels.map((reel, i) => (
          <span class="sl-cell">
            <span class="sl-reel" style={`--i: ${i}`}>{reel}</span>
          </span>
        ))}
      </span>
    </div>
    <div class="sl-spacer"></div>
  </div>
</div>

<style>
  .scrolling-letters {
    position: relative;
    container-type: inline-size;
  }
  .sl-page {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    /* 끝까지 스크롤해도 바깥 페이지로 넘어가지 않는다 */
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .sl-sticky {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: 100%;
  }
  .sl-spacer {
    height: 200%;
  }
  .sl-title {
    display: flex;
    font-size: clamp(2rem, 13cqi, 4.5rem);
    font-weight: 800;
    /* 칸 높이 = 줄 높이. 1 이면 J·Q 꼬리가 아래 칸 글자 위로 삐져나와 보여 여유를 둔다 */
    --line: 1.3em;
    line-height: var(--line);
    color: var(--ink);
  }
  .sl-cell {
    height: var(--line);
    overflow: hidden;
  }
  .sl-reel {
    display: block;
    white-space: pre;
    text-align: center;
    transform: translateY(calc(clamp(0, var(--scroll, 0) * 1.6 - var(--i) * 0.15, 1) * -3 * var(--line)));
  }
  .sl-cell:nth-child(odd) .sl-reel {
    color: var(--accent);
  }
</style>

---
// Zoom In 데모 — .is-playing 이 붙으면 작고 투명한 상태에서 튕김 없이 원래 크기로 커지며 나타난다
---
<div class="zoom-in" data-demo-root aria-hidden="true">
  <div class="zi-block">A</div>
</div>

<style>
  .zoom-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .zi-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .zoom-in.is-playing .zi-block {
    animation: zoom-in-grow 600ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes zoom-in-grow {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

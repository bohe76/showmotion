---
// Tracking In 데모 — .is-playing 이 붙으면 넓게 벌어진 옅은 글자 사이가 좁혀지며 나타난다 (contract)
---
<div class="tracking-in" data-demo-root aria-hidden="true">
  <div class="tr-word">ABCD</div>
</div>

<style>
  .tracking-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  /* letter-spacing 은 마지막 글자 뒤에도 붙는다 — 같은 값의 text-indent 로 좌우를 맞춰 가운데를 지킨다 */
  .tr-word {
    color: var(--ink);
    font-size: 12cqw;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-indent: 0.06em;
    line-height: 1;
    white-space: nowrap;
  }
  .tracking-in.is-playing .tr-word {
    animation: tracking-in-contract 800ms cubic-bezier(0.215, 0.61, 0.355, 1) both;
  }
  @keyframes tracking-in-contract {
    0% {
      opacity: 0;
      letter-spacing: 0.6em;
      text-indent: 0.6em;
    }
    40% {
      opacity: 0.6;
    }
    100% {
      opacity: 1;
      letter-spacing: 0.06em;
      text-indent: 0.06em;
    }
  }
</style>

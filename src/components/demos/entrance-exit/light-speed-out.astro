---
// Light Speed Out 데모 — 평소에는 보이는 처음 상태, .is-playing 이 붙으면 기울어지며 오른쪽으로 빠르게 날아가 사라진다(forwards)
---
<div class="light-speed-out" data-demo-root aria-hidden="true">
  <div class="lso-block">A</div>
</div>

<style>
  .light-speed-out {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .lso-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .light-speed-out.is-playing .lso-block {
    animation: light-speed-out-right 650ms ease-in forwards;
  }
  @keyframes light-speed-out-right {
    from {
      opacity: 1;
      transform: translateX(0) skewX(0);
    }
    to {
      opacity: 0;
      transform: translateX(200%) skewX(30deg);
    }
  }
</style>

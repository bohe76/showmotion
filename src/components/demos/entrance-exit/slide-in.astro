---
// Slide In 데모 — .is-playing 이 붙으면 스테이지 왼쪽 밖에서 미끄러져 들어와 멈춘다 (투명도 변화 없음)
---
<div class="slide-in" data-demo-root aria-hidden="true">
  <div class="sli-block">A</div>
</div>

<style>
  .slide-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .sli-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .slide-in.is-playing .sli-block {
    animation: slide-in-left 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  /* 블록 폭의 2.4배를 밀어야 스테이지 밖에서 시작한다 */
  @keyframes slide-in-left {
    from {
      transform: translateX(-240%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>

---
// Roll In 데모 — .is-playing 이 붙으면 왼쪽에서 바퀴처럼 굴러 들어오며 서서히 나타난다
---
<div class="roll-in" data-demo-root aria-hidden="true">
  <div class="rli-block">A</div>
</div>

<style>
  .roll-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .rli-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .roll-in.is-playing .rli-block {
    animation: roll-in-left 1000ms ease-out both;
  }
  @keyframes roll-in-left {
    from {
      opacity: 0;
      transform: translateX(-110%) rotate(-120deg);
    }
    to {
      opacity: 1;
      transform: translateX(0) rotate(0);
    }
  }
</style>

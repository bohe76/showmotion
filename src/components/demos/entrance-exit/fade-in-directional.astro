---
// Fade In Directional 데모 — .is-playing 이 붙으면 왼쪽에서 조금 밀려 들어오며 서서히 나타난다 (Fade In Left)
---
<div class="fade-in-directional" data-demo-root aria-hidden="true">
  <div class="fid-block">A</div>
</div>

<style>
  .fade-in-directional {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .fid-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .fade-in-directional.is-playing .fid-block {
    animation: fade-in-directional-left 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes fade-in-directional-left {
    from {
      opacity: 0;
      transform: translateX(-35%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

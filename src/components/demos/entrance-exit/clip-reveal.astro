---
// Clip Reveal 데모 — .is-playing 이 붙으면 clip-path 가 왼쪽에서 오른쪽으로 열리며 블록이 드러난다
---
<div class="clip-reveal" data-demo-root aria-hidden="true">
  <div class="cr-block">A</div>
</div>

<style>
  .clip-reveal {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .cr-block {
    display: grid;
    place-items: center;
    width: 44%;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .clip-reveal.is-playing .cr-block {
    animation: clip-reveal-wipe 900ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  @keyframes clip-reveal-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>

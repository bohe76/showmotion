---
// Fade Out Directional 데모 — 평소에는 보이는 처음 상태, .is-playing 이 붙으면 아래로 조금 흘러가며 사라진다(forwards, Fade Out Down)
---
<div class="fade-out-directional" data-demo-root aria-hidden="true">
  <div class="fod-block">A</div>
</div>

<style>
  .fade-out-directional {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .fod-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .fade-out-directional.is-playing .fod-block {
    animation: fade-out-directional-down 700ms cubic-bezier(0.55, 0, 1, 0.45) forwards;
  }
  @keyframes fade-out-directional-down {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(35%);
    }
  }
</style>

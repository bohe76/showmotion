---
// Hinge 데모 — 평소에는 보이는 처음 상태, .is-playing 이 붙으면 왼쪽 위 모서리를 축으로 흔들리다 아래로 떨어져 사라진다(forwards)
---
<div class="hinge" data-demo-root aria-hidden="true">
  <div class="hg-block">A</div>
</div>

<style>
  .hinge {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  /* 매달린 블록이 왼쪽 아래 조작 안내에 닿지 않게 가운데보다 오른쪽 위에 둔다 */
  .hg-block {
    display: grid;
    place-items: center;
    width: 26%;
    aspect-ratio: 1;
    margin: -10% 0 0 16%;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 11cqw;
    font-weight: 700;
    line-height: 1;
    transform-origin: top left;
  }
  .hinge.is-playing .hg-block {
    animation: hinge-drop 2000ms forwards;
  }
  @keyframes hinge-drop {
    0% {
      opacity: 1;
      transform: translateY(0) rotate(0);
      animation-timing-function: ease-in-out;
    }
    20%,
    60% {
      transform: translateY(0) rotate(80deg);
      animation-timing-function: ease-in-out;
    }
    40%,
    80% {
      opacity: 1;
      transform: translateY(0) rotate(60deg);
      animation-timing-function: ease-in-out;
    }
    100% {
      opacity: 0;
      transform: translateY(300%) rotate(0);
    }
  }
</style>

---
// Back In 데모 — .is-playing 이 붙으면 작게 줄어든 채 위에서 내려와 제자리에서 원래 크기로 커진다
---
<div class="back-in" data-demo-root aria-hidden="true">
  <div class="bi-block">A</div>
</div>

<style>
  .back-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .bi-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .back-in.is-playing .bi-block {
    animation: back-in-down 1000ms both;
  }
  @keyframes back-in-down {
    0% {
      opacity: 0.7;
      transform: translateY(-260%) scale(0.7);
    }
    80% {
      opacity: 0.7;
      transform: translateY(0) scale(0.7);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

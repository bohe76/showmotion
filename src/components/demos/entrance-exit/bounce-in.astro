---
// Bounce In 데모 — .is-playing 이 붙으면 작은 상태에서 커지며 넘쳤다 줄었다를 반복하고 제자리에 멈춘다
---
<div class="bounce-in" data-demo-root aria-hidden="true">
  <div class="bni-block">A</div>
</div>

<style>
  .bounce-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .bni-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .bounce-in.is-playing .bni-block {
    animation: bounce-in-pop 750ms cubic-bezier(0.215, 0.61, 0.355, 1) both;
  }
  @keyframes bounce-in-pop {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    20% {
      transform: scale(1.1);
    }
    40% {
      transform: scale(0.9);
    }
    60% {
      opacity: 1;
      transform: scale(1.03);
    }
    80% {
      transform: scale(0.97);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

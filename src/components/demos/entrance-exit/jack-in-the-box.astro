---
// Jack In The Box 데모 — .is-playing 이 붙으면 아래 가운데를 축으로 작고 기운 상태에서 튀어 오르며 좌우로 흔들리다 선다
---
<div class="jack-in-the-box" data-demo-root aria-hidden="true">
  <div class="jb-block">A</div>
</div>

<style>
  .jack-in-the-box {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .jb-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
    transform-origin: center bottom;
  }
  .jack-in-the-box.is-playing .jb-block {
    animation: jack-in-the-box-pop 1000ms both;
  }
  @keyframes jack-in-the-box-pop {
    0% {
      opacity: 0;
      transform: scale(0.1) rotate(30deg);
    }
    50% {
      transform: scale(0.9) rotate(-10deg);
    }
    70% {
      transform: scale(1) rotate(3deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }
</style>

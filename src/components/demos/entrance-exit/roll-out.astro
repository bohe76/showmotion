---
// Roll Out 데모 — 평소에는 보이는 처음 상태, .is-playing 이 붙으면 오른쪽으로 바퀴처럼 굴러가며 사라진다(forwards)
---
<div class="roll-out" data-demo-root aria-hidden="true">
  <div class="rlo-block">A</div>
</div>

<style>
  .roll-out {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .rlo-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .roll-out.is-playing .rlo-block {
    animation: roll-out-right 900ms ease-in forwards;
  }
  @keyframes roll-out-right {
    from {
      opacity: 1;
      transform: translateX(0) rotate(0);
    }
    to {
      opacity: 0;
      transform: translateX(110%) rotate(120deg);
    }
  }
</style>

---
// Blur In 데모 — .is-playing 이 붙으면 흐릿하고 투명한 글자가 제자리에서 또렷해진다
---
<div class="blur-in" data-demo-root aria-hidden="true">
  <div class="bli-word">ABCD</div>
</div>

<style>
  .blur-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .bli-word {
    color: var(--ink);
    font-size: 12cqw;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
  }
  .blur-in.is-playing .bli-word {
    animation: blur-in-focus 900ms cubic-bezier(0.55, 0.085, 0.68, 0.53) both;
  }
  @keyframes blur-in-focus {
    from {
      opacity: 0;
      filter: blur(12px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
</style>

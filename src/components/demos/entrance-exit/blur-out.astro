---
// Blur Out 데모 — 평소에는 또렷한 글자, .is-playing 이 붙으면 점점 흐려지며 사라진다(forwards)
---
<div class="blur-out" data-demo-root aria-hidden="true">
  <div class="blo-word">ABCD</div>
</div>

<style>
  .blur-out {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .blo-word {
    color: var(--ink);
    font-size: 12cqw;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
  }
  .blur-out.is-playing .blo-word {
    animation: blur-out-fade 900ms cubic-bezier(0.55, 0.085, 0.68, 0.53) forwards;
  }
  @keyframes blur-out-fade {
    from {
      opacity: 1;
      filter: blur(0);
    }
    to {
      opacity: 0;
      filter: blur(12px);
    }
  }
</style>

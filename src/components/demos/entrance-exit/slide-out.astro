---
// Slide Out 데모 — 평소에는 보이는 처음 상태, .is-playing 이 붙으면 위쪽 가장자리 밖으로 미끄러져 나간다(forwards, 투명도 변화 없음)
---
<div class="slide-out" data-demo-root aria-hidden="true">
  <div class="slo-block">A</div>
</div>

<style>
  .slide-out {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .slo-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .slide-out.is-playing .slo-block {
    animation: slide-out-up 600ms cubic-bezier(0.55, 0, 1, 0.45) forwards;
  }
  @keyframes slide-out-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-200%);
    }
  }
</style>

---
// Stagger 데모 — 항목마다 --i 로 지연을 계산한다 (70ms 간격)
const rows = [72, 56, 84, 48, 64];
---
<div class="stagger" data-demo-root aria-hidden="true">
  <ul class="st-list">
    {rows.map((width, i) => (
      <li class="st-row" style={`--i: ${i}`}>
        <span class="st-dot"></span>
        <span class="st-bar" style={`width: ${width}%`}></span>
      </li>
    ))}
  </ul>
</div>

<style>
  .stagger {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  .st-list {
    width: 64%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .st-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .st-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }
  .st-bar {
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .stagger.is-playing .st-row {
    animation: stagger-in 450ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 70ms);
  }
  @keyframes stagger-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

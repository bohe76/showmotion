---
// Back Out 데모 — 평소에는 보이는 처음 상태, .is-playing 이 붙으면 작아진 채 위로 빠져나가며 사라진다(forwards)
---
<div class="back-out" data-demo-root aria-hidden="true">
  <div class="bo-block">A</div>
</div>

<style>
  .back-out {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
  }
  .bo-block {
    display: grid;
    place-items: center;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12cqw;
    font-weight: 700;
    line-height: 1;
  }
  .back-out.is-playing .bo-block {
    animation: back-out-up 1000ms forwards;
  }
  @keyframes back-out-up {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    20% {
      opacity: 0.7;
      transform: translateY(0) scale(0.7);
    }
    100% {
      opacity: 0;
      transform: translateY(-260%) scale(0.7);
    }
  }
</style>

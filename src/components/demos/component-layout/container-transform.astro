---
// Container Transform 데모 — 누를 때마다(.is-on 토글) 목록의 카드 A가 하나의 상자로 이어진 채 페이지 전체 크기로 커지며 상세 내용을 드러내고, 다시 누르면 제자리로 줄어든다
// 카드는 격자 첫 칸과 같은 자리·크기로 겹쳐 둔다 (inset 12px, 3열 간격 10px, 첫 줄 높이 48%)
---
<div class="container-transform" data-demo-root aria-hidden="true">
  <div class="ct-page">
    <div class="ct-grid">
      <span></span>
      <span class="ct-tile">B</span>
      <span class="ct-tile">C</span>
      <span class="ct-line"></span>
      <span class="ct-line ct-line--short"></span>
    </div>
    <div class="ct-card">
      <span class="ct-letter">A</span>
      <div class="ct-detail">
        <span class="ct-hero">A</span>
        <span class="ct-row"></span>
        <span class="ct-row ct-row--short"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .container-transform {
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .ct-page {
    position: relative;
    width: 62%;
    height: 80%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .ct-grid {
    position: absolute;
    inset: 12px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 48%;
    grid-auto-rows: 8px;
    gap: 10px;
  }
  .ct-tile {
    display: grid;
    place-items: center;
    font-weight: 700;
    color: var(--ink);
    background: var(--demo-muted);
    border-radius: 4px;
  }
  .ct-line {
    grid-column: 1 / -1;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .ct-line--short {
    grid-column: 1 / 3;
  }
  .ct-card {
    position: absolute;
    top: 12px;
    left: 12px;
    width: calc((100% - 44px) / 3);
    height: calc((100% - 24px) * 0.48);
    overflow: hidden;
    background: var(--accent);
    border-radius: 4px;
    transition:
      top 450ms cubic-bezier(0.22, 1, 0.36, 1),
      left 450ms cubic-bezier(0.22, 1, 0.36, 1),
      width 450ms cubic-bezier(0.22, 1, 0.36, 1),
      height 450ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 450ms ease-out,
      background-color 450ms ease-out;
  }
  .ct-letter {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: var(--on-accent);
    transition: opacity 150ms ease-out;
  }
  .ct-detail {
    position: absolute;
    inset: 12px;
    display: grid;
    grid-template-rows: 1fr 8px 8px;
    gap: 10px;
    opacity: 0;
    transition: opacity 150ms ease-out;
  }
  .ct-hero {
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .ct-row {
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .ct-row--short {
    width: 60%;
  }
  .container-transform.is-on .ct-card {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
    background: var(--surface);
  }
  .container-transform.is-on .ct-letter {
    opacity: 0;
  }
  /* 펼칠 때는 상자가 거의 다 커진 뒤 내용이 떠오르고, 접을 때는 내용이 먼저 사라진다 */
  .container-transform.is-on .ct-detail {
    opacity: 1;
    transition-delay: 250ms;
  }
</style>

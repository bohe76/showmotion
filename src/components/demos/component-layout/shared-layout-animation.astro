---
// Shared Layout Animation 데모 — 누를 때마다(.is-on 토글) 썸네일 B가 같은 요소 그대로 위쪽 큰 자리로 옮겨 가며 커지고, 다시 누르면 제 칸으로 돌아온다
// 빈 자리는 점선 칸으로 남긴다. 자리 좌표: 큰 자리 = 위 0~58%, 썸네일 줄 = 위 66%~100%, 3칸 간격 10px
---
<div class="shared-layout" data-demo-root aria-hidden="true">
  <div class="sl-box">
    <span class="sl-slot sl-slot--viewer"></span>
    <span class="sl-slot sl-slot--thumb sl-thumb-a">A</span>
    <span class="sl-slot sl-slot--thumb sl-thumb-b"></span>
    <span class="sl-slot sl-slot--thumb sl-thumb-c">C</span>
    <span class="sl-item">B</span>
  </div>
</div>

<style>
  .shared-layout {
    display: grid;
    grid-template-columns: 58%;
    place-content: center;
    cursor: pointer;
  }
  .sl-box {
    position: relative;
    aspect-ratio: 16 / 11;
  }
  .sl-slot {
    position: absolute;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: var(--ink);
    border-radius: 4px;
  }
  .sl-slot--viewer {
    top: 0;
    left: 0;
    width: 100%;
    height: 58%;
    border: 2px dashed var(--line);
  }
  .sl-slot--thumb {
    top: 66%;
    width: calc((100% - 20px) / 3);
    height: 34%;
    background: var(--demo-muted);
  }
  .sl-thumb-a {
    left: 0;
  }
  .sl-thumb-b {
    left: calc((100% - 20px) / 3 + 10px);
    background: none;
    border: 2px dashed var(--line);
  }
  .sl-thumb-c {
    right: 0;
  }
  .sl-item {
    position: absolute;
    top: 66%;
    left: calc((100% - 20px) / 3 + 10px);
    display: grid;
    place-items: center;
    width: calc((100% - 20px) / 3);
    height: 34%;
    font-size: 1rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
    transition:
      top 450ms cubic-bezier(0.22, 1, 0.36, 1),
      left 450ms cubic-bezier(0.22, 1, 0.36, 1),
      width 450ms cubic-bezier(0.22, 1, 0.36, 1),
      height 450ms cubic-bezier(0.22, 1, 0.36, 1),
      font-size 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shared-layout.is-on .sl-item {
    top: 0;
    left: 0;
    width: 100%;
    height: 58%;
    font-size: 1.75rem;
  }
</style>

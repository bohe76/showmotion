---
// Drawer Slide 데모 — .is-playing 이 붙으면 작은 페이지 왼쪽 가장자리에서 서랍 패널이 미끄러져 들어와 내용을 덮고, 뒤는 어둡게 가려진다
// 클래스가 없으면 최종 상태(서랍이 열린 페이지)
const items = [70, 54, 62, 46];
---
<div class="drawer-slide" data-demo-root aria-hidden="true">
  <div class="dw-page">
    <div class="dw-bar"></div>
    <div class="dw-hero">A</div>
    <div class="dw-line"></div>
    <div class="dw-line dw-line--short"></div>
    <div class="dw-scrim"></div>
    <div class="dw-drawer">
      <span class="dw-head"></span>
      {items.map((width) => <span class="dw-item" style={`width: ${width}%`}></span>)}
    </div>
  </div>
</div>

<style>
  .drawer-slide {
    display: grid;
    place-items: center;
  }
  .dw-page {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    width: 62%;
    height: 80%;
    padding: 12px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .dw-bar {
    width: 40%;
    height: 8px;
    margin-left: auto;
    border-radius: 2px;
    background: var(--ink);
  }
  .dw-hero {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .dw-line {
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .dw-line--short {
    width: 60%;
  }
  /* 덮개 색은 토큰에 없어 어두운 반투명 값을 직접 쓴다 — 다크 모드에서도 어둡게 가린다 */
  .dw-scrim {
    position: absolute;
    inset: 0;
    background: rgb(12 12 14 / 0.45);
  }
  .dw-drawer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    display: grid;
    align-content: start;
    gap: 12px;
    width: 46%;
    padding: 14px 12px;
    background: var(--surface);
    border-right: 1px solid var(--line);
  }
  .dw-head {
    width: 50%;
    height: 10px;
    margin-bottom: 4px;
    border-radius: 2px;
    background: var(--accent);
  }
  .dw-item {
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .drawer-slide.is-playing .dw-scrim {
    animation: drawer-slide-fade 400ms ease-out both;
  }
  .drawer-slide.is-playing .dw-drawer {
    animation: drawer-slide-in 400ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes drawer-slide-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes drawer-slide-in {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>

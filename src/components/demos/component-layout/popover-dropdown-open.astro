---
// Popover / Dropdown Open 데모 — 누를 때마다(.is-on 토글) 트리거 바로 아래에서 메뉴가 트리거 쪽 모서리를 기준으로 살짝 커지며 떠오르고, 다시 누르면 닫힌다
import ChevronDown from '@lucide/astro/icons/chevron-down';

const items = [72, 56, 64, 48];
---
<div class="popover-open" data-demo-root aria-hidden="true">
  <div class="po-anchor">
    <div class="po-trigger">
      <span class="po-label">A</span>
      <span class="po-bar"></span>
      <ChevronDown class="po-chevron" size={18} aria-hidden="true" />
    </div>
    <ul class="po-menu">
      {items.map((width) => (
        <li class="po-item">
          <span class="po-item-bar" style={`width: ${width}%`}></span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .popover-open {
    display: grid;
    grid-template-columns: 46%;
    justify-content: center;
    align-content: start;
    padding-top: 16%;
    cursor: pointer;
  }
  .po-anchor {
    position: relative;
  }
  .po-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    transition: border-color 150ms ease-out;
  }
  .po-label {
    font-weight: 700;
    color: var(--ink);
  }
  .po-bar {
    flex: 1;
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 */
  .po-trigger :global(.po-chevron) {
    flex: none;
    color: var(--ink);
  }
  .po-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    width: 100%;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    /* 트리거가 있는 위쪽 모서리에서 커져 나온다 */
    transform-origin: top left;
    opacity: 0;
    transform: scale(0.92) translateY(-4px);
    visibility: hidden;
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out,
      visibility 0s linear 150ms;
  }
  .po-item {
    padding: 7px 6px;
    border-radius: 3px;
  }
  .po-item:first-child {
    background: var(--highlight);
  }
  .po-item-bar {
    display: block;
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .po-item:first-child .po-item-bar {
    background: var(--accent);
  }
  .popover-open.is-on .po-trigger {
    border-color: var(--accent);
  }
  .popover-open.is-on .po-menu {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 200ms ease-out,
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }
</style>

---
// Tooltip Fade 데모 — 마우스를 올리면(.is-active) 잠깐 뒤 블록 위에 작은 말풍선이 아래에서 살짝 올라오며 나타나고, 떼면 바로 사라진다
---
<div class="tooltip-fade" data-demo-root aria-hidden="true">
  <div class="tf-anchor">
    <div class="tf-tip">
      <span class="tf-text"></span>
    </div>
    <div class="tf-icon">A</div>
  </div>
</div>

<style>
  .tooltip-fade {
    display: grid;
    place-items: center;
  }
  .tf-anchor {
    position: relative;
  }
  .tf-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .tf-tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    padding: 8px 12px;
    background: var(--ink);
    border-radius: 4px;
    opacity: 0;
    transform: translate(-50%, 4px);
    /* 떼면 지연 없이 빠르게 사라진다 */
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out;
  }
  /* 말풍선 꼬리 */
  .tf-tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    border: 5px solid transparent;
    border-top-color: var(--ink);
    transform: translateX(-50%);
  }
  .tf-text {
    display: block;
    width: 64px;
    height: 6px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  /* 올릴 때는 잠깐 기다렸다가 나타난다 — 지나가는 포인터에 깜빡이지 않게 */
  .tooltip-fade.is-active .tf-tip {
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      opacity 180ms ease-out 300ms,
      transform 180ms ease-out 300ms;
  }
</style>

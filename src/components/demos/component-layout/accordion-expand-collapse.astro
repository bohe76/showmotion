---
// Accordion Expand-Collapse 데모 — 누를 때마다(.is-on 토글) 가운데 항목의 패널이 제 높이까지 부드럽게 펼쳐지고 다시 접힌다
import ChevronDown from '@lucide/astro/icons/chevron-down';

const items = ['A', 'B', 'C'];
---
<div class="accordion" data-demo-root aria-hidden="true">
  <ul class="ac-list">
    {items.map((letter, i) => (
      <li class={i === 1 ? 'ac-item ac-item--open' : 'ac-item'}>
        <div class="ac-head">
          <span class="ac-letter">{letter}</span>
          <span class="ac-title"></span>
          <ChevronDown class="ac-chevron" size={18} aria-hidden="true" />
        </div>
        {i === 1 && (
          <div class="ac-panel">
            <div class="ac-body">
              <span class="ac-line"></span>
              <span class="ac-line ac-line--short"></span>
            </div>
          </div>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .accordion {
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .ac-list {
    width: 64%;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .ac-item + .ac-item {
    border-top: 1px solid var(--line);
  }
  .ac-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
  }
  .ac-letter {
    font-weight: 700;
    color: var(--ink);
  }
  .ac-title {
    flex: 1;
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 */
  .ac-head :global(.ac-chevron) {
    flex: none;
    color: var(--ink);
    transition: transform 300ms ease-out;
  }
  /* 0fr → 1fr 로 옮기면 내용의 실제 높이를 몰라도 그 높이까지 펼쳐진다 */
  .ac-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms ease-out;
  }
  .ac-body {
    display: grid;
    gap: 8px;
    overflow: hidden;
    padding: 0 12px;
  }
  .ac-line {
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }
  .ac-line:first-child {
    margin-top: 2px;
  }
  .ac-line--short {
    width: 60%;
    margin-bottom: 12px;
  }
  .accordion.is-on .ac-panel {
    grid-template-rows: 1fr;
  }
  /* 펼치면 아래 꺾쇠가 반 바퀴 돌아 위를 향한다 */
  .accordion.is-on .ac-item--open :global(.ac-chevron) {
    transform: rotate(-180deg);
  }
</style>

---
// Carousel Crossfade 데모 — 세 장이 제자리에 겹쳐 있고, 한 장이 사라지는 동안 다음 장이 동시에 떠오르며 바뀐다 (9초 주기)
// 장마다 같은 애니메이션을 3초씩 어긋나게(음수 지연) 시작해, 앞 장이 사라지는 구간과 다음 장이 떠오르는 구간이 겹친다
const slides = ['A', 'B', 'C'];
---
<div class="carousel-crossfade" data-demo-root aria-hidden="true">
  <div class="cf-view">
    {slides.map((letter, i) => (
      <div class="cf-slide" style={`--i: ${i}`}>{letter}</div>
    ))}
  </div>
  <div class="cf-dots">
    {slides.map((_, i) => <span class="cf-dot" style={`--i: ${i}`}></span>)}
  </div>
</div>

<style>
  .carousel-crossfade {
    display: grid;
    grid-template-columns: 60%;
    place-content: center;
    justify-items: center;
    gap: 12px;
  }
  .cf-view {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .cf-slide {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 6px;
    animation: carousel-crossfade-slide 9s linear infinite;
    animation-delay: calc(var(--i) * 3s - 9s);
  }
  .cf-slide:nth-child(1) {
    color: var(--on-accent);
    background: var(--accent);
  }
  .cf-slide:nth-child(2) {
    color: var(--ink);
    background: var(--demo-muted);
  }
  .cf-slide:nth-child(3) {
    color: var(--on-accent);
    background: var(--accent-strong);
  }
  .cf-dots {
    display: flex;
    gap: 6px;
  }
  .cf-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
    animation: carousel-crossfade-dot 9s linear infinite;
    animation-delay: calc(var(--i) * 3s - 9s);
  }
  @keyframes carousel-crossfade-slide {
    0%,
    28% {
      opacity: 1;
    }
    33.33%,
    95% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes carousel-crossfade-dot {
    0%,
    28% {
      opacity: 1;
    }
    33.33%,
    95% {
      opacity: 0.25;
    }
    100% {
      opacity: 1;
    }
  }
</style>

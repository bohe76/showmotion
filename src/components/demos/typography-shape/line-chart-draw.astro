---
// Line Chart Draw 데모 — 꺾은선이 데이터 점을 따라 왼쪽에서 오른쪽으로 그려지고, 선이 닿는 점마다 표식이 튀어나온다
// Map Route 와 같은 "선 그리기"지만 여기는 축과 데이터 점이 있는 그래프다: 선은 점에서 점으로 곧게 꺾이고, 표식은 점마다 그 자리에 남는다(저쪽은 표식 하나가 굽은 길을 따라간다)
// 축·눈금선과 첫 점은 처음부터 있다(빈 화면으로 시작하지 않는다)
// 시간 막대: 눈금이 선이 다음 점에 닿아 표식이 튀어나오는 지점이다. 선은 10% 에 출발해 85% 에 마지막 점에 닿는다
//   선은 길이에 대해 등속으로 그려지므로, 점마다의 시각은 x 가 아니라 거기까지의 선 길이로 계산한다
// 그래프는 화면과 같은 비율(160×90)의 SVG 에 그린다 — 1 단위 = 0.625cqw
import MgFrame from '../../mg/MgFrame.astro';

const points = [
  [30, 62],
  [50, 50],
  [70, 55],
  [90, 36],
  [110, 42],
  [130, 22],
];
const d = points.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
// 점마다: 첫 점부터 거기까지의 선 길이 → 선이 닿는 시각(전체 길이에 대한 %)
const lengths = points.map((_, i) =>
  points.slice(1, i + 1).reduce((sum, [x, y], j) => sum + Math.hypot(x - points[j][0], y - points[j][1]), 0),
);
const total = lengths[lengths.length - 1];
const START = 10;
const END = 85;
const at = lengths.map((length) => Math.round((START + ((END - START) * length) / total) * 10) / 10);
const grid = [22, 38, 54];
---
<div class="mg-line-chart-draw" data-demo-root aria-hidden="true">
  <MgFrame duration="4s" cuts={at.slice(1)}>
    <svg class="mg-line-chart-draw-art" viewBox="0 0 160 90" fill="none">
      {grid.map((y) => <path class="mg-line-chart-draw-grid" d={`M20 ${y} H142`} />)}
      {points.map(([x]) => <path class="mg-line-chart-draw-axis" d={`M${x} 70 v2.4`} />)}
      <path class="mg-line-chart-draw-axis" d="M20 12 V70 H142" />
      <path class="mg-line-chart-draw-line" pathLength="1" d={d} />
      {points.map(([x, y], i) => (
        <circle class="mg-line-chart-draw-dot" cx={x} cy={y} r="2.7" style={`--mg-line-chart-draw-at: ${at[i] / 100}`} />
      ))}
    </svg>
  </MgFrame>
</div>

<style>
  .mg-line-chart-draw-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mg-line-chart-draw-grid {
    stroke: var(--line);
    stroke-width: 0.5;
  }
  .mg-line-chart-draw-axis {
    stroke: var(--muted);
    stroke-width: 0.8;
  }
  /* 선은 길이 1 로 맞춰 두고(pathLength) 빈칸을 밀어 그린다. 빈칸을 선보다 길게 잡아 둥근 끝이 미리 비치지 않게 한다 */
  .mg-line-chart-draw-line {
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-dasharray: 1 1.2;
    stroke-dashoffset: 1.01;
  }
  .mg-line-chart-draw-dot {
    fill: var(--accent);
    stroke: var(--surface);
    stroke-width: 0.9;
    transform-box: fill-box;
    transform-origin: center;
  }
  .mg-line-chart-draw-dot:not(:first-of-type) {
    scale: 0;
  }
  .mg-line-chart-draw.is-playing .mg-line-chart-draw-line {
    animation: mg-line-chart-draw-line var(--mg-duration) linear forwards;
  }
  /* 선이 닿는 순간 튀어나온다 — 살짝 지나쳤다 자리 잡는다 */
  .mg-line-chart-draw.is-playing .mg-line-chart-draw-dot:not(:first-of-type) {
    animation: mg-line-chart-draw-pop calc(var(--mg-duration) * 0.1) ease-out calc(var(--mg-duration) * var(--mg-line-chart-draw-at)) forwards;
  }
  @keyframes mg-line-chart-draw-line {
    0%,
    10% {
      stroke-dashoffset: 1.01;
    }
    85%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes mg-line-chart-draw-pop {
    0% {
      scale: 0;
    }
    55% {
      scale: 1.45;
    }
    100% {
      scale: 1;
    }
  }
</style>

---
// Sticky Header Shrink 데모 — 작은 페이지를 조금만 내려도(--scroll 이 맨 위를 벗어나면) 위에 붙은 머리글이 얇아지고, 맨 위로 오면 돌아온다
// 머리글 바깥 상자는 높이가 그대로이고 음수 여백으로 본문 위에 겹쳐 있어, 안쪽 막대가 줄어도 본문이 튀지 않는다
const paragraphs = [
  [92, 78, 64],
  [86, 90, 58],
  [80, 72, 88],
  [94, 66, 76],
  [84, 70, 52],
];
---
<div class="header-shrink" data-demo-root aria-hidden="true">
  <div class="hk-page" data-scroller>
    <div class="hk-bar">
      <div class="hk-inner">
        <span class="hk-logo"></span>
        <span class="hk-nav"></span>
        <span class="hk-nav"></span>
        <span class="hk-nav"></span>
      </div>
    </div>
    <div class="hk-body">
      {paragraphs.map((lines) => (
        <div class="hk-para">
          {lines.map((width) => <div class="hk-line" style={`width: ${width}%`}></div>)}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .header-shrink {
    display: grid;
    /* 행을 스테이지 높이로 묶어야 안쪽 페이지가 넘치지 않고 스크롤된다 */
    grid-template-rows: minmax(0, 1fr);
    padding: 14px 14% 0;
  }
  .hk-page {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    container-type: size;
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .hk-bar {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 56px;
    margin-bottom: -56px;
  }
  .hk-inner {
    /* 맨 위를 조금 벗어나면 0 → 1 로 넘어가는 스위치 — 값이 바뀌는 순간 transition 이 부드럽게 잇는다 */
    --shrunk: clamp(0, (var(--scroll, 0) - 0.02) * 400, 1);
    display: flex;
    align-items: center;
    gap: 10px;
    height: calc(56px - var(--shrunk) * 20px);
    padding: 0 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    transition: height 250ms ease;
  }
  .hk-logo {
    width: 28px;
    height: 28px;
    margin-right: auto;
    border-radius: 5px;
    background: var(--accent);
    transform: scale(calc(1 - var(--shrunk) * 0.35));
    transform-origin: left center;
    transition: transform 250ms ease;
  }
  .hk-nav {
    width: 12%;
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .hk-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 300cqh;
    padding: 74px 16px 24px;
  }
  .hk-para {
    display: grid;
    gap: 10px;
  }
  .hk-line {
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .hk-line:first-child {
    height: 12px;
    background: var(--ink);
  }
</style>

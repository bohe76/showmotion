---
// Scroll-Linked Animation 데모 — 고정된 장면 안에서 도형이 --scroll 에 그대로 묶여 옆으로 가며 돌고 둥글어진다
// 시간으로 흐르는 전환이 없어, 올리면 그 자리에서 되감긴다
---
<div class="scroll-linked" data-demo-root aria-hidden="true">
  <div class="sl-page" data-scroller>
    <div class="sl-track">
      <div class="sl-scene">
        <div class="sl-rail">
          <div class="sl-shape">A</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .scroll-linked {
    display: grid;
    /* 행을 스테이지 높이로 묶어야 안쪽 페이지가 넘치지 않고 스크롤된다 */
    grid-template-rows: minmax(0, 1fr);
    padding: 14px 14% 0;
  }
  .sl-page {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    container-type: size;
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .sl-track {
    height: 300cqh;
  }
  .sl-scene {
    position: sticky;
    top: 0;
    display: grid;
    align-content: center;
    height: 100cqh;
    padding: 0 10%;
  }
  /* 레일 높이 = 도형 한 변(레일 폭의 22%) */
  .sl-rail {
    position: relative;
    aspect-ratio: 100 / 22;
  }
  .sl-rail::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--line);
  }
  .sl-shape {
    position: absolute;
    top: 0;
    left: calc(var(--scroll, 0) * 78%);
    display: grid;
    place-items: center;
    width: 22%;
    aspect-ratio: 1;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: calc(var(--scroll, 0) * 50%);
    transform: rotate(calc(var(--scroll, 0) * 1turn));
  }
</style>

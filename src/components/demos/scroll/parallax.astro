---
// Parallax 데모 — 앞쪽 카드는 스크롤과 같은 속도로, 뒤 두 겹은 --scroll 에 맞춰 더 느리게(먼 겹일수록 덜) 올라간다
// 앞 내용은 약 1.9화면을 움직이고, 가운데 겹은 약 0.9화면, 먼 겹은 약 0.4화면만 움직인다
const far = [
  { top: 6, left: 8, size: 10 },
  { top: 18, left: 70, size: 14 },
  { top: 36, left: 34, size: 8 },
  { top: 52, left: 82, size: 10 },
  { top: 66, left: 12, size: 12 },
  { top: 84, left: 56, size: 9 },
];
const mid = [
  { top: 10, left: 58, size: 22 },
  { top: 30, left: 4, size: 18 },
  { top: 52, left: 64, size: 20 },
  { top: 74, left: 20, size: 22 },
];
const cards = ['A', 'B', 'C', 'D'];
---
<div class="parallax" data-demo-root aria-hidden="true">
  <div class="px-window">
    <div class="px-layer px-far">
      {far.map((s) => <span class="px-dot" style={`top: ${s.top}%; left: ${s.left}%; width: ${s.size}%`}></span>)}
    </div>
    <div class="px-layer px-mid">
      {mid.map((s) => <span class="px-block" style={`top: ${s.top}%; left: ${s.left}%; width: ${s.size}%`}></span>)}
    </div>
    <div class="px-page" data-scroller>
      {cards.map((letter) => (
        <div class="px-card">
          <span class="px-badge">{letter}</span>
          <span class="px-line"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .parallax {
    display: grid;
    /* 행을 스테이지 높이로 묶어야 안쪽 창이 넘치지 않는다 */
    grid-template-rows: minmax(0, 1fr);
    padding: 14px 14% 0;
  }
  .px-window {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .px-layer {
    position: absolute;
    inset: 0 0 auto;
  }
  /* 겹 높이 × 옮기는 비율 = 움직이는 거리 — 먼 겹 140% × 28.6% ≈ 0.4화면, 가운데 겹 200% × 46.5% ≈ 0.9화면 */
  .px-far {
    height: 140%;
    transform: translateY(calc(var(--scroll, 0) * -28.6%));
  }
  .px-mid {
    height: 200%;
    transform: translateY(calc(var(--scroll, 0) * -46.5%));
  }
  .px-dot,
  .px-block {
    position: absolute;
    aspect-ratio: 1;
  }
  .px-dot {
    border-radius: 50%;
    background: var(--line);
  }
  .px-block {
    border-radius: 8px;
    background: var(--demo-muted);
    opacity: 0.7;
  }
  .px-page {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    /* 카드 간격을 창 높이(cqh) 기준으로 잡아 앞 내용이 늘 약 2.9화면 길이가 된다 */
    container-type: size;
  }
  .px-card {
    display: grid;
    align-content: center;
    gap: 10px;
    width: 46%;
    height: 34cqh;
    margin: 30cqh 0 0 8%;
    padding: 0 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .px-card:nth-child(even) {
    margin-left: 46%;
  }
  .px-card:last-child {
    margin-bottom: 30cqh;
  }
  .px-badge {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .px-line {
    width: 80%;
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
</style>

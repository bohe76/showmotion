---
// Scroll-Triggered Animation 데모 — 작은 페이지의 카드가 화면에 들어오면 한 번 떠오르며 나타난다 (스크롤 위치가 아니라 시간으로 흐른다)
// 스크립트가 루트에 .is-armed 를 붙인 뒤에만 숨긴다 — 스크립트가 없으면 카드는 그냥 보인다
const cards = [72, 58, 84, 64, 76, 52];
---
<div class="scroll-trigger" data-demo-root aria-hidden="true">
  <div class="tr-page" data-scroller>
    {cards.map((width) => (
      <div class="tr-card">
        <span class="tr-media"></span>
        <span class="tr-line" style={`width: ${width}%`}></span>
      </div>
    ))}
  </div>
</div>

<style>
  .scroll-trigger {
    display: grid;
    /* 행을 스테이지 높이로 묶어야 안쪽 페이지가 넘치지 않고 스크롤된다 */
    grid-template-rows: minmax(0, 1fr);
    padding: 14px 14% 0;
  }
  .tr-page {
    display: grid;
    align-content: start;
    padding: 0 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    /* 카드 간격을 페이지 높이(cqh) 기준으로 잡아 한 화면에 카드가 두세 장만 보이게 한다 */
    container-type: size;
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .tr-card {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 26cqh;
    margin-top: 16cqh;
    padding: 0 12px;
    background: var(--stage);
    border: 1px solid var(--line);
    border-radius: 6px;
    transition:
      opacity 500ms ease-out,
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tr-card:first-child {
    margin-top: 14px;
  }
  .tr-card:last-child {
    margin-bottom: 40cqh;
  }
  .scroll-trigger.is-armed .tr-card:not(.is-in) {
    opacity: 0;
    transform: translateY(28px);
  }
  .tr-media {
    flex: none;
    height: 60%;
    aspect-ratio: 1;
    border-radius: 4px;
    background: var(--accent);
  }
  .tr-line {
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
</style>

<script>
  // 들어올 때 1회 재생은 스크롤 위치로 풀 수 없어, 스크롤 영역을 기준으로 한 IntersectionObserver 가 카드에 .is-in 을 붙인다
  document.querySelectorAll<HTMLElement>('.scroll-trigger').forEach((root) => {
    const scroller = root.querySelector<HTMLElement>('[data-scroller]');
    if (!scroller) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.intersectionRatio >= 0.3) entry.target.classList.add('is-in');
          // 아래로 완전히 빠졌을 때만 되돌린다 — 다시 내려오면 한 번 더 재생된다
          else if (!entry.isIntersecting && entry.rootBounds && entry.boundingClientRect.top >= entry.rootBounds.bottom)
            entry.target.classList.remove('is-in');
        }
      },
      { root: scroller, threshold: [0, 0.3] },
    );
    root.querySelectorAll('.tr-card').forEach((card) => observer.observe(card));
    root.classList.add('is-armed');
  });
</script>

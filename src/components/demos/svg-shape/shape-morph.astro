---
// Shape Morph 데모 — .is-playing 이 붙으면 오각형이 잠깐 머문 뒤 별로 매끄럽게 바뀐다, 없으면 별(최종 상태)
// 두 모양을 같은 점 10개로 적어야 점끼리 짝지어 보간된다 — 오각형은 별의 안쪽 점 자리에 변의 가운데 점을 둔다
---
<div class="shape-morph" data-demo-root aria-hidden="true">
  <div class="sm-shape"></div>
</div>

<style>
  .shape-morph {
    display: grid;
    place-items: center;
  }
  .sm-shape {
    width: 40%;
    aspect-ratio: 1;
    background: var(--accent);
    clip-path: polygon(
      50% 4.8%,
      61.8% 38.6%,
      97.6% 39.3%,
      69% 61%,
      79.4% 95.2%,
      50% 74.8%,
      20.6% 95.2%,
      31% 61%,
      2.4% 39.3%,
      38.2% 38.6%
    );
  }
  .shape-morph.is-playing .sm-shape {
    animation: shape-morph-to-star 1300ms ease-in-out both;
  }
  @keyframes shape-morph-to-star {
    0%,
    30% {
      background: var(--ink);
      clip-path: polygon(
        50% 4.8%,
        73.8% 22.1%,
        97.6% 39.3%,
        88.5% 67.3%,
        79.4% 95.2%,
        50% 95.2%,
        20.6% 95.2%,
        11.5% 67.3%,
        2.4% 39.3%,
        26.2% 22.1%
      );
    }
  }
</style>

---
// Orbiting Circles 데모 — 가운데 블록 둘레의 두 궤도에서 작은 원들이 돈다 (바깥 궤도는 반대 방향, 더 느리게)
// 궤도 자체를 돌리고 원은 궤도 위 고정 자리에 둔다 — 자리는 각도로 계산한다
const place = (deg: number) => {
  const rad = (deg * Math.PI) / 180;
  return `left: ${50 + 50 * Math.cos(rad)}%; top: ${50 + 50 * Math.sin(rad)}%`;
};
const inner = [-90, 90];
const outer = [-30, 90, 210];
---
<div class="orbiting-circles" data-demo-root aria-hidden="true">
  <div class="oc-system">
    <div class="oc-ring oc-ring--outer">
      {outer.map((deg) => <span class="oc-dot" style={place(deg)}></span>)}
    </div>
    <div class="oc-ring oc-ring--inner">
      {inner.map((deg) => <span class="oc-dot oc-dot--ink" style={place(deg)}></span>)}
    </div>
    <div class="oc-core">A</div>
  </div>
</div>

<style>
  .orbiting-circles {
    display: grid;
    place-items: center;
  }
  .oc-system {
    position: relative;
    height: 80%;
    aspect-ratio: 1;
  }
  .oc-ring {
    position: absolute;
    border: 1px dashed var(--demo-muted);
    border-radius: 50%;
  }
  .oc-ring--outer {
    inset: 4%;
    animation: orbiting-circles-spin 18s linear infinite reverse;
  }
  .oc-ring--inner {
    inset: 24%;
    animation: orbiting-circles-spin 10s linear infinite;
  }
  .oc-dot {
    position: absolute;
    width: 10%;
    aspect-ratio: 1;
    background: var(--accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .oc-ring--inner .oc-dot {
    width: 17%;
  }
  .oc-dot--ink {
    background: var(--ink);
  }
  .oc-core {
    position: absolute;
    inset: 38%;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 50%;
  }
  @keyframes orbiting-circles-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

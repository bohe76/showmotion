---
// Motion Path 데모 — 화살표가 닫힌 곡선 경로를 따라 계속 돌고, 진행 방향으로 머리를 돌린다(offset-rotate: auto)
// 경로 문자열 하나를 보이는 선(d)과 이동 경로(offset-path)에 함께 쓴다 — 화살표를 같은 SVG 안에 두어 좌표가 viewBox 와 함께 늘어난다
const route =
  'M 80 150 C 80 80 150 60 200 95 S 320 70 320 150 S 250 230 200 205 S 80 220 80 150 Z';
---
<div class="motion-path" data-demo-root aria-hidden="true">
  <svg class="mp-svg" viewBox="0 0 400 300">
    <path class="mp-route" d={route} />
    <polygon class="mp-traveller" points="-11,-8 11,0 -11,8 -6,0" style={`offset-path: path('${route}')`} />
  </svg>
</div>

<style>
  .motion-path {
    display: grid;
    place-items: center;
  }
  .mp-svg {
    width: 100%;
    height: 100%;
  }
  .mp-route {
    fill: none;
    stroke: var(--demo-muted);
    stroke-width: 3;
    stroke-dasharray: 2 8;
    stroke-linecap: round;
  }
  .mp-traveller {
    fill: var(--accent);
    offset-rotate: auto;
    animation: motion-path-travel 6s linear infinite;
  }
  /* 닫힌 경로라 끝(100%)이 처음(0%)과 같은 자리 — 이음매 없이 반복된다 */
  @keyframes motion-path-travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
</style>

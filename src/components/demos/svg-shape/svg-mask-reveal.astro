---
// SVG Mask Reveal 데모 — 마우스를 올리면(.is-active) 가운데서 원형 마스크가 넓어지며 아래 겹의 내용을 드러낸다, 떼면 다시 닫힌다
---
<div class="svg-mask-reveal" data-demo-root aria-hidden="true">
  <div class="smr-panel smr-panel--base">
    <span class="smr-line smr-line--title"></span>
    <span class="smr-line"></span>
    <span class="smr-line smr-line--short"></span>
  </div>
  <div class="smr-panel smr-panel--reveal">A</div>
</div>

<style>
  .svg-mask-reveal {
    display: grid;
    place-items: center;
    container-type: inline-size;
  }
  .smr-panel {
    grid-area: 1 / 1;
    width: 60%;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
  }
  .smr-panel--base {
    display: grid;
    align-content: center;
    gap: 10px;
    padding: 0 12%;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .smr-line {
    height: 8px;
    background: var(--demo-muted);
    border-radius: 2px;
  }
  .smr-line--title {
    width: 70%;
    height: 12px;
    background: var(--ink);
  }
  .smr-line--short {
    width: 45%;
  }
  .smr-panel--reveal {
    display: grid;
    place-items: center;
    font-size: clamp(2rem, 14cqi, 5rem);
    font-weight: 800;
    color: var(--on-accent);
    background: var(--accent);
    clip-path: circle(0% at 50% 50%);
    transition: clip-path 450ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .svg-mask-reveal.is-active .smr-panel--reveal {
    clip-path: circle(75% at 50% 50%);
  }
</style>

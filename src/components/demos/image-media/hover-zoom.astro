---
// Hover Zoom 데모 — 마우스를 올리면(.is-active) 액자 안의 그림(해와 언덕)이 천천히 커지고, 액자 크기는 그대로다
---
<div class="hover-zoom" data-demo-root aria-hidden="true">
  <div class="hz-frame">
    <div class="hz-image">
      <span class="hz-sun"></span>
      <span class="hz-hill hz-hill-far"></span>
      <span class="hz-hill"></span>
    </div>
  </div>
</div>

<style>
  .hover-zoom {
    display: grid;
    place-items: center;
  }
  .hz-frame {
    width: 52%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
  }
  .hz-image {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--highlight);
    transition: transform 500ms ease-out;
  }
  .hover-zoom.is-active .hz-image {
    transform: scale(1.18);
  }
  .hz-sun {
    position: absolute;
    top: 18%;
    left: 62%;
    width: 18%;
    aspect-ratio: 1;
    background: var(--accent);
    border-radius: 50%;
  }
  .hz-hill {
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 80%;
    aspect-ratio: 1;
    background: var(--accent-strong);
    border-radius: 50%;
  }
  .hz-hill-far {
    left: 40%;
    bottom: -45%;
    /* 먼 언덕은 연하게 — 해(--accent)와 같은 색이면 두 도형이 붙어 보인다 */
    background: color-mix(in srgb, var(--accent) 50%, var(--highlight));
  }
</style>

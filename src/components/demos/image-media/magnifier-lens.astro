---
// Magnifier Lens 데모 — 포인터 자리(--mx, --my)의 둥근 렌즈 안에 같은 그림이 두 배로 확대되어 보인다
// 포인터가 없으면 가운데를 비춘다. 렌즈 안의 그림은 바깥 그림을 그대로 한 벌 더 그린 것이다
const tiles = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
---
<div class="magnifier-lens" data-demo-root aria-hidden="true">
  <div class="ml-image">
    {tiles.map((tile) => <span>{tile}</span>)}
  </div>
  <div class="ml-lens">
    <div class="ml-image ml-zoom">
      {tiles.map((tile) => <span>{tile}</span>)}
    </div>
  </div>
</div>

<style>
  .magnifier-lens {
    position: relative;
    overflow: hidden;
    cursor: none;
    /* 렌즈 안의 그림을 스테이지와 같은 크기(cqw, cqh)로 그리고, 포인터 위치를 길이로 바꾸는 데 쓴다 */
    container-type: size;
  }
  .ml-image {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-content: center;
    gap: 3cqw;
    width: 100cqw;
    height: 100cqh;
    padding: 0 20cqw;
    background: var(--stage);
  }
  .ml-image span {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 4cqw;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .ml-image span:nth-child(even) {
    color: var(--ink);
    background: var(--highlight);
  }
  .ml-lens {
    position: absolute;
    top: calc(var(--my, 0.5) * 100cqh);
    left: calc(var(--mx, 0.5) * 100cqw);
    width: clamp(72px, 28cqw, 150px);
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  /* 포인터 아래 지점이 렌즈 가운데(50%)에 오도록 옮긴 뒤 두 배로 키운다 */
  .ml-zoom {
    top: calc(50% - var(--my, 0.5) * 100cqh * 2);
    left: calc(50% - var(--mx, 0.5) * 100cqw * 2);
    transform: scale(2);
    transform-origin: 0 0;
  }
</style>

---
// 3D Tilt 데모 — 포인터 쪽(--mx, --my)으로 카드가 원근으로 기울고, 안쪽 층(블록·막대)은 서로 다른 깊이로 떠오른다
// 포인터가 떠나면(.is-active 없음) 평평하게 돌아온다 — 위치 변수는 떠난 뒤에도 남으므로 클래스로 되돌린다
// 클래스 이름은 숫자로 시작할 수 없어 tilt-3d 로 쓴다
---
<div class="tilt-3d" data-demo-root aria-hidden="true">
  <div class="t3-view">
    <div class="t3-card">
      <span class="t3-mark">A</span>
      <span class="t3-bar"></span>
      <span class="t3-bar t3-bar--short"></span>
    </div>
  </div>
</div>

<style>
  .tilt-3d {
    overflow: hidden;
  }
  .t3-view {
    display: grid;
    place-items: center;
    height: 100%;
    perspective: 800px;
  }
  .t3-card {
    display: grid;
    align-content: center;
    gap: 10px;
    width: 50%;
    aspect-ratio: 4 / 3;
    padding: 0 9%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    transform-style: preserve-3d;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .t3-mark,
  .t3-bar {
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .t3-mark {
    display: grid;
    place-items: center;
    width: 26%;
    aspect-ratio: 1;
    margin-bottom: 4px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .t3-bar {
    height: 10px;
    background: var(--ink);
    border-radius: 2px;
  }
  .t3-bar--short {
    width: 60%;
    height: 8px;
    background: var(--demo-muted);
  }
  /* 움직이는 동안은 짧게 따라가고, 떠나면 위의 긴 전환으로 천천히 평평해진다 */
  .tilt-3d.is-active .t3-card {
    transform: rotateX(calc((var(--my, 0.5) - 0.5) * 22deg)) rotateY(calc((0.5 - var(--mx, 0.5)) * 26deg));
    transition-duration: 120ms;
  }
  .tilt-3d.is-active .t3-mark {
    transform: translateZ(48px);
  }
  .tilt-3d.is-active .t3-bar {
    transform: translateZ(28px);
  }
</style>

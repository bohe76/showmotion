---
// Datamosh 데모 — 컷(40%)에서 다음 샷(D)으로 넘어갔는데 앞 샷의 그림이 지워지지 않고 남는다. 남은 그림이 다음 샷의 움직임에 끌려가며 블록째 번지고 녹아내리다가, 조각조각 다음 샷으로 바뀐다
// 영상 압축에서 온전한 그림(I 프레임)을 빼면 생기는 일이다: 다음 샷은 "어디가 어떻게 움직였나"만 전하고, 그 움직임이 화면에 남아 있던 앞 샷의 픽셀에 적용된다
// 시간 막대: 눈금이 컷, 띠가 녹는 구간(40~84%)이다. 그 앞은 멀쩡한 영상이고, 84% 뒤는 멀쩡한 다음 샷이다
// 한순간 띠로 어긋났다가 제자리로 돌아오는 Glitch Effect 와 다르다: 컷 지점에서 일어나고, 천천히 흘러내리고, 돌아오지 않는다. 블록 크기가 고르게 변하는 Pixelate 와도 다르다(블록마다 따로 끌려간다)
// 겹:
//   밑 — 영상(MgFxFootage). 컷까지 보인다
//   .mg-datamosh-next — 다음 샷 D. 컷에서 켜지고, 큰 원이 오른쪽으로 간다(이 움직임이 앞 샷의 픽셀을 끈다)
//   .mg-datamosh-stuck × 4 — 컷 순간에 멈춘 앞 샷. 블록 격자(16 × 9)를 네 묶음으로 나눠 묶음마다 제 블록만 보인다(mask)
//     묶음마다 원이 가는 쪽으로 뚝뚝 끌려가고(step-end), 끌려갈수록 가로로 번지고, 제 차례에 사라진다(56 · 66 · 76 · 84%) — 그 자리에 다음 샷이 드러난다
// 번짐은 가로로만 흐리는 SVG 필터다. 필터가 mask 보다 먼저 걸려서 블록의 모서리는 또렷하고 그 안의 그림만 번진다
// 필터 주소는 루트의 인라인 스타일에 둔다 — 따로 떨어진 CSS 파일 안의 url(#…) 을 그 파일 기준으로 찾는 브라우저가 있다
import MgFrame from '../../mg/MgFrame.astro';
import MgFxFootage from '../../mg/MgFxFootage.astro';
import MgScene from '../../mg/MgScene.astro';
import MgShot from '../../mg/MgShot.astro';

// 블록 격자: 칸은 화면 폭의 1/16(6.25cqw) 정사각형. 두 칸씩 묶어 네 묶음에 고르게 흩는다
const COLS = 16;
const ROWS = 9;
const CELL = 100 / COLS;
const groupOf = (col: number, row: number) => (Math.floor(col / 2) * 3 + row * 5 + ((Math.floor(col / 2) * row) % 3)) % 4;
// 묶음마다: 같은 줄에서 이어진 칸을 한 조각으로 합쳐 mask 의 겹으로 쓴다(조각끼리 0.2cqw 겹친다 — 딱 맞대면 실금이 보인다)
const masks = [0, 1, 2, 3].map((group) => {
  const parts: string[] = [];
  for (let row = 0; row < ROWS; row++) {
    for (let col = 0; col < COLS; col++) {
      if (groupOf(col, row) !== group) continue;
      let end = col;
      while (end + 1 < COLS && groupOf(end + 1, row) === group) end++;
      const x = (col * CELL - 0.1).toFixed(2);
      const y = (row * CELL - 0.1).toFixed(2);
      const w = ((end - col + 1) * CELL + 0.2).toFixed(2);
      parts.push(`linear-gradient(#000 0 0) ${x}cqw ${y}cqw / ${w}cqw ${(CELL + 0.2).toFixed(2)}cqw no-repeat`);
      col = end;
    }
  }
  return parts.join(', ');
});
// 묶음마다: 남아 있는 길이(전체 길이에 대한 비율) · 끌려가는 거리(cqw, 가로 · 세로)
const stuck = [
  { life: 0.16, dx: 8, dy: 1 },
  { life: 0.26, dx: 13, dy: 2 },
  { life: 0.36, dx: 10, dy: 3.5 },
  { life: 0.44, dx: 15, dy: 5 },
];
---
<div
  class="mg-datamosh"
  data-demo-root
  aria-hidden="true"
  style="--mg-datamosh-soft: url(#mg-datamosh-soft); --mg-datamosh-full: url(#mg-datamosh-full)"
>
  <MgFrame duration="5s" cuts={[40]} ranges={[[40, 84]]}>
    <MgFxFootage />
    <div class="mg-datamosh-next">
      <MgShot shot="d" />
    </div>
    {stuck.map(({ life, dx, dy }, i) => (
      <div class="mg-datamosh-stuck" style={`--life: ${life}; --dx: ${dx}cqw; --dy: ${dy}cqw; --mg-datamosh-mask: ${masks[i]}`}>
        <MgScene bleed />
      </div>
    ))}
  </MgFrame>
  <svg class="mg-datamosh-defs" width="0" height="0" focusable="false">
    <defs>
      <filter id="mg-datamosh-soft" x="0" y="0" width="1" height="1" primitiveUnits="objectBoundingBox" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="0.02 0"></feGaussianBlur>
      </filter>
      <filter id="mg-datamosh-full" x="0" y="0" width="1" height="1" primitiveUnits="objectBoundingBox" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="0.06 0"></feGaussianBlur>
      </filter>
    </defs>
  </svg>
</div>

<style>
  .mg-datamosh-defs {
    position: absolute;
  }
  .mg-datamosh-next,
  .mg-datamosh-stuck {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  /* 넘친 것을 잘라 둔다 — 넘친 것까지 필터의 기준 상자로 치는 브라우저에서는 번짐이 그만큼 길어진다 */
  .mg-datamosh-stuck {
    overflow: hidden;
    background: var(--surface);
    -webkit-mask: var(--mg-datamosh-mask);
    mask: var(--mg-datamosh-mask);
  }
  /* 컷 순간(40%)의 B 자리에 멈춰 있다 — 영상의 B 가 그때 있는 곳(-3cqw 에서 3cqw 로 가는 길의 18/40) */
  .mg-datamosh-stuck :global(.mgs-b) {
    translate: -0.3cqw 0;
  }
  .mg-datamosh.is-playing .mg-datamosh-next {
    animation: mg-datamosh-cut var(--mg-duration) step-end forwards;
  }
  .mg-datamosh.is-playing :global(.mgsh-subject) {
    animation: mg-datamosh-move var(--mg-duration) linear forwards;
  }
  /* 컷에서 시작해 묶음마다 제 길이만큼 남는다. 지연 동안은 감춰져 있다(앞으로 채우지 않는다) */
  .mg-datamosh.is-playing .mg-datamosh-stuck {
    animation: mg-datamosh-drag calc(var(--mg-duration) * var(--life)) step-end calc(var(--mg-duration) * 0.4) forwards;
  }
  @keyframes mg-datamosh-cut {
    0% {
      visibility: hidden;
    }
    40%,
    100% {
      visibility: visible;
    }
  }
  @keyframes mg-datamosh-move {
    0%,
    40% {
      translate: 0 0;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.4, 1);
    }
    100% {
      translate: 30cqw 0;
    }
  }
  @keyframes mg-datamosh-drag {
    0% {
      visibility: visible;
      translate: 0 0;
      filter: none;
    }
    20% {
      visibility: visible;
      translate: calc(var(--dx) * 0.15) 0;
      filter: none;
    }
    40% {
      visibility: visible;
      translate: calc(var(--dx) * 0.35) calc(var(--dy) * 0.2);
      filter: var(--mg-datamosh-soft);
    }
    60% {
      visibility: visible;
      translate: calc(var(--dx) * 0.6) calc(var(--dy) * 0.5);
      filter: var(--mg-datamosh-soft);
    }
    80% {
      visibility: visible;
      translate: var(--dx) var(--dy);
      filter: var(--mg-datamosh-full);
    }
    100% {
      visibility: hidden;
    }
  }
</style>

---
// Morphing 데모 — 화면 속 대상이 다른 대상으로 변한다: 사각형 B → 원 D → 마름모 F. 윤곽이 매끄럽게 휘어 가는 동안 색과 글자는 겹쳐 넘어간다
// 사라졌다 나타나거나 바꿔치기하지 않는다 — 한 덩어리가 그대로 다음 모양이 된다. 배경(장면)은 그대로다
// 시간 막대의 띠가 변하는 구간이다(15~40% · 60~85%). 키프레임의 % 와 같은 값이어야 한다
// 글자의 획이 다음 글자의 획이 되는 Text Morph 와 다르다: 여기는 그림(대상) 전체가 변하고, 속의 내용은 겹쳐 넘어간다(cross-dissolve)
// 윤곽은 세 모양을 같은 점 32개로 적은 다각형이다(각 모양의 중심에서 같은 각도로 쏜 선이 윤곽과 만나는 점) — 점끼리 짝지어 이어진다
//   대상은 장면의 B 자리에 선다(26cqw 상자, 밑변이 B 의 밑변). 세 모양 모두 밑이 바닥의 같은 높이에 닿는다. 장면의 B 는 감춘다
import MgFrame from '../../mg/MgFrame.astro';
import MgScene from '../../mg/MgScene.astro';

const count = 32;
// 상자에 대한 % 좌표. 맨 위에서 시계 방향으로 돈다
function outline(cx: number, cy: number, reach: (dx: number, dy: number) => number): string {
  const points = Array.from({ length: count }, (_, k) => {
    const angle = (k / count) * 2 * Math.PI;
    const [dx, dy] = [Math.sin(angle), -Math.cos(angle)];
    const r = reach(dx, dy);
    return `${(cx + dx * r).toFixed(2)}% ${(cy + dy * r).toFixed(2)}%`;
  });
  return `polygon(${points.join(', ')})`;
}
// 사각형(한 변 18cqw) · 원(지름 24cqw) · 마름모(대각선 26cqw)
const square = outline(50, 65.38, (dx, dy) => 34.62 / Math.max(Math.abs(dx), Math.abs(dy)));
const circle = outline(50, 53.85, () => 46.15);
const diamond = outline(50, 50, (dx, dy) => 50 / (Math.abs(dx) + Math.abs(dy)));
const shapes = `--mg-morphing-b: ${square}; --mg-morphing-d: ${circle}; --mg-morphing-f: ${diamond}`;
---
<div class="mg-morphing" data-demo-root aria-hidden="true">
  <MgFrame duration="5s" ranges={[[15, 40], [60, 85]]}>
    <MgScene />
    <div class="mg-morphing-subject" style={shapes}>
      <span class="mg-morphing-letter mg-morphing-letter-b">B</span>
      <span class="mg-morphing-letter mg-morphing-letter-d">D</span>
      <span class="mg-morphing-letter mg-morphing-letter-f">F</span>
    </div>
  </MgFrame>
</div>

<style>
  .mg-morphing :global(.mgs-b) {
    visibility: hidden;
  }
  .mg-morphing-subject {
    position: absolute;
    bottom: 16%;
    left: calc(50% - 13cqw);
    width: 26cqw;
    aspect-ratio: 1;
    font-weight: 700;
    line-height: 1;
    background: var(--accent);
    clip-path: var(--mg-morphing-b);
  }
  /* 글자는 제 모양의 중심에 선다(상자의 가로 가운데, 세로는 모양마다 다르다) */
  .mg-morphing-letter {
    position: absolute;
    left: 0;
    width: 100%;
    text-align: center;
    translate: 0 -50%;
  }
  .mg-morphing-letter-b {
    top: 65.38%;
    font-size: 8cqw;
    color: var(--on-accent);
  }
  .mg-morphing-letter-d {
    top: 53.85%;
    font-size: 10cqw;
    color: var(--surface);
    opacity: 0;
  }
  .mg-morphing-letter-f {
    top: 50%;
    font-size: 9cqw;
    color: var(--surface);
    opacity: 0;
  }
  .mg-morphing.is-playing .mg-morphing-subject {
    animation: mg-morphing-warp var(--mg-duration) linear forwards;
  }
  .mg-morphing.is-playing .mg-morphing-letter-b {
    animation: mg-morphing-first var(--mg-duration) linear forwards;
  }
  .mg-morphing.is-playing .mg-morphing-letter-d {
    animation: mg-morphing-second var(--mg-duration) linear forwards;
  }
  .mg-morphing.is-playing .mg-morphing-letter-f {
    animation: mg-morphing-third var(--mg-duration) linear forwards;
  }
  /* B 로 머물다 15~40% 에 D 가 되고, 머물다 60~85% 에 F 가 된다 */
  @keyframes mg-morphing-warp {
    0% {
      background: var(--accent);
      clip-path: var(--mg-morphing-b);
    }
    15% {
      background: var(--accent);
      clip-path: var(--mg-morphing-b);
      animation-timing-function: ease-in-out;
    }
    40% {
      background: var(--ink);
      clip-path: var(--mg-morphing-d);
    }
    60% {
      background: var(--ink);
      clip-path: var(--mg-morphing-d);
      animation-timing-function: ease-in-out;
    }
    85%,
    100% {
      background: var(--muted);
      clip-path: var(--mg-morphing-f);
    }
  }
  /* 글자는 변하는 구간 안에서 겹쳐 넘어간다 — 앞 글자는 커지며 옅어지고, 다음 글자는 작은 데서 커지며 짙어진다 */
  @keyframes mg-morphing-first {
    0%,
    15% {
      opacity: 1;
      scale: 1;
    }
    34%,
    100% {
      opacity: 0;
      scale: 1.3;
    }
  }
  @keyframes mg-morphing-second {
    0%,
    21% {
      opacity: 0;
      scale: 0.75;
    }
    40%,
    60% {
      opacity: 1;
      scale: 1;
    }
    79%,
    100% {
      opacity: 0;
      scale: 1.3;
    }
  }
  @keyframes mg-morphing-third {
    0%,
    66% {
      opacity: 0;
      scale: 0.75;
    }
    85%,
    100% {
      opacity: 1;
      scale: 1;
    }
  }
</style>

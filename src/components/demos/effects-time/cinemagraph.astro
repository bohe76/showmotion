---
// Cinemagraph 데모 — 흐르던 영상이 사진처럼 멈추는데, 한 요소(뒤 막대 위의 바람개비)만 끊김 없이 계속 돈다. B 는 공중에 걸린 채다
// Freeze Frame 과 나란히 보면 차이가 보인다: 같은 프레임(시각 0.3)에서 멈추지만 저쪽은 아무것도 움직이지 않는다
// 시간 막대의 눈금(15%)이 멈추는 순간이고 띠가 사진으로 멈춰 있는 구간이다 — 키프레임의 % 와 같은 값이어야 한다
// 바람개비는 처음부터 끝까지 한 가지 빠르기로 돈다. 날개 넷이 같아서 4분의 1 바퀴마다 처음과 같은 모습이다 — 되풀이의 이음매가 보이지 않는다
//   끝없이 돌리지 않는다(재생 버튼을 눌러야 한 번 재생된다) — 두 바퀴를 돌고 처음 모습 그대로 멈춘다
// 바람개비 자리는 B 가 지나가지 않는 곳이다(B 는 멈출 때까지 화면 왼쪽 반에 있다)
import MgFrame from '../../mg/MgFrame.astro';
import MgClip from '../../mg/MgClip.astro';
---
<div class="mg-cinemagraph" data-demo-root aria-hidden="true">
  <MgFrame duration="4.8s" cuts={[15]} ranges={[[15, 100]]}>
    <MgClip />
    <span class="mg-cinemagraph-mill"><span class="mg-cinemagraph-vane"></span></span>
  </MgFrame>
</div>

<style>
  /* 축 자리 — 뒤 막대(화면 63~79cqw, 꼭대기 20.25cqw) 한가운데 위. 크기 없는 점이고 기둥과 날개가 여기서 뻗는다 */
  .mg-cinemagraph-mill {
    position: absolute;
    top: 11.5cqw;
    left: 71cqw;
  }
  .mg-cinemagraph-mill::before {
    content: '';
    position: absolute;
    top: 0;
    left: -0.6cqw;
    width: 1.2cqw;
    height: 9cqw;
    background: var(--muted);
  }
  .mg-cinemagraph-vane,
  .mg-cinemagraph-vane::before {
    position: absolute;
    width: 15cqw;
    height: 2.4cqw;
    background: var(--muted);
    border-radius: 2px;
  }
  .mg-cinemagraph-vane {
    top: -1.2cqw;
    left: -7.5cqw;
  }
  .mg-cinemagraph-vane::before {
    content: '';
    inset: 0;
    rotate: 90deg;
  }
  .mg-cinemagraph.is-playing :global(.mgs-b) {
    animation: mg-cinemagraph-run var(--mg-duration) linear forwards;
  }
  .mg-cinemagraph.is-playing .mg-cinemagraph-vane {
    animation: mg-cinemagraph-spin var(--mg-duration) linear forwards;
  }
  /* 원래 속도로 흐르다가 꼭대기를 막 지난 프레임에서 멈춘다(Freeze Frame 과 같은 프레임) */
  @keyframes mg-cinemagraph-run {
    15%,
    100% {
      --mg-clip-t: 0.3;
    }
  }
  @keyframes mg-cinemagraph-spin {
    to {
      rotate: 720deg;
    }
  }
</style>

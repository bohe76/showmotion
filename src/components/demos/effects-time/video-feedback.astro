---
// Video Feedback 데모 — 화면이 자기 자신을 다시 찍는다: 화면 속에 같은 화면이 작게 들어 있고, 그 속에 또 들어 있다. 마주 본 거울처럼 안으로 끝없이 이어지는 굴이 된다
// 처음에는 평범한 장면이다. 시간 막대의 띠(10~100%)가 되먹임이 걸려 있는 구간이다: 안쪽 화면이 한 겹씩 차례로 켜지고(10 · 14 · 18 · 22%), 겹마다 조금씩 돌아가 굴이 소용돌이친다(22~100%)
// 안쪽 화면은 바깥보다 한 박자씩 늦다 — B 가 뛰면(22%부터) 속의 B 들이 차례로 따라 뛴다(겹마다 길이의 4%). 다시 찍는 데 걸리는 시간이다
// 움직이는 대상의 자취만 남는 Echo 와 다르다: 화면 전체(뒤 막대 · 기둥 · 바닥까지)가 통째로 되풀이된다
// 겹은 넷이다(바깥 장면 + 안쪽 화면 셋, 그리고 맨 안쪽의 빈 틀 하나) — 사본이 늘면 무거워진다. 안쪽 화면은 앞 화면 안에 들어 있어서 같은 배율(0.6)·같은 각도가 겹겹이 쌓인다
//   안쪽 화면은 뒤 막대와 바닥 위, B 와 기둥 뒤에 선다(가운데·앞 레이어를 z-index 로 올린다) — 그래서 겹마다 B 가 보인다
//   중심(50% 25%)은 화면 위쪽이다 — 굴이 B 머리 위로 물러나서, 맨 앞의 B 가 속의 화면들을 가리지 않는다
import MgFrame from '../../mg/MgFrame.astro';
import MgClip from '../../mg/MgClip.astro';
---
<div class="mg-video-feedback" data-demo-root aria-hidden="true">
  <MgFrame duration="4.4s" ranges={[[10, 100]]}>
    <div class="mg-video-feedback-source" style="--mg-video-feedback-n: 0">
      <MgClip />
      <div class="mg-video-feedback-screen" style="--mg-video-feedback-n: 1">
        <MgClip />
        <div class="mg-video-feedback-screen" style="--mg-video-feedback-n: 2">
          <MgClip />
          <div class="mg-video-feedback-screen" style="--mg-video-feedback-n: 3">
            <MgClip />
            <div class="mg-video-feedback-screen" style="--mg-video-feedback-n: 4"></div>
          </div>
        </div>
      </div>
    </div>
  </MgFrame>
</div>

<style>
  .mg-video-feedback-source,
  .mg-video-feedback-screen {
    position: absolute;
    inset: 0;
  }
  .mg-video-feedback-screen {
    overflow: hidden;
    visibility: hidden;
    background: var(--surface);
    outline: 0.8cqw solid var(--ink);
    opacity: 0;
    transform-origin: 50% 25%;
    scale: 0.6;
  }
  .mg-video-feedback :global(.mgs-mid),
  .mg-video-feedback :global(.mgs-near) {
    z-index: 1;
  }
  .mg-video-feedback.is-playing .mg-video-feedback-screen {
    animation:
      mg-video-feedback-on calc(var(--mg-duration) * 0.03) linear calc(var(--mg-duration) * (0.06 + 0.04 * var(--mg-video-feedback-n))) forwards,
      mg-video-feedback-swirl var(--mg-duration) linear forwards;
  }
  .mg-video-feedback.is-playing :global(.mgs-b) {
    animation: mg-clip-run calc(var(--mg-duration) * 0.55) linear calc(var(--mg-duration) * (0.22 + 0.04 * var(--mg-video-feedback-n))) forwards;
  }
  @keyframes mg-video-feedback-on {
    from {
      visibility: visible;
      opacity: 0;
    }
    to {
      visibility: visible;
      opacity: 1;
    }
  }
  @keyframes mg-video-feedback-swirl {
    0%,
    22% {
      rotate: 0deg;
      animation-timing-function: cubic-bezier(0.4, 0, 0.3, 1);
    }
    100% {
      rotate: 9deg;
    }
  }
</style>

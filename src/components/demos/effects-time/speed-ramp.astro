---
// Speed Ramp 데모 — 한 샷 안에서 속도가 바뀐다. 같은 영상(B 가 뛰어올라 튀며 간다 — MgClip)이 구간마다 다른 빠르기로 흐른다
// Slow Motion · Fast Motion 과 같은 영상이라 나란히 보면 차이가 보인다: 저 둘은 한 가지 속도, 여기는 한 샷 안에서 속도가 바뀐다
// 속도는 계단처럼 바뀌지 않는다: 처음부터 끝까지 가속 곡선 하나로 영상의 시각(--mg-clip-t)을 움직인다
// 시간 막대의 띠가 빠른 구간이다 — 영상의 대부분(약 80%)이 이 구간에 흐른다. 곡선을 바꾸면 띠도 맞춘다
// 변형: slow-fast-slow(기본 — 느리게 → 확 빠르게 → 다시 느리게, 띠 35~65%) · slow-to-fast(띠 65~100%) · fast-to-slow(띠 0~35%)
import MgFrame from '../../mg/MgFrame.astro';
import MgClip from '../../mg/MgClip.astro';

const ranges: Record<string, [number, number][]> = {
  'slow-fast-slow': [[35, 65]],
  'slow-to-fast': [[65, 100]],
  'fast-to-slow': [[0, 35]],
};
---
<div class="mg-speed-ramp" data-demo-root aria-hidden="true">
  <MgFrame duration="4s" ranges={ranges}>
    <MgClip />
  </MgFrame>
</div>

<style>
  .mg-speed-ramp {
    --mg-speed-ramp-curve: cubic-bezier(0.85, 0, 0.15, 1);
  }
  .mg-speed-ramp[data-variant='slow-to-fast'] {
    --mg-speed-ramp-curve: cubic-bezier(0.5, 0, 0.75, 0);
  }
  .mg-speed-ramp[data-variant='fast-to-slow'] {
    --mg-speed-ramp-curve: cubic-bezier(0.25, 1, 0.5, 1);
  }
  .mg-speed-ramp.is-playing :global(.mgs-b) {
    animation: mg-clip-run var(--mg-duration) var(--mg-speed-ramp-curve) forwards;
  }
</style>

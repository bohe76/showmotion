---
// Bullet Time 데모 — 원래 속도로 흐르던 영상의 시간이 거의 멈추고, 시점이 공중에 걸린 B 의 둘레를 돈다
// 시간 막대의 눈금(20%)이 시간이 멈추는 순간이고 띠가 그 뒤 구간이다 — 키프레임의 % · 지연과 같은 값이어야 한다
// Freeze Frame 과 나란히 보면 차이가 보인다: 같은 순간(시각 0.3)에 멈추는데, 저쪽은 아무것도 안 움직이고 여기는 카메라가 계속 움직인다
//   — B 는 그 자리에 있고 뒤 레이어는 오른쪽, 앞 레이어는 왼쪽으로 흐른다(Orbit 데모와 같은 방식: 이동량 = 18.5cqw × (레이어까지의 거리 − 1) ÷ 거리)
// 변형: frozen(기본 — B 가 완전히 멈춘다) · slowed(B 가 아주 느리게 계속 떨어진다 — 원래 속도의 약 1/10)
// 깊이: 레이어 사이가 멀수록 뒤·앞이 더 많이 흐른다
// 영상의 시각(--mg-clip-t)은 단계(--mg-bullet-time-s)에서 계산한다: 0 → 1 이 멈추기 전(시각 0 → 0.3), 1 → 2 가 멈춘 뒤(0.3 → 변형의 끝 시각)
//   변형의 끝 시각이 var 라서 키프레임에 시각을 바로 두지 않는다 — var() 가 든 값은 Firefox 가 중간값 없이 건너뛴다
import MgFrame from '../../mg/MgFrame.astro';
import MgClip from '../../mg/MgClip.astro';
---
<div class="mg-bullet-time" data-demo-root aria-hidden="true">
  <MgFrame duration="3.6s" cuts={[20]} ranges={[[20, 100]]}>
    <MgClip />
  </MgFrame>
</div>

<style>
  @property --mg-bullet-time-s {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  .mg-bullet-time {
    --mg-bullet-time-end: 0.3;
  }
  .mg-bullet-time[data-variant='slowed'] {
    --mg-bullet-time-end: 0.4;
  }
  /* 18.5cqw: 보통 깊이에서 왼쪽 앞 기둥이 화면 밖으로 다 나간다(가장자리에 실 같은 조각이 남지 않는다) */
  .mg-bullet-time :global(.mgs-far) {
    --mg-bullet-time-shift: calc(18.5cqw * (var(--mg-z-far) - 1) / var(--mg-z-far));
  }
  .mg-bullet-time :global(.mgs-near) {
    --mg-bullet-time-shift: calc(18.5cqw * (var(--mg-z-near) - 1) / var(--mg-z-near));
  }
  .mg-bullet-time :global(.mgs-b) {
    --mg-clip-t: calc(0.3 * min(var(--mg-bullet-time-s), 1) + (var(--mg-bullet-time-end) - 0.3) * max(var(--mg-bullet-time-s) - 1, 0));
  }
  .mg-bullet-time.is-playing :global(.mgs-b) {
    animation: mg-bullet-time-run var(--mg-duration) linear forwards;
  }
  .mg-bullet-time.is-playing :global(.mgs-far),
  .mg-bullet-time.is-playing :global(.mgs-near) {
    animation: mg-bullet-time-orbit calc(var(--mg-duration) * 0.8) ease-in-out calc(var(--mg-duration) * 0.2) forwards;
  }
  @keyframes mg-bullet-time-run {
    20% {
      --mg-bullet-time-s: 1;
    }
    100% {
      --mg-bullet-time-s: 2;
    }
  }
  @keyframes mg-bullet-time-orbit {
    to {
      translate: var(--mg-bullet-time-shift) 0;
    }
  }
</style>

---
// Push 데모 — 마우스를 올리면(.is-active) 블록이 눌린 것처럼 한 번 작아졌다가 원래 크기로 돌아온다 (올릴 때마다 1회)
---
<div class="push" data-demo-root aria-hidden="true">
  <div class="pu-box">A</div>
</div>

<style>
  .push {
    display: grid;
    place-items: center;
  }
  .pu-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .push.is-active .pu-box {
    animation: push-press 300ms linear;
  }
  @keyframes push-press {
    50% {
      transform: scale(0.8);
    }
  }
</style>

---
// Shrink 데모 — 마우스를 올리면(.is-active) 블록이 살짝 작아지고, 떼면 돌아온다
---
<div class="shrink" data-demo-root aria-hidden="true">
  <div class="sh-box">A</div>
</div>

<style>
  .shrink {
    display: grid;
    place-items: center;
  }
  .sh-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    transition: transform 200ms ease-out;
  }
  .shrink.is-active .sh-box {
    transform: scale(0.9);
  }
</style>

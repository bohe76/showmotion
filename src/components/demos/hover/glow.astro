---
// Glow 데모 — 마우스를 올리면(.is-active) 블록 둘레에 강조색 빛무리가 은은하게 번진다
---
<div class="glow" data-demo-root aria-hidden="true">
  <div class="gl-box">A</div>
</div>

<style>
  .glow {
    display: grid;
    place-items: center;
  }
  .gl-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    box-shadow: 0 0 0 0 transparent;
    transition: box-shadow 300ms ease-out;
  }
  .glow.is-active .gl-box {
    box-shadow: 0 0 28px 6px color-mix(in srgb, var(--accent) 55%, transparent);
  }
</style>

---
// Grow 데모 — 마우스를 올리면(.is-active) 블록이 살짝 커지고, 떼면 돌아온다
---
<div class="grow" data-demo-root aria-hidden="true">
  <div class="gr-box">A</div>
</div>

<style>
  .grow {
    display: grid;
    place-items: center;
  }
  .gr-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    transition: transform 200ms ease-out;
  }
  .grow.is-active .gr-box {
    transform: scale(1.12);
  }
</style>

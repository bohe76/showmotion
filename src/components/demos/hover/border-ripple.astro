---
// Border Ripple 데모 — 마우스를 올리면(.is-active) 테두리 고리 두 개가 차례로 바깥으로 퍼지며 사라진다 (올릴 때마다 1회)
---
<div class="border-ripple" data-demo-root aria-hidden="true">
  <div class="br-box">
    <span class="br-ring"></span>
    <span class="br-ring"></span>
    A
  </div>
</div>

<style>
  .border-ripple {
    display: grid;
    place-items: center;
  }
  .br-box {
    position: relative;
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .br-ring {
    position: absolute;
    inset: 0;
    border: 4px solid var(--accent);
    border-radius: 10px;
    opacity: 0;
  }
  .border-ripple.is-active .br-ring {
    animation: border-ripple-out 900ms ease-out;
  }
  .border-ripple.is-active .br-ring + .br-ring {
    animation-delay: 200ms;
  }
  @keyframes border-ripple-out {
    from {
      inset: 0;
      opacity: 1;
    }
    to {
      inset: -18px;
      opacity: 0;
    }
  }
</style>

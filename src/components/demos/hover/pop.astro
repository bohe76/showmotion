---
// Pop 데모 — 마우스를 올리면(.is-active) 블록이 한 번 빠르게 부풀었다가 원래 크기로 돌아온다 (올릴 때마다 1회)
---
<div class="pop" data-demo-root aria-hidden="true">
  <div class="pp-box">A</div>
</div>

<style>
  .pop {
    display: grid;
    place-items: center;
  }
  .pp-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .pop.is-active .pp-box {
    animation: pop-swell 300ms linear;
  }
  @keyframes pop-swell {
    50% {
      transform: scale(1.2);
    }
  }
</style>

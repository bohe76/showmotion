---
// Outline Expand 데모 — 마우스를 올리면(.is-active) 블록 가장자리에 붙어 있던 외곽선이 바깥으로 벌어져 머문다
---
<div class="outline-expand" data-demo-root aria-hidden="true">
  <div class="oe-box">
    <span class="oe-outline"></span>
    A
  </div>
</div>

<style>
  .outline-expand {
    display: grid;
    place-items: center;
  }
  .oe-box {
    position: relative;
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  /* 평소에는 블록과 같은 색으로 가장자리에 겹쳐 보이지 않는다 */
  .oe-outline {
    position: absolute;
    inset: 0;
    border: 4px solid var(--accent);
    border-radius: 8px;
    transition: inset 300ms ease-out;
  }
  .outline-expand.is-active .oe-outline {
    inset: -12px;
  }
</style>

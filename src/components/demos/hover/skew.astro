---
// Skew 데모 — 마우스를 올리면(.is-active) 블록이 옆으로 비스듬히 기울어지고, 떼면 곧게 돌아온다
---
<div class="skew" data-demo-root aria-hidden="true">
  <div class="sk-box">A</div>
</div>

<style>
  .skew {
    display: grid;
    place-items: center;
  }
  .sk-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    transition: transform 300ms ease-out;
  }
  .skew.is-active .sk-box {
    transform: skewX(-12deg);
  }
</style>

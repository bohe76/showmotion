---
// Rotate 데모 — 마우스를 올리면(.is-active) 블록이 시계 방향으로 살짝 기울고, 떼면 돌아온다
---
<div class="rotate" data-demo-root aria-hidden="true">
  <div class="ro-box">A</div>
</div>

<style>
  .rotate {
    display: grid;
    place-items: center;
  }
  .ro-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    transition: rotate 300ms ease-out;
  }
  .rotate.is-active .ro-box {
    rotate: 6deg;
  }
</style>

---
// Bounce Scale 데모 — 마우스를 올리면(.is-active) 블록이 목표보다 더 커졌다가 튕기듯 자리를 잡고, 뗄 때도 튕기며 돌아온다
---
<div class="bounce-scale" data-demo-root aria-hidden="true">
  <div class="bsc-box">A</div>
</div>

<style>
  .bounce-scale {
    display: grid;
    place-items: center;
  }
  /* 양쪽으로 넘치는 곡선 — 커질 때와 돌아올 때 모두 튕김이 보여 Grow 와 구별된다 */
  .bsc-box {
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    transition: transform 500ms cubic-bezier(0.47, 2.02, 0.31, -0.36);
  }
  .bounce-scale.is-active .bsc-box {
    transform: scale(1.15);
  }
</style>

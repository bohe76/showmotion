---
// Float 데모 — 마우스를 올리면(.is-active) 블록이 위로 떠올라 머물고, 떼면 내려온다
// 점선 칸은 원래 자리 — 얼마나 떠 있는지 보이게 한다
---
<div class="float" data-demo-root aria-hidden="true">
  <div class="fl-ghost"></div>
  <div class="fl-box">A</div>
</div>

<style>
  .float {
    display: grid;
    place-items: center;
  }
  .fl-ghost,
  .fl-box {
    grid-area: 1 / 1;
    width: 40%;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
  }
  .fl-ghost {
    border: 2px dashed var(--demo-muted);
  }
  .fl-box {
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    transition: transform 300ms ease-out;
  }
  .float.is-active .fl-box {
    transform: translateY(-16%);
  }
</style>

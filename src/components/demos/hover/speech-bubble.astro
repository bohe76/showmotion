---
// Speech Bubble 데모 — 마우스를 올리면(.is-active) 블록 뒤에 숨어 있던 삼각 꼬리가 아래로 빠져나와 말풍선 모양이 된다
---
<div class="speech-bubble" data-demo-root aria-hidden="true">
  <div class="sb-wrap">
    <span class="sb-tail"></span>
    <div class="sb-box">A</div>
  </div>
</div>

<style>
  .speech-bubble {
    display: grid;
    place-items: center;
  }
  .sb-wrap {
    position: relative;
    width: 40%;
    aspect-ratio: 16 / 10;
  }
  /* 꼬리는 블록보다 먼저 그려져 평소에는 블록 뒤에 가려진다 */
  .sb-tail {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 18%;
    aspect-ratio: 3 / 2;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    translate: -50% 0;
    transition: translate 300ms ease-out;
  }
  .sb-box {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .speech-bubble.is-active .sb-tail {
    translate: -50% 100%;
  }
</style>

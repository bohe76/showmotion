---
// Trim 데모 — 마우스를 올리면(.is-active) 블록 가장자리 안쪽에 가는 선이 서서히 나타난다
---
<div class="trim" data-demo-root aria-hidden="true">
  <div class="tr-box">
    <span class="tr-line"></span>
    A
  </div>
</div>

<style>
  .trim {
    display: grid;
    place-items: center;
  }
  .tr-box {
    position: relative;
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .tr-line {
    position: absolute;
    inset: 6px;
    border: 3px solid var(--on-accent);
    border-radius: 3px;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }
  .trim.is-active .tr-line {
    opacity: 1;
  }
</style>

---
// Shine Sweep 데모 — 마우스를 올려 둔 동안(.is-active) 비스듬한 빛 띠가 왼쪽에서 오른쪽으로 쓸고 지나가기를 반복한다
---
<div class="shine-sweep" data-demo-root aria-hidden="true">
  <div class="ss-box">
    A
    <span class="ss-band"></span>
  </div>
</div>

<style>
  .shine-sweep {
    display: grid;
    place-items: center;
  }
  .ss-box {
    position: relative;
    display: grid;
    place-items: center;
    width: 40%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  /* 빛은 두 테마 모두 흰색 — 다크의 --on-accent 는 어두운색이라 광택으로 보이지 않는다 */
  .ss-band {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 28%;
    background: rgb(255 255 255 / 0.4);
    transform: translateX(-150%) skewX(-20deg);
  }
  .shine-sweep.is-active .ss-band {
    animation: shine-sweep-pass 1.8s ease-in-out infinite;
  }
  @keyframes shine-sweep-pass {
    0% {
      transform: translateX(-150%) skewX(-20deg);
    }
    55%,
    100% {
      transform: translateX(420%) skewX(-20deg);
    }
  }
</style>

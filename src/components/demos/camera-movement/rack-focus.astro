---
// Rack Focus 데모 — 카메라도 구도도 그대로이고 초점만 옮겨 간다. 아무것도 움직이지 않는다: 또렷하던 레이어가 흐려지고 흐리던 레이어가 또렷해진다
// 앞 기둥 A 에 맞아 있던 초점이 가운데 B 로 넘어간다. 뒤 줄 C 는 어느 쪽에서도 초점 밖이라 계속 흐리고, 초점이 가까워진 만큼만 덜 흐려진다
// Zoom · Dolly 와 나란히 보면 차이가 보인다: 그 둘은 크기가 달라진다. 여기서는 크기도 자리도 그대로이고 또렷한 곳만 바뀐다
// 초점의 자리 p(0 = 앞 A, 1 = 가운데 B)에서 레이어가 흐림을 계산한다
// 변형: near-to-far(기본 — A 에서 B 로) · far-to-near(B 에서 A 로). --mg-rack-focus-from · -to 가 초점의 처음과 끝 자리다
//   등록해 움직이는 것은 초점을 옮긴 정도(--mg-rack-focus-k, 0 → 1)이고, p 는 레이어가 from · to · k 로 계산한다 — 키프레임에 var() 가 든 값을 두면 Firefox 가 중간값 없이 건너뛴다
// 시간 막대의 띠가 초점을 옮기는 구간이다(30~70%). 키프레임의 %와 같은 값이어야 한다
// 흐린 가장자리가 화면 안으로 들어오지 않게 바닥과 기둥을 화면 밖까지 잇는다(bleed)
import MgFrame from '../../mg/MgFrame.astro';
import MgScene from '../../mg/MgScene.astro';
---
<div class="mg-rack-focus" data-demo-root aria-hidden="true">
  <MgFrame duration="3s" ranges={[[30, 70]]}>
    <MgScene bleed />
  </MgFrame>
</div>

<style>
  @property --mg-rack-focus-k {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  .mg-rack-focus {
    --mg-rack-focus-from: 0;
    --mg-rack-focus-to: 1;
  }
  .mg-rack-focus[data-variant='far-to-near'] {
    --mg-rack-focus-from: 1;
    --mg-rack-focus-to: 0;
  }
  .mg-rack-focus :global(.mgs-layer),
  .mg-rack-focus :global(.mgs-ground) {
    --mg-rack-focus-p: calc(var(--mg-rack-focus-from) + (var(--mg-rack-focus-to) - var(--mg-rack-focus-from)) * var(--mg-rack-focus-k));
  }
  .mg-rack-focus :global(.mgs-near) {
    filter: blur(calc(1.5cqw * var(--mg-rack-focus-p)));
  }
  .mg-rack-focus :global(.mgs-mid) {
    filter: blur(calc(1cqw * (1 - var(--mg-rack-focus-p))));
  }
  /* 바닥선은 뒤 레이어의 밑변이라 뒤 레이어와 같이 흐려진다 */
  .mg-rack-focus :global(.mgs-far),
  .mg-rack-focus :global(.mgs-ground) {
    filter: blur(calc(0.6cqw + 1cqw * (1 - var(--mg-rack-focus-p))));
  }
  /* 변수는 장면(.mgs)에서 움직인다 — 길이(--mg-duration)가 화면 틀 안에서만 잡힌다 */
  .mg-rack-focus.is-playing :global(.mgs) {
    animation: mg-rack-focus-pull var(--mg-duration) linear forwards;
  }
  @keyframes mg-rack-focus-pull {
    0%,
    30% {
      --mg-rack-focus-k: 0;
      animation-timing-function: ease-in-out;
    }
    70%,
    100% {
      --mg-rack-focus-k: 1;
    }
  }
</style>

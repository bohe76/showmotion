---
// 2.5D Camera 데모 — 납작한 판 세 장(뒤 C · 가운데 B · 앞 A)을 3D 공간에 깊이를 달리해 세워 두고 카메라로 본다
// 첫 장면은 기본 장면이다: 판마다 멀리 있는 만큼 커서 정면에서는 한 장의 그림으로 보인다. 카메라가 옆으로 돌아 나가며 물러나면 판이 서로 어긋나고, 판의 가장자리가 드러나 납작한 판임이 보인다
// Truck 과 나란히 보면 차이가 보인다: Truck 은 한 방향으로 미는 움직임이고 판의 가장자리는 끝내 보이지 않는다. 여기서는 카메라가 3D 공간을 다닌다(돌고 · 오르고 · 물러난다)
// 판은 실제로 CSS 3D 로 놓는다: 원근(perspective)의 눈은 가운데 판에서 화면 폭만큼 떨어져 있고, 거리 z 인 판은 (1 − z) × 화면 폭만큼 뒤에 z 배 크기로 선다 — 정면에서는 배율이 서로 지워진다
//   회전의 축은 가운데 판의 지평선 한가운데(B)를 지난다 — transform-origin 의 z 를 판의 깊이만큼 되돌려 놓아서다
// 판의 테두리는 재생하는 동안에만 보인다(재생 전 카드는 기본 장면 그대로)
// 깊이: 판 사이가 멀수록 판이 더 많이 어긋난다
import MgFrame from '../../mg/MgFrame.astro';
import MgScene from '../../mg/MgScene.astro';
---
<div class="mg-2-5d-camera" data-demo-root aria-hidden="true">
  <MgFrame duration="4s">
    <MgScene />
  </MgFrame>
</div>

<style>
  .mg-2-5d-camera :global(.mgs) {
    perspective: 100cqw;
    perspective-origin: 50% 68%;
  }
  .mg-2-5d-camera :global(.mgs-far),
  .mg-2-5d-camera :global(.mgs-ground) {
    --mg-2-5d-camera-z: var(--mg-z-far);
  }
  .mg-2-5d-camera :global(.mgs-mid) {
    --mg-2-5d-camera-z: 1;
  }
  .mg-2-5d-camera :global(.mgs-near) {
    --mg-2-5d-camera-z: var(--mg-z-near);
  }
  .mg-2-5d-camera :global(.mgs-layer),
  .mg-2-5d-camera :global(.mgs-ground) {
    --mg-2-5d-camera-depth: calc((1 - var(--mg-2-5d-camera-z)) * 100cqw);
    transform-origin: 50% 68% calc(var(--mg-2-5d-camera-depth) * -1);
    translate: 0 0 var(--mg-2-5d-camera-depth);
    scale: var(--mg-2-5d-camera-z);
  }
  /* 바닥은 뒤 판의 아랫부분이다 — 화면 아래쪽 24% 띠라서 지평선이 윗변에서 4.5cqw 위에 있다 */
  .mg-2-5d-camera :global(.mgs-ground) {
    transform-origin: 50% -4.5cqw calc(var(--mg-2-5d-camera-depth) * -1);
  }
  /* 판 = 레이어 가운데 화면만 한 크기(레이어는 화면의 2배 폭이다). 그 밖은 잘라 낸다 */
  .mg-2-5d-camera :global(.mgs-layer) {
    clip-path: inset(0 25%);
  }
  .mg-2-5d-camera :global(.mgs-layer)::after {
    content: '';
    position: absolute;
    inset: 0 25%;
    border: 1px solid var(--muted);
    opacity: 0;
  }
  .mg-2-5d-camera.is-playing :global(.mgs-layer),
  .mg-2-5d-camera.is-playing :global(.mgs-ground) {
    animation: mg-2-5d-camera-move var(--mg-duration) ease-in-out forwards;
  }
  .mg-2-5d-camera.is-playing :global(.mgs-layer)::after {
    animation: mg-2-5d-camera-edge calc(var(--mg-duration) * 0.25) ease-out forwards;
  }
  .mg-2-5d-camera.is-playing :global(.mgs-ground) {
    animation:
      mg-2-5d-camera-move var(--mg-duration) ease-in-out forwards,
      mg-2-5d-camera-ground-edge calc(var(--mg-duration) * 0.25) ease-out forwards;
  }
  @keyframes mg-2-5d-camera-move {
    to {
      translate: -2cqw 2cqw calc(var(--mg-2-5d-camera-depth) - 14cqw);
      rotate: -0.35 1 0 13deg;
    }
  }
  @keyframes mg-2-5d-camera-edge {
    to {
      opacity: 1;
    }
  }
  /* 바닥이 뒤 판의 테두리 아랫부분을 덮는다 — 바닥의 양옆과 밑에 같은 선을 안쪽 그림자로 그린다(크기가 달라지지 않는다) */
  @keyframes mg-2-5d-camera-ground-edge {
    from {
      box-shadow:
        inset 1px 0 0 transparent,
        inset -1px 0 0 transparent,
        inset 0 -1px 0 transparent;
    }
    to {
      box-shadow:
        inset 1px 0 0 var(--muted),
        inset -1px 0 0 var(--muted),
        inset 0 -1px 0 var(--muted);
    }
  }
</style>

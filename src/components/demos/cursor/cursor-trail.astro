---
// Cursor Trail 데모 — 포인터가 움직인 자리마다 점이 하나씩 놓이고 작아지며 사라져, 지나간 길이 꼬리처럼 남는다
// 포인터가 없을 때(.is-active 없음)는 멈춘 꼬리 모양을 보여 준다. 점을 놓는 일만 스크립트가 한다 (CSS로는 지난 위치를 기억할 수 없다)
const dots = [
  [24, 36],
  [28, 30],
  [33, 27],
  [38, 28],
  [43, 33],
  [47, 40],
  [51, 46],
  [56, 50],
  [61, 51],
  [66, 48],
];
---
<div class="cursor-trail" data-demo-root aria-hidden="true">
  {
    dots.map(([x, y], i) => (
      <span class="ct-dot" style={`--sx: ${x}%; --sy: ${y}%; --o: ${(i + 1) / dots.length}`} />
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.cursor-trail[data-demo-root]').forEach((root) => {
    const dots = root.querySelectorAll<HTMLElement>('.ct-dot');
    let next = 0;
    let lastX = -100;
    let lastY = -100;
    root.addEventListener('pointermove', (event) => {
      if (root.classList.contains('is-offscreen')) return;
      const rect = root.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      // 조금 움직였을 때만 점을 놓아 점 사이 간격을 고르게 한다
      if (Math.hypot(x - lastX, y - lastY) < 14) return;
      lastX = x;
      lastY = y;
      const dot = dots[next];
      next = (next + 1) % dots.length;
      dot.style.setProperty('--tx', `${x}px`);
      dot.style.setProperty('--ty', `${y}px`);
      // 같은 점의 애니메이션을 처음부터 다시 걸려면 한 번 스타일을 계산시켜야 한다
      dot.classList.remove('is-fading');
      void dot.offsetWidth;
      dot.classList.add('is-fading');
    });
    root.addEventListener('pointerleave', () => {
      dots.forEach((dot) => dot.classList.remove('is-fading'));
      lastX = -100;
      lastY = -100;
    });
  });
</script>

<style>
  .cursor-trail {
    position: relative;
    overflow: hidden;
  }
  .ct-dot {
    position: absolute;
    top: var(--sy);
    left: var(--sx);
    width: clamp(10px, 4%, 18px);
    aspect-ratio: 1;
    background: var(--accent);
    border-radius: 50%;
    opacity: var(--o);
    /* 가운데 맞춤은 개별 translate 로 — transform 에 두면 scale 이 맞춤 이동까지 줄여 작은 점이 궤적에서 어긋난다 */
    translate: -50% -50%;
    scale: calc(0.4 + var(--o) * 0.6);
    pointer-events: none;
    transition: opacity 300ms ease-out;
  }
  .cursor-trail.is-active .ct-dot {
    top: var(--ty, var(--sy));
    left: var(--tx, var(--sx));
    opacity: 0;
  }
  .cursor-trail.is-active .ct-dot.is-fading {
    animation: cursor-trail-fade 600ms ease-out;
  }
  @keyframes cursor-trail-fade {
    from {
      opacity: 1;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 0.3;
    }
  }
</style>

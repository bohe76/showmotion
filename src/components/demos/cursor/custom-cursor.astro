---
// Custom Cursor 데모 — 기본 화살표 대신 점(바로 따라옴)과 고리(조금 늦게 따라옴)가 포인터(--px, --py)를 대신하고, 누를 수 있는 블록(B) 위에서는 고리가 커진다
// 포인터가 없으면 가운데에 선다
---
<div class="custom-cursor" data-demo-root aria-hidden="true">
  <div class="cc-text">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="cc-target">B</div>
  <div class="cc-ring"></div>
  <div class="cc-dot"></div>
</div>

<style>
  .custom-cursor {
    /* 포인터가 B 블록(가로 58~84%, 세로 36~64%) 안이면 1, 밖이면 0 */
    --over: calc(
      clamp(0, (var(--mx, 0.5) - 0.58) * 1000, 1) * clamp(0, (0.84 - var(--mx, 0.5)) * 1000, 1) *
        clamp(0, (var(--my, 0.5) - 0.36) * 1000, 1) * clamp(0, (0.64 - var(--my, 0.5)) * 1000, 1)
    );
    position: relative;
    overflow: hidden;
    cursor: none;
  }
  .cc-text {
    position: absolute;
    top: 38%;
    left: 14%;
    display: grid;
    gap: 10px;
    width: 34%;
  }
  .cc-text span {
    height: 10px;
    background: var(--demo-muted);
    border-radius: 2px;
  }
  .cc-text span:last-child {
    width: 60%;
  }
  .cc-target {
    position: absolute;
    inset: 36% 16% 36% 58%;
    display: grid;
    place-items: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .cc-ring,
  .cc-dot {
    position: absolute;
    top: var(--py, 50%);
    left: var(--px, 50%);
    border-radius: 50%;
    /* 가운데 맞춤은 개별 translate 로 — transform 에 두면 고리의 scale 이 맞춤 이동까지 키워 중심이 어긋난다 */
    translate: -50% -50%;
    pointer-events: none;
  }
  .cc-dot {
    width: 8px;
    height: 8px;
    background: var(--ink);
    opacity: calc(1 - var(--over));
    transition: opacity 150ms ease-out;
  }
  .cc-ring {
    width: 36px;
    height: 36px;
    border: 2px solid var(--ink);
    scale: calc(1 + var(--over) * 0.8);
    transition:
      top 200ms ease-out,
      left 200ms ease-out,
      scale 250ms ease-out;
  }
</style>

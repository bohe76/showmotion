---
// Blend-Mode Cursor 데모 — 포인터 자리(--px, --py)의 둥근 커서가 difference 합성으로 밑의 글자·블록 색을 뒤집는다
// 포인터가 없으면 가운데에 선다
---
<div class="blend-mode-cursor" data-demo-root aria-hidden="true">
  <div class="bm-content">
    <span class="bm-letter">A</span>
    <span class="bm-block">B</span>
  </div>
  <div class="bm-dot"></div>
</div>

<style>
  .blend-mode-cursor {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    /* 합성이 스테이지 밖 페이지와 섞이지 않게 가둔다 */
    isolation: isolate;
    cursor: none;
    background: var(--stage);
  }
  .bm-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 8%;
    width: 64%;
  }
  .bm-letter,
  .bm-block {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 3rem;
    font-weight: 700;
  }
  .bm-letter {
    color: var(--ink);
  }
  .bm-block {
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .bm-dot {
    position: absolute;
    top: var(--py, 50%);
    left: var(--px, 50%);
    width: clamp(56px, 22%, 96px);
    aspect-ratio: 1;
    /* 밝은 색과 difference 로 합성해야 뒤집힌다 — 다크에서는 밝은 토큰이 --ink 다 */
    background: var(--surface);
    border-radius: 50%;
    mix-blend-mode: difference;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  @media (prefers-color-scheme: dark) {
    .bm-dot {
      background: var(--ink);
    }
  }
</style>

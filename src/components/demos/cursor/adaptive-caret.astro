---
// Adaptive Caret 데모 — 포인터가 가로(--mx)로 지나가는 글자 칸마다 캐럿이 그 글자 앞으로 옮겨 가며 글자 크기에 맞게 길어지고 짧아진다
// 포인터가 없으면 가운데(세 번째 글자) 앞에 선다
const letters = [
  { letter: 'a', size: 1.2 },
  { letter: 'B', size: 2.6 },
  { letter: 'c', size: 1.6 },
  { letter: 'D', size: 3.2 },
];
---
<div class="adaptive-caret" data-demo-root aria-hidden="true">
  <div class="ac-line">
    {letters.map(({ letter, size }) => <span style={`font-size: ${size}em`}>{letter}</span>)}
    <span class="ac-caret"></span>
  </div>
</div>

<style>
  .adaptive-caret {
    display: grid;
    place-items: center;
    cursor: text;
  }
  .ac-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    /* 칸 폭(20%)과 가장자리(10%)가 아래 캐럿 계산의 경계값과 맞아야 한다 */
    width: 80%;
    height: 50%;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
  }
  .ac-line > span:not(.ac-caret) {
    padding-left: 12%;
  }
  .ac-caret {
    /* 포인터가 들어간 칸 번호(0~3) — 경계를 넘을 때마다 1씩 는다 */
    --cell: calc(
      clamp(0, (var(--mx, 0.5) - 0.3) * 1000, 1) + clamp(0, (var(--mx, 0.5) - 0.5) * 1000, 1) +
        clamp(0, (var(--mx, 0.5) - 0.7) * 1000, 1)
    );
    /* 칸마다 글자 크기(em)에 맞춘 길이 — 위 letters 의 size 와 같은 값 */
    --size: calc(
      1.2 + clamp(0, (var(--mx, 0.5) - 0.3) * 1000, 1) * 1.4 - clamp(0, (var(--mx, 0.5) - 0.5) * 1000, 1) * 1 +
        clamp(0, (var(--mx, 0.5) - 0.7) * 1000, 1) * 1.6
    );
    position: absolute;
    top: 50%;
    left: calc(var(--cell) * 25% + 2%);
    width: 3px;
    height: calc(var(--size) * 0.8em);
    background: var(--accent);
    border-radius: 2px;
    transform: translateY(-50%);
    transition:
      left 180ms ease-out,
      height 180ms ease-out;
  }
</style>

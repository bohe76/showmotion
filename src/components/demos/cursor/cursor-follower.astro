---
// Cursor Follower 데모 — 둥근 표식이 포인터 자리(--px, --py)를 한 박자 늦게 부드럽게 따라온다
// 포인터가 없으면 가운데에 멈춰 있다
---
<div class="cursor-follower" data-demo-root aria-hidden="true">
  <div class="cf-dot">A</div>
</div>

<style>
  .cursor-follower {
    position: relative;
    overflow: hidden;
  }
  .cf-dot {
    position: absolute;
    top: var(--py, 50%);
    left: var(--px, 50%);
    display: grid;
    place-items: center;
    width: clamp(40px, 14%, 64px);
    aspect-ratio: 1;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    /* 포인터가 움직일 때마다 전환이 새로 시작되어 뒤처져 따라오는 느낌이 난다 */
    transition:
      top 450ms cubic-bezier(0.22, 1, 0.36, 1),
      left 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>

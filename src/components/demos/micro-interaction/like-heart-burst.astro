---
// Like / Heart Burst 데모 — 누를 때마다(.is-on 토글) 하트가 채워지거나 비워진다
// 켜질 때만(.is-on.is-playing) 하트가 톡 튀고 둘레로 고리와 작은 점들이 퍼진다
import Heart from '@lucide/astro/icons/heart';

const angles = [0, 45, 90, 135, 180, 225, 270, 315];
---
<div class="like-heart-burst" data-demo-root aria-hidden="true">
  <div class="lhb-wrap">
    <span class="lhb-ring"></span>
    {angles.map((a, i) => (
      <span class:list={['lhb-dot', i % 2 === 1 && 'lhb-dot--alt']} style={`--a: ${a}deg`}></span>
    ))}
    <Heart class="lhb-heart" stroke-width={1.8} aria-hidden="true" />
  </div>
</div>

<style>
  .like-heart-burst {
    display: grid;
    place-items: center;
    container-type: size;
    cursor: pointer;
  }
  .lhb-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: 26cqmin;
    aspect-ratio: 1;
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다. 선은 currentColor(color), 채움은 fill 이 경로로 물려진다 */
  .lhb-wrap :global(.lhb-heart) {
    width: 100%;
    height: 100%;
    color: var(--ink);
    fill: transparent;
    transition:
      fill 160ms ease-out,
      color 160ms ease-out;
  }
  .like-heart-burst.is-on :global(.lhb-heart) {
    color: var(--accent);
    fill: var(--accent);
  }
  .lhb-ring {
    position: absolute;
    inset: -10%;
    border: 3px solid var(--accent);
    border-radius: 50%;
    opacity: 0;
  }
  /* 점은 하트 가운데에 모여 있다가 각자의 각도(--a)로 바깥을 향해 퍼진다 */
  .lhb-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    background: var(--accent);
    border-radius: 50%;
    opacity: 0;
  }
  .lhb-dot--alt {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--highlight);
  }
  .like-heart-burst.is-on.is-playing :global(.lhb-heart) {
    animation: like-heart-burst-pop 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .like-heart-burst.is-on.is-playing .lhb-ring {
    animation: like-heart-burst-ring 480ms ease-out both;
  }
  .like-heart-burst.is-on.is-playing .lhb-dot {
    animation: like-heart-burst-dots 600ms ease-out 80ms both;
  }
  @keyframes like-heart-burst-pop {
    0% {
      transform: scale(0.6);
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes like-heart-burst-ring {
    0% {
      opacity: 1;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.15);
    }
  }
  @keyframes like-heart-burst-dots {
    0% {
      opacity: 1;
      transform: rotate(var(--a)) translateY(-8cqmin) scale(1);
    }
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: rotate(var(--a)) translateY(-22cqmin) scale(0.3);
    }
  }
</style>

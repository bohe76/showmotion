---
// Add to Cart Fly 데모 — 누를 때마다(.is-playing) 상품 이미지 복사본이 작아지며 호를 그려 오른쪽 위 장바구니로 날아가고, 장바구니가 톡 튄다
import ShoppingCart from '@lucide/astro/icons/shopping-cart';
---
<div class="add-to-cart-fly" data-demo-root aria-hidden="true">
  <div class="acf-card">
    <div class="acf-media">A</div>
    <div class="acf-line"></div>
    <div class="acf-line acf-line--short"></div>
  </div>
  <div class="acf-cart">
    <ShoppingCart class="acf-cart-icon" aria-hidden="true" />
    <span class="acf-badge">1</span>
  </div>
  <div class="acf-fly-x">
    <div class="acf-fly-y">
      <div class="acf-dot"></div>
    </div>
  </div>
</div>

<style>
  .add-to-cart-fly {
    position: relative;
    overflow: hidden;
    container-type: size;
    cursor: pointer;
  }
  .acf-card {
    position: absolute;
    top: 20%;
    left: 16%;
    width: 28%;
    padding: 8px;
    display: grid;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .acf-media {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    font-size: clamp(1.25rem, 5cqw, 2.25rem);
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 3px;
  }
  .acf-line {
    height: 6px;
    background: var(--demo-muted);
    border-radius: 2px;
  }
  .acf-line--short {
    width: 55%;
  }
  .acf-cart {
    position: absolute;
    top: 14%;
    left: 74%;
    width: 12%;
    aspect-ratio: 1;
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 */
  .acf-cart :global(.acf-cart-icon) {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--ink);
  }
  .acf-badge {
    position: absolute;
    top: -8%;
    right: -14%;
    width: 46%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent-strong);
    border-radius: 50%;
    transform: scale(0);
  }
  /* 가로(바깥)·세로(안쪽)를 다른 이징으로 움직여 호를 만든다 */
  .acf-fly-x,
  .acf-fly-y {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* 복사본은 상품 이미지 한가운데에서 출발한다 */
  .acf-dot {
    position: absolute;
    top: 38%;
    left: 30%;
    width: 12%;
    aspect-ratio: 1;
    margin: -6% 0 0 -6%;
    background: var(--accent);
    border-radius: 3px;
    opacity: 0;
  }
  .add-to-cart-fly.is-playing .acf-fly-x {
    animation: add-to-cart-fly-x 700ms linear both;
  }
  .add-to-cart-fly.is-playing .acf-fly-y {
    animation: add-to-cart-fly-y 700ms linear both;
  }
  .add-to-cart-fly.is-playing .acf-dot {
    animation: add-to-cart-fly-shrink 700ms ease-in both;
  }
  .add-to-cart-fly.is-playing .acf-cart {
    animation: add-to-cart-fly-bump 360ms ease-out 680ms both;
  }
  .add-to-cart-fly.is-playing .acf-badge {
    animation: add-to-cart-fly-badge 420ms cubic-bezier(0.34, 1.56, 0.64, 1) 700ms both;
  }
  @keyframes add-to-cart-fly-x {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(50%);
    }
  }
  @keyframes add-to-cart-fly-y {
    0% {
      transform: translateY(0);
      animation-timing-function: ease-out;
    }
    /* 호의 꼭대기 — -30% 면 복사본이 스테이지 윗변 밖으로 나가 잘린다 */
    40% {
      transform: translateY(-24%);
      animation-timing-function: ease-in;
    }
    100% {
      transform: translateY(-16%);
    }
  }
  @keyframes add-to-cart-fly-shrink {
    0% {
      opacity: 1;
      transform: scale(1.6);
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  @keyframes add-to-cart-fly-bump {
    40% {
      transform: scale(1.15);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes add-to-cart-fly-badge {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
</style>

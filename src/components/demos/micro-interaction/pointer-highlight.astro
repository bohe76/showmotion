---
// Pointer Highlight 데모 — 스테이지 안의 작은 페이지([data-scroller])를 스크롤하면(--scroll, 0~1) 제목 줄의 한 단어 둘레로
// 상자가 왼쪽부터 그려지고, 화살표 포인터가 상자 모서리를 따라간다
// 상세 페이지의 큰 스테이지(약 700px)에서도 스크롤할 거리가 남도록 줄을 넉넉히 둔다
import MousePointer2 from '@lucide/astro/icons/mouse-pointer-2';

const before = [92, 78, 86, 64, 90, 72, 84, 58, 88, 76, 80, 66];
const after = [86, 74, 90, 62, 82, 70, 94, 60, 88, 76, 80, 68];
const afterLines = [...after, ...after, ...after];
---
<div class="pointer-highlight" data-demo-root aria-hidden="true">
  <div class="ph-page" data-scroller>
    {before.map((width) => <div class="ph-line" style={`width: ${width}%`}></div>)}
    <div class="ph-headline">
      <span class="ph-word" style="width: 22%"></span>
      <span class="ph-word ph-target" style="width: 28%">
        <span class="ph-box"></span>
        <MousePointer2 class="ph-pointer" stroke-width={1.5} aria-hidden="true" />
      </span>
      <span class="ph-word" style="width: 18%"></span>
    </div>
    {afterLines.map((width) => <div class="ph-line" style={`width: ${width}%`}></div>)}
  </div>
</div>

<style>
  .pointer-highlight {
    display: grid;
    /* 행을 스테이지 높이로 묶어야 안쪽 페이지가 넘치지 않고 스크롤된다 */
    grid-template-rows: minmax(0, 1fr);
    padding: 14px 14% 0;
  }
  .ph-page {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 18px 16px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .ph-line {
    height: 8px;
    background: var(--demo-muted);
    border-radius: 2px;
  }
  .ph-headline {
    display: flex;
    gap: 10px;
    margin: 18px 0;
  }
  .ph-word {
    position: relative;
    height: 16px;
    background: var(--ink);
    border-radius: 2px;
  }
  /* 스크롤 12%~42% 구간을 0~1 로 바꾼 값 — 상자 폭과 포인터 위치가 이 값을 따른다 */
  .ph-target {
    --ph-p: clamp(0, (var(--scroll, 0) - 0.12) * 3.3, 1);
  }
  .ph-box {
    position: absolute;
    top: -7px;
    bottom: -7px;
    left: -7px;
    width: calc(var(--ph-p) * (100% + 14px));
    border: 2px solid var(--accent);
    border-radius: 4px;
    opacity: min(1, calc(var(--ph-p) * 20));
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 — 속은 강조색으로 채우고, 테두리(currentColor)는 바탕색으로 둔다 */
  .ph-target :global(.ph-pointer) {
    position: absolute;
    top: calc(100% + 2px);
    left: calc(var(--ph-p) * (100% + 14px) - 10px);
    width: 20px;
    height: 20px;
    color: var(--surface);
    fill: var(--accent);
    opacity: min(1, calc(var(--ph-p) * 20));
  }
</style>

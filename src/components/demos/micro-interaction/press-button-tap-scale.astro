---
// Press (Button Tap Scale) 데모 — 누를 때마다(.is-playing) 버튼이 살짝 작아졌다가 작은 반동과 함께 제 크기로 돌아온다
---
<div class="press-button-tap-scale" data-demo-root aria-hidden="true">
  <div class="pbt-button">
    <span class="pbt-icon">A</span>
    <span class="pbt-label"></span>
  </div>
</div>

<style>
  .press-button-tap-scale {
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .pbt-button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 44%;
    padding: 14px 18px;
    background: var(--accent);
    border-radius: 10px;
  }
  .pbt-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    font-weight: 700;
    color: var(--accent);
    background: var(--on-accent);
    border-radius: 6px;
  }
  .pbt-label {
    flex: 1;
    height: 10px;
    background: var(--on-accent);
    border-radius: 2px;
    opacity: 0.85;
  }
  .press-button-tap-scale.is-playing .pbt-button {
    animation: press-button-tap-scale-tap 420ms both;
  }
  /* 누름(빠르게 줄어듦) → 뗌(살짝 넘쳤다가 제자리) */
  @keyframes press-button-tap-scale-tap {
    0% {
      transform: scale(1);
      animation-timing-function: ease-out;
    }
    30% {
      transform: scale(0.93);
      background: var(--accent-strong);
      animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

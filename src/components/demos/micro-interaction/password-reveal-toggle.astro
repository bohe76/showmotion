---
// Password Reveal Toggle 데모 — 누를 때마다(.is-on 토글) 눈 아이콘의 사선이 지워지며(열린 눈) 점 대신 글자가 보이고, 다시 누르면 사선이 그려지며 가려진다
// 가린 눈(eye-off)과 열린 눈(eye)을 한 자리에 겹쳐 두고, 가린 눈의 사선을 지우면서 열린 눈으로 바꾼다
import Eye from '@lucide/astro/icons/eye';
import EyeOff from '@lucide/astro/icons/eye-off';
---
<div class="password-reveal-toggle" data-demo-root aria-hidden="true">
  <div class="prt-field">
    <div class="prt-value">
      <span class="prt-dots">••••••</span>
      <span class="prt-text">ABCDEF</span>
    </div>
    <span class="prt-eye">
      <Eye class="prt-open" stroke-width={1.8} aria-hidden="true" />
      <EyeOff class="prt-closed" stroke-width={1.8} aria-hidden="true" />
    </span>
  </div>
</div>

<style>
  .password-reveal-toggle {
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .prt-field {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 62%;
    height: 54px;
    padding: 0 14px;
    background: var(--surface);
    border: 2px solid var(--line);
    border-radius: 8px;
  }
  .prt-value {
    position: relative;
    flex: 1;
    height: 100%;
  }
  .prt-dots,
  .prt-text {
    position: absolute;
    top: 50%;
    left: 0;
    font-weight: 700;
    color: var(--ink);
    transform: translateY(-50%);
    transition:
      opacity 200ms ease-out,
      transform 200ms ease-out;
  }
  .prt-dots {
    font-size: 1.5rem;
    letter-spacing: 0.12em;
  }
  .prt-text {
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    opacity: 0;
    transform: translateY(-20%);
  }
  .prt-eye {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 */
  .prt-eye :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
    transition: opacity 200ms ease-out;
  }
  .prt-eye :global(.prt-open) {
    opacity: 0;
  }
  .prt-eye :global(.prt-open circle) {
    transition: transform 200ms ease-out;
    transform-origin: 12px 12px;
  }
  /* 가려진 상태: 사선이 그어진 눈 — eye-off 의 넷째 경로(m2 2 20 20, 길이 약 28.3)가 사선이다 */
  .prt-eye :global(.prt-closed path:nth-child(4)) {
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-dasharray: 29;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 260ms ease-out;
  }
  /* 켤 때: 사선이 지워지고 나서 열린 눈으로 바뀐다. 끌 때는 가린 눈이 돌아오며 사선이 다시 그려진다 */
  .password-reveal-toggle.is-on .prt-eye :global(.prt-closed path:nth-child(4)) {
    stroke-dashoffset: 29;
  }
  .password-reveal-toggle.is-on .prt-eye :global(.prt-closed) {
    opacity: 0;
    transition-delay: 160ms;
  }
  .password-reveal-toggle.is-on .prt-eye :global(.prt-open) {
    opacity: 1;
    transition-delay: 160ms;
  }
  .password-reveal-toggle.is-on .prt-eye :global(.prt-open circle) {
    transform: scale(1.2);
  }
  .password-reveal-toggle.is-on .prt-dots {
    opacity: 0;
    transform: translateY(-80%);
  }
  .password-reveal-toggle.is-on .prt-text {
    opacity: 1;
    transform: translateY(-50%);
  }
</style>

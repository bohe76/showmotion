---
// Secondary Action 데모 — 본 움직임은 B 가 출발선에서 도착선까지 가는 것이다. 그 위에 올라탄 작은 조각이 가는 도중에 폴짝 뛰며 한 번씩 뒤집힌다(두 번)
// 작은 동작이 본 움직임 곁에서 같이 벌어져 생기를 더한다. 본 움직임을 가리지 않는다 — 작고, 본 움직임 안에서 시작해 안에서 끝난다
// 아래 옅은 블록은 같은 본 움직임만 한다 — 조각이 가만히 얹혀 있다
// 시간 막대의 띠(26~42% · 56~72%)가 보조 동작이 벌어지는 구간이다. 키프레임의 %와 같은 값이어야 한다
// Follow Through 와 다르다: 그쪽 막대는 본체에 끌려 늦게 따라올 뿐이다(떠날 때 처지고 멈춘 뒤에 흔들린다)
//   이쪽 조각은 스스로 움직인다 — 본체가 고르게 가고 있는 한가운데에서 제 박자로 뛰고, 본체가 멈출 때는 이미 가만히 있다
// 조각은 블록의 의사 요소다(MgTrack 의 블록에는 자식이 없다). 눈금은 감춘다 — 대조 블록도 등속이 아니다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';
---
<div class="mg-secondary-action" data-demo-root aria-hidden="true">
  <MgFrame
    duration="3s"
    ranges={[
      [26, 42],
      [56, 72],
    ]}
  >
    <MgTrack />
  </MgFrame>
</div>

<style>
  .mg-secondary-action {
    --mgtr-curve: cubic-bezier(0.45, 0, 0.55, 1);
  }
  /* 조각이 뛸 자리를 위에 낸다: 블록을 줄이고 줄을 내린다 */
  .mg-secondary-action :global(.mgtr) {
    --mgtr-size: 12cqw;
    --mg-secondary-action-size: 4.4cqw;
  }
  .mg-secondary-action :global(.mgtr-lane-hero) {
    top: 15cqw;
  }
  .mg-secondary-action :global(.mgtr-lane-ghost) {
    top: 36cqw;
  }
  .mg-secondary-action :global(.mgtr-hero) {
    font-size: 5.4cqw;
  }
  .mg-secondary-action :global(.mgtr-tick) {
    display: none;
  }
  .mg-secondary-action :global(.mgtr-block)::before {
    position: absolute;
    bottom: 100%;
    left: calc(50% - var(--mg-secondary-action-size) / 2);
    width: var(--mg-secondary-action-size);
    aspect-ratio: 1;
    content: '';
    background: inherit;
    border-radius: 2px;
  }
  /* 본 움직임: 두 블록이 같은 곡선으로 같이 간다 */
  .mg-secondary-action.is-playing :global(.mgtr-block) {
    animation: mg-track-run var(--mg-duration) var(--mgtr-curve) forwards;
  }
  .mg-secondary-action.is-playing :global(.mgtr-hero)::before {
    animation: mg-secondary-action-flip var(--mg-duration) forwards;
  }
  /* 한 번 뛸 때마다 90° 씩 돈다 — 정사각형이라 내려앉으면 처음과 같은 모습이다. 오를 때 감속, 내릴 때 가속 */
  @keyframes mg-secondary-action-flip {
    0%,
    26% {
      translate: 0 0;
      rotate: 0deg;
      animation-timing-function: cubic-bezier(0.333, 0.667, 0.667, 1);
    }
    34% {
      translate: 0 -4.5cqw;
      rotate: 45deg;
      animation-timing-function: cubic-bezier(0.333, 0, 0.667, 0.333);
    }
    42%,
    56% {
      translate: 0 0;
      rotate: 90deg;
      animation-timing-function: cubic-bezier(0.333, 0.667, 0.667, 1);
    }
    64% {
      translate: 0 -4.5cqw;
      rotate: 135deg;
      animation-timing-function: cubic-bezier(0.333, 0, 0.667, 0.333);
    }
    72%,
    100% {
      translate: 0 0;
      rotate: 180deg;
    }
  }
</style>

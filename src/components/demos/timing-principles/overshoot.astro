---
// Overshoot 데모 — B 가 도착선을 한 번 살짝 넘었다가 되돌아와 선에 멈춘다. 아래 옅은 블록은 같은 거리를 등속으로 가서 선에서 그대로 멈춘다
// 넘는 것은 한 번뿐이다(여러 번 출렁이면 Elastic, 선에 부딪혀 되튀면 Bounce). 시간 막대의 띠는 B 가 선 바깥에 있는 구간이다 — 곡선을 바꾸면 띠도 맞춘다
// 변형(Back 곡선의 방향 — 이름은 Bounce·Elastic 과 같은 축으로 쓴다): out(기본 — 도착선을 넘는다, 띠 32~100%)
//       · in-out(출발선 뒤로 한 번 빠졌다가 가서 도착선도 넘는다, 띠 0~38%·62~100%)
// 인벤토리의 Back In 은 뺐다 — 도착선을 넘지 않고 출발 전에만 빠지는 움직임이라 Anticipation 데모와 같다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';

const ranges: Record<string, [number, number][]> = {
  out: [[32, 100]],
  'in-out': [
    [0, 38],
    [62, 100],
  ],
};
---
<div class="mg-overshoot" data-demo-root aria-hidden="true">
  <MgFrame duration="3s" ranges={ranges}>
    <MgTrack />
  </MgFrame>
</div>

<style>
  .mg-overshoot {
    --mgtr-curve: cubic-bezier(0.34, 1.7, 0.64, 1);
  }
  .mg-overshoot[data-variant='in-out'] {
    --mgtr-curve: cubic-bezier(0.68, -0.8, 0.32, 1.8);
  }
  .mg-overshoot.is-playing :global(.mgtr-hero) {
    animation: mg-track-run var(--mg-duration) var(--mgtr-curve) forwards;
  }
</style>

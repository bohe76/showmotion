---
// Follow Through and Overlapping Action 데모 — B 위에 느슨하게 달린 막대 둘(긴 것·짧은 것)이 본체와 같이 움직이지 않는다
// 본체가 떠나면 막대는 뒤로 처져 끌려가고(drag), 본체가 도착선에 딱 멈춘 뒤에도 막대는 계속 가서 앞으로 넘어갔다가 흔들리며 가라앉는다(follow through)
// 두 막대도 서로 어긋난다(overlapping) — 긴 것이 더 크게, 더 느리게, 더 오래 흔들린다. 짧은 것이 먼저 멈춘다
// 아래 옅은 블록은 같은 움직임을 한 덩어리로 한다 — 막대가 굳어 있어 본체와 같이 떠나고 같이 멈춘다
// 시간 막대의 띠(50~96%)는 본체가 멈춘 뒤에 막대가 아직 움직이는 구간이다. 본체는 10~50% 에 간다(지연과 길이를 전체 길이의 비율로 준다)
// Secondary Action 과 다르다: 이쪽 막대는 본체의 움직임에 끌려 늦게 따라올 뿐 스스로 하는 동작이 없다
// 막대는 블록의 의사 요소다(MgTrack 의 블록에는 자식이 없다). 눈금은 감춘다 — 대조 블록도 등속이 아니다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';
---
<div class="mg-follow-through-and-overlapping-action" data-demo-root aria-hidden="true">
  <MgFrame duration="3s" ranges={[[50, 96]]}>
    <MgTrack />
  </MgFrame>
</div>

<style>
  /* 막대가 설 자리를 위에 낸다: 블록을 줄이고 줄을 내린다 */
  .mg-follow-through-and-overlapping-action :global(.mgtr) {
    --mgtr-size: 12cqw;
  }
  .mg-follow-through-and-overlapping-action :global(.mgtr-lane-hero) {
    top: 14cqw;
  }
  .mg-follow-through-and-overlapping-action :global(.mgtr-lane-ghost) {
    top: 36cqw;
  }
  .mg-follow-through-and-overlapping-action :global(.mgtr-hero) {
    font-size: 5.4cqw;
  }
  .mg-follow-through-and-overlapping-action :global(.mgtr-tick) {
    display: none;
  }
  /* 막대: 블록 윗변에 뿌리를 두고 그 자리를 축으로 기운다 */
  .mg-follow-through-and-overlapping-action :global(.mgtr-block)::before,
  .mg-follow-through-and-overlapping-action :global(.mgtr-block)::after {
    position: absolute;
    bottom: 100%;
    width: 1.4cqw;
    content: '';
    background: inherit;
    border-radius: 0.7cqw 0.7cqw 0 0;
    transform-origin: 50% 100%;
  }
  .mg-follow-through-and-overlapping-action :global(.mgtr-block)::before {
    left: 20%;
    height: 8cqw;
  }
  .mg-follow-through-and-overlapping-action :global(.mgtr-block)::after {
    left: 66%;
    height: 5cqw;
  }
  /* 본체: 점점 빨라지다가 도착선에서 딱 멈춘다 — 멈춤이 갑작스러울수록 달린 것이 크게 넘어간다. 대조 블록도 똑같이 간다 */
  .mg-follow-through-and-overlapping-action.is-playing :global(.mgtr-block) {
    animation: mg-track-run calc(var(--mg-duration) * 0.4) cubic-bezier(0.5, 0, 0.9, 0.8) calc(var(--mg-duration) * 0.1)
      forwards;
  }
  .mg-follow-through-and-overlapping-action.is-playing :global(.mgtr-hero)::before {
    animation: mg-follow-through-and-overlapping-action-long var(--mg-duration) ease-in-out forwards;
  }
  .mg-follow-through-and-overlapping-action.is-playing :global(.mgtr-hero)::after {
    animation: mg-follow-through-and-overlapping-action-short var(--mg-duration) ease-in-out forwards;
  }
  /* 음수 = 뒤로(왼쪽으로) 처진다. 본체가 가는 동안(10~50%) 처져 있다가 멈춘 뒤 앞으로 넘어가 흔들린다 */
  @keyframes mg-follow-through-and-overlapping-action-long {
    0%,
    10% {
      rotate: 0deg;
    }
    22% {
      rotate: -15deg;
    }
    36% {
      rotate: -22deg;
    }
    49% {
      rotate: -27deg;
    }
    57% {
      rotate: 34deg;
    }
    66% {
      rotate: -20deg;
    }
    75% {
      rotate: 12deg;
    }
    83% {
      rotate: -6deg;
    }
    90% {
      rotate: 2deg;
    }
    96%,
    100% {
      rotate: 0deg;
    }
  }
  @keyframes mg-follow-through-and-overlapping-action-short {
    0%,
    10% {
      rotate: 0deg;
    }
    19% {
      rotate: -9deg;
    }
    34% {
      rotate: -13deg;
    }
    49.5% {
      rotate: -16deg;
    }
    54.5% {
      rotate: 20deg;
    }
    60% {
      rotate: -11deg;
    }
    65.5% {
      rotate: 6deg;
    }
    71% {
      rotate: -3deg;
    }
    76% {
      rotate: 1deg;
    }
    81%,
    100% {
      rotate: 0deg;
    }
  }
</style>

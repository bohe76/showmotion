---
// Arcs 데모 — B 가 출발선에서 도착선까지 곧게 가지 않고 굽은 길(호)로 간다. 던진 물건처럼 올라갔다 내려온다
// 아래 옅은 블록은 같은 두 선 사이를 같은 시간에 곧게 간다 — 두 블록의 가로 자리는 늘 같고, 다른 것은 길의 모양뿐이다
// 주인공 줄의 점들이 B 의 앞쪽 아래 모서리가 지나는 길이다(같은 시간 간격마다 한 점). 대조 블록의 눈금과 가로 자리가 같다. 재생하지 않아도 굽은 길 ↔ 곧은 길이 보인다
// 가로는 공용 키프레임(translate, 등속), 세로는 transform 으로 따로 움직인다 — 두 속성이 더해져 포물선이 된다(올라갈 때 감속, 내려올 때 가속)
// 웹 구역의 Motion Path 는 그려 둔 임의의 길을 따라가게 하는 기법이고, 이쪽은 "직선 대신 호"라는 원칙이다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';
---
<div class="mg-arcs" data-demo-root aria-hidden="true">
  <MgFrame duration="3s">
    <MgTrack />
  </MgFrame>
</div>

<style>
  /* 호가 올라갈 자리를 위에 낸다: 블록을 줄이고 주인공 줄을 내린다 */
  .mg-arcs :global(.mgtr) {
    --mgtr-size: 11cqw;
    --mg-arcs-height: 13cqw;
  }
  .mg-arcs :global(.mgtr-lane-hero) {
    top: 19cqw;
  }
  .mg-arcs :global(.mgtr-lane-ghost) {
    top: 35cqw;
  }
  .mg-arcs :global(.mgtr-hero) {
    font-size: 5cqw;
  }
  /* 눈금을 호 위의 점으로 옮긴다: i/12 지점의 높이 = 4h · t · (1 - t). 가로 자리는 눈금 그대로다(등속) */
  .mg-arcs :global(.mgtr-tick-hero) {
    top: 100%;
    width: 1.2cqw;
    height: 1.2cqw;
    margin: -0.6cqw 0 0 -0.6cqw;
    border-radius: 50%;
    translate: 0 calc(var(--mg-arcs-height) * -4 * var(--mgtr-i) / 12 * (1 - var(--mgtr-i) / 12));
  }
  .mg-arcs.is-playing :global(.mgtr-hero) {
    animation:
      mg-track-run var(--mg-duration) linear forwards,
      mg-arcs-lift var(--mg-duration) forwards;
  }
  /* 곡선 둘은 2차 감속(y = 1 - (1 - x)²)과 2차 가속(y = x²)이다 — 등속인 가로와 합쳐 정확한 포물선 */
  @keyframes mg-arcs-lift {
    0% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.333, 0.667, 0.667, 1);
    }
    50% {
      transform: translateY(calc(var(--mg-arcs-height) * -1));
      animation-timing-function: cubic-bezier(0.333, 0, 0.667, 0.333);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>

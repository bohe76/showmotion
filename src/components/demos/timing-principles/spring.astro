---
// Spring 데모 — 정해진 곡선이 아니라 물리(강성·감쇠·질량)에서 나온 움직임이다. B 가 멈춘 데서 힘을 받아 떠나 도착선을 지나치고 출렁이다 멈춘다
// 아래 옅은 블록은 같은 거리를 등속으로 간다
// Elastic 과 닮았지만 출발이 다르다: 스프링은 정지에서 점점 빨라지며 떠나고 묵직하게 몇 번만 출렁인다(Elastic 은 처음부터 가장 빠르고 잘게 여러 번 떤다)
// 변형은 감쇠다 — 같은 스프링이 감쇠에 따라 다르게 멈춘다:
//   bouncy(기본 — 감쇠가 약하다. 도착선을 넘어 출렁인다. 시간 막대의 띠 16~87% 가 출렁이는 구간)
//   · smooth(감쇠가 세다 — 넘지 않고 부드럽게 다가가 멈춘다) · clamped(넘침을 잘랐다 — bouncy 와 똑같이 가다가 도착선에 닿는 순간 그대로 선다)
// 곡선은 감쇠 스프링의 응답(bouncy: 감쇠비 0.4, smooth·임계 감쇠: 1)을 linear() 로 옮긴 것이다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';

const ranges: Record<string, [number, number][]> = {
  bouncy: [[16, 87]],
  smooth: [],
  clamped: [],
};
---
<div class="mg-spring" data-demo-root aria-hidden="true">
  <MgFrame duration="3s" ranges={ranges}>
    <MgTrack />
  </MgFrame>
</div>

<style>
  .mg-spring {
    --mgtr-curve: linear(
      0, 0.01 1.1%, 0.04 2.2%, 0.09 3.4%, 0.162 4.6%, 0.233 5.7%, 0.324 6.9%, 0.672 11.3%, 0.809 13.1%, 0.936 14.9%,
      1.037 16.6%, 1.118 18.3%, 1.179 20%, 1.223 21.7%, 1.249 23.4%, 1.258 24.6%, 1.258 25.9%, 1.252 27.2%, 1.238 28.6%,
      1.195 31.4%, 1.064 37.9%, 1.008 41.1%, 0.984 42.9%, 0.965 44.7%, 0.952 46.5%, 0.943 48.3%, 0.939 51%, 0.945 53.9%,
      1.002 66.3%, 1.019 73%, 1.019 78.9%, 1.004 92.3%, 1
    );
  }
  .mg-spring[data-variant='smooth'] {
    --mgtr-curve: linear(
      0, 0.005 1.3%, 0.02 2.7%, 0.046 4.2%, 0.083 5.9%, 0.162 8.9%, 0.362 15.8%, 0.456 19.2%, 0.546 22.8%, 0.624 26.3%,
      0.69 29.8%, 0.747 33.3%, 0.797 37%, 0.84 40.8%, 0.881 45.5%, 0.915 50.6%, 0.942 56.2%, 0.962 62.5%, 0.978 69.5%,
      0.988 77.6%, 1
    );
  }
  .mg-spring[data-variant='clamped'] {
    --mgtr-curve: linear(
      0, 0.01 1.1%, 0.04 2.2%, 0.091 3.4%, 0.163 4.7%, 0.235 5.7%, 0.326 7%, 0.664 11.2%, 0.795 12.8%, 0.914 14.5%,
      1 16%, 1
    );
  }
  .mg-spring.is-playing :global(.mgtr-hero) {
    animation: mg-track-run var(--mg-duration) var(--mgtr-curve) forwards;
  }
</style>

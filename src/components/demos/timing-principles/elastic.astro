---
// Elastic 데모 — B 가 단숨에 도착선까지 가서 선 둘레를 여러 번 출렁이다 멈춘다. 당겼다 놓은 고무줄처럼 넘었다 못 미쳤다를 되풀이하며 잦아든다
// 아래 옅은 블록은 같은 거리를 등속으로 간다 — B 가 출렁임을 다 마친 뒤에야 닿는다
// 한 번만 넘으면 Overshoot, 선을 넘지 않고 되튀면 Bounce 다. 시간 막대의 띠는 출렁이는 구간(선에서 1% 넘게 벗어난 동안)이다 — 곡선을 바꾸면 띠도 맞춘다
// 변형: out(기본 — 도착선 둘레에서 출렁인다, 띠 7.5~63%) · in-out(출발선 둘레에서 출렁이다 가서 도착선 둘레에서도 출렁인다, 띠 25~44.4%·55.6~75%)
//       · in(출발선 둘레에서 점점 크게 출렁이다 튀어 나간다, 띠 37~92.5%)
// 곡선은 표준 일래스틱 식을 linear() 로 옮긴 것이다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';

const ranges: Record<string, [number, number][]> = {
  out: [[7.5, 63]],
  'in-out': [
    [25, 44.4],
    [55.6, 75],
  ],
  in: [[37, 92.5]],
};
---
<div class="mg-elastic" data-demo-root aria-hidden="true">
  <MgFrame duration="3s" ranges={ranges}>
    <MgTrack />
  </MgFrame>
</div>

<style>
  .mg-elastic {
    --mgtr-curve: linear(
      0, 0.039 0.5%, 0.087 1%, 0.146 1.5%, 0.218 2.1%, 0.372 3.2%, 0.715 5.5%, 0.86 6.5%, 1.003 7.5%, 1.115 8.5%,
      1.173 9.1%, 1.221 9.6%, 1.262 10.2%, 1.297 10.7%, 1.325 11.3%, 1.347 11.8%, 1.362 12.4%, 1.371 13%, 1.373 13.7%,
      1.364 14.5%, 1.345 15.3%, 1.315 16.2%, 1.243 17.8%, 1.032 21.8%, 0.982 22.9%, 0.941 24%, 0.913 24.9%, 0.891 25.9%,
      0.877 26.9%, 0.869 27.9%, 0.87 29.2%, 0.882 30.7%, 0.907 32.4%, 0.981 36.4%, 1.012 38.3%, 1.036 40.5%, 1.046 42.7%,
      1.042 45.7%, 0.996 53.3%, 0.984 57.5%, 0.985 60.7%, 1.001 68.1%, 1.006 72.2%, 0.998 86.7%, 1
    );
  }
  .mg-elastic[data-variant='in-out'] {
    --mgtr-curve: linear(
      0, 0.001 8.5%, -0.005 19.2%, 0.002 22.4%, 0.023 27.9%, 0.023 30.2%, 0.014 31.9%, -0.006 33.5%, -0.031 35%,
      -0.091 37.9%, -0.109 39.1%, -0.118 40.2%, -0.115 41.2%, -0.099 42.1%, -0.07 43%, -0.027 43.9%, 0.031 44.8%,
      0.085 45.5%, 0.151 46.3%, 0.369 48.5%, 0.432 49.1%, 0.474 49.6%, 0.534 50.4%, 0.582 51%, 0.826 53.5%, 0.929 54.6%,
      0.995 55.5%, 1.045 56.4%, 1.082 57.3%, 1.106 58.2%, 1.114 58.8%, 1.118 59.4%, 1.112 60.8%, 1.092 62%, 1.031 65%,
      1.005 66.5%, 0.985 68.2%, 0.976 69.9%, 0.977 72.2%, 0.998 77.6%, 1.005 80.8%, 0.999 91.5%, 1
    );
  }
  .mg-elastic[data-variant='in'] {
    --mgtr-curve: linear(
      0, 0.002 13.4%, -0.006 27.8%, -0.001 31.9%, 0.015 39.3%, 0.016 42.5%, 0.004 46.8%, -0.042 54.3%, -0.046 57.3%,
      -0.036 59.5%, -0.012 61.7%, 0.019 63.6%, 0.093 67.6%, 0.118 69.3%, 0.13 70.8%, 0.131 72.2%, 0.123 73.1%,
      0.109 74.1%, 0.087 75%, 0.059 76%, 0.018 77.1%, -0.032 78.2%, -0.243 82.2%, -0.315 83.8%, -0.345 84.7%,
      -0.364 85.5%, -0.373 86.3%, -0.371 87.1%, -0.362 87.6%, -0.347 88.2%, -0.325 88.7%, -0.297 89.3%, -0.262 89.8%,
      -0.221 90.4%, -0.173 90.9%, -0.115 91.5%, -0.003 92.5%, 0.14 93.5%, 0.285 94.5%, 0.628 96.8%, 0.782 97.9%,
      0.854 98.5%, 0.913 99%, 0.961 99.5%, 1
    );
  }
  .mg-elastic.is-playing :global(.mgtr-hero) {
    animation: mg-track-run var(--mg-duration) var(--mgtr-curve) forwards;
  }
</style>

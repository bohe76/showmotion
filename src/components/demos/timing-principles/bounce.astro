---
// Bounce 데모 — B 가 도착선에 바닥처럼 부딪혀 되튄다. 튈 때마다 작아지고, 선을 넘지 않는다. 닿는 순간마다 딱 멈췄다가 방향이 바뀐다
// 아래 옅은 블록은 같은 거리를 등속으로 가서 선에서 그대로 멈춘다
// 선을 넘어 출렁이면 Elastic, 한 번만 넘었다 돌아오면 Overshoot 이다. 시간 막대의 띠는 튀는 구간이다 — 곡선을 바꾸면 띠도 맞춘다
// 변형: out(기본 — 도착선에서 튄다, 띠 36.4~100%) · in-out(출발선에서 튀다 떠나 도착선에서도 튄다, 띠 0~31.8%·68.2~100%) · in(출발선에서 점점 크게 튀다 떠난다, 띠 0~63.6%)
// 곡선은 표준 바운스 식을 linear() 로 옮긴 것이다. 닿는 순간(값 1 또는 0)은 꼭짓점이 뭉개지지 않게 그 시각에 점을 둔다
import MgFrame from '../../mg/MgFrame.astro';
import MgTrack from '../../mg/MgTrack.astro';

const ranges: Record<string, [number, number][]> = {
  out: [[36.4, 100]],
  'in-out': [
    [0, 31.8],
    [68.2, 100],
  ],
  in: [[0, 63.6]],
};
---
<div class="mg-bounce" data-demo-root aria-hidden="true">
  <MgFrame duration="3s" ranges={ranges}>
    <MgTrack />
  </MgFrame>
</div>

<style>
  .mg-bounce {
    --mgtr-curve: linear(
      0, 0.004 2.3%, 0.015 4.5%, 0.035 6.8%, 0.062 9.1%, 0.097 11.3%, 0.14 13.6%, 0.191 15.9%, 0.25 18.2%, 0.316 20.4%,
      0.391 22.7%, 0.472 25%, 0.562 27.3%, 0.658 29.5%, 0.762 31.8%, 0.87 33.9%, 1 36.4%, 0.941 38.6%, 0.891 40.9%,
      0.848 43.2%, 0.813 45.5%, 0.785 47.7%, 0.766 50%, 0.754 52.3%, 0.75 54.5%, 0.754 56.8%, 0.766 59.1%, 0.785 61.4%,
      0.812 63.6%, 0.848 65.9%, 0.89 68.2%, 0.941 70.5%, 1 72.7%, 0.972 75%, 0.953 77.3%, 0.941 79.5%, 0.938 81.8%,
      0.941 84.1%, 0.953 86.4%, 0.973 88.6%, 1 90.9%, 0.988 93.2%, 0.984 95.5%, 0.988 97.7%, 1
    );
  }
  .mg-bounce[data-variant='in-out'] {
    --mgtr-curve: linear(
      0, 0.008 2.3%, 0 4.5%, 0.023 6.8%, 0.031 9.1%, 0.024 11.3%, 0 13.6%, 0.056 16%, 0.094 18.2%, 0.117 20.5%,
      0.125 22.7%, 0.117 25%, 0.094 27.3%, 0.056 29.5%, 0 31.8%, 0.118 34.1%, 0.219 36.4%, 0.305 38.6%, 0.375 40.9%,
      0.43 43.2%, 0.469 45.5%, 0.492 47.7%, 0.5 50%, 0.508 52.3%, 0.531 54.5%, 0.57 56.8%, 0.625 59.1%, 0.696 61.4%,
      0.782 63.6%, 0.882 65.9%, 1 68.2%, 0.944 70.5%, 0.906 72.8%, 0.883 75%, 0.875 77.3%, 0.883 79.5%, 0.906 81.8%,
      0.944 84%, 1 86.4%, 0.976 88.6%, 0.969 90.9%, 0.977 93.2%, 1 95.5%, 0.992 97.7%, 1
    );
  }
  .mg-bounce[data-variant='in'] {
    --mgtr-curve: linear(
      0, 0.012 2.3%, 0.016 4.5%, 0.012 6.8%, 0 9.1%, 0.027 11.4%, 0.047 13.7%, 0.059 15.9%, 0.062 18.2%, 0.059 20.4%,
      0.047 22.7%, 0.028 25%, 0 27.3%, 0.059 29.5%, 0.11 31.8%, 0.152 34.1%, 0.188 36.4%, 0.215 38.6%, 0.234 40.9%,
      0.246 43.2%, 0.25 45.5%, 0.246 47.7%, 0.235 50%, 0.215 52.3%, 0.188 54.5%, 0.153 56.8%, 0.11 59.1%, 0.059 61.4%,
      0 63.6%, 0.13 66.1%, 0.238 68.3%, 0.342 70.5%, 0.438 72.8%, 0.527 75%, 0.609 77.3%, 0.684 79.5%, 0.75 81.8%,
      0.808 84.1%, 0.859 86.4%, 0.902 88.6%, 0.937 90.9%, 0.965 93.2%, 0.984 95.5%, 0.996 97.7%, 1
    );
  }
  .mg-bounce.is-playing :global(.mgtr-hero) {
    animation: mg-track-run var(--mg-duration) var(--mgtr-curve) forwards;
  }
</style>

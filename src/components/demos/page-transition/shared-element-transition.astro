---
// Shared Element Transition 데모 — 누를 때마다(.is-on 토글) 목록 페이지의 썸네일 A가 자리와 크기를 바꿔 상세 페이지의 큰 그림이 되고, 나머지 내용은 서로 엇갈려 바뀐다
// 공유 요소는 두 페이지 위에 따로 두고, 각 페이지에서 비워 둔 칸의 좌표로 옮긴다
---
<div class="shared-element" data-demo-root aria-hidden="true">
  <div class="se-frame">
    <div class="se-page se-page--a">
      <span class="se-bar"></span>
      <span class="se-line se-line--short"></span>
      <div class="se-thumbs">
        <span class="se-thumb">B</span>
        <span></span>
        <span class="se-thumb">C</span>
      </div>
      <span class="se-line"></span>
    </div>
    <div class="se-page se-page--b">
      <span class="se-bar"></span>
      <span></span>
      <span class="se-line"></span>
      <span class="se-line se-line--short"></span>
      <span class="se-line"></span>
    </div>
    <span class="se-shared">A</span>
  </div>
</div>

<style>
  .shared-element {
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .se-frame {
    position: relative;
    width: 60%;
    height: 80%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .se-page {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 12px;
    background: var(--surface);
    transition: opacity 300ms ease-in-out;
  }
  .se-page--a {
    grid-template-rows: 8px 8px 28%;
  }
  .se-page--b {
    grid-template-rows: 8px 46%;
    background: var(--stage);
    opacity: 0;
  }
  .shared-element.is-on .se-page--a {
    opacity: 0;
  }
  .shared-element.is-on .se-page--b {
    opacity: 1;
  }
  .se-bar {
    width: 40%;
    border-radius: 2px;
    background: var(--ink);
  }
  .se-thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .se-thumb {
    display: grid;
    place-items: center;
    font-weight: 700;
    color: var(--ink);
    background: var(--demo-muted);
    border-radius: 4px;
  }
  .se-line {
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .se-line--short {
    width: 60%;
  }
  /* 행 퍼센트는 안쪽 높이(프레임 − 위아래 여백 24px) 기준이라 같은 식으로 맞춘다
     A: 셋째 줄 가운데 칸(위 48px), B: 둘째 줄 전체(위 30px) */
  .se-shared {
    position: absolute;
    top: 48px;
    left: calc((100% - 44px) / 3 + 22px);
    z-index: 1;
    display: grid;
    place-items: center;
    width: calc((100% - 44px) / 3);
    height: calc((100% - 24px) * 0.28);
    font-size: 1rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
    transition:
      top 450ms cubic-bezier(0.22, 1, 0.36, 1),
      left 450ms cubic-bezier(0.22, 1, 0.36, 1),
      width 450ms cubic-bezier(0.22, 1, 0.36, 1),
      height 450ms cubic-bezier(0.22, 1, 0.36, 1),
      font-size 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shared-element.is-on .se-shared {
    top: 30px;
    left: 12px;
    width: calc(100% - 24px);
    height: calc((100% - 24px) * 0.46);
    font-size: 1.75rem;
  }
</style>

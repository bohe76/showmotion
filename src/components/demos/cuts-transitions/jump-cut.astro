---
// Jump Cut 데모 — 컷 지점 두 곳에서 화면이 툭 건너뛴다. 시간 막대의 눈금이 컷 지점이다(34%, 67%). 키프레임의 건너뛰는 지점과 같은 값이어야 한다
// 변형: temporal(기본) — 카메라와 구도는 그대로, B 가 천천히 걷다가 컷에서 앞으로 건너뛴다(시간이 잘려 나갔다)
//       spatial — B 는 끊기지 않고 걷는데, 컷에서 구도(크기·위치)가 조금 바뀐다(같은 대상을 살짝 다른 자리에서 찍었다)
import MgFrame from '../../mg/MgFrame.astro';
import MgScene from '../../mg/MgScene.astro';
---
<div class="mg-jump-cut" data-demo-root aria-hidden="true">
  <MgFrame duration="4s" cuts={[34, 67]}>
    <MgScene />
  </MgFrame>
</div>

<style>
  .mg-jump-cut :global(.mgs-b) {
    translate: -20cqw 0;
  }
  .mg-jump-cut.is-playing :global(.mgs-b) {
    animation: mg-jump-cut-walk var(--mg-duration) linear forwards;
  }
  /* 34%·67% 에서 중간 과정 없이 위치가 바뀐다 — 그 사이는 느린 등속 */
  @keyframes mg-jump-cut-walk {
    0% {
      translate: -20cqw 0;
    }
    34% {
      translate: -13cqw 0;
    }
    34.01% {
      translate: -2cqw 0;
    }
    67% {
      translate: 5cqw 0;
    }
    67.01% {
      translate: 14cqw 0;
    }
    100% {
      translate: 20cqw 0;
    }
  }
  /* spatial: B 는 처음부터 끝까지 등속, 장면 전체가 컷마다 다른 구도로 바뀐다. 가장자리가 비지 않게 늘 1 보다 크게 잡는다 */
  .mg-jump-cut[data-variant='spatial'].is-playing :global(.mgs-b) {
    animation-name: mg-jump-cut-steady;
  }
  .mg-jump-cut[data-variant='spatial'].is-playing :global(.mgs) {
    animation: mg-jump-cut-reframe var(--mg-duration) linear forwards;
  }
  @keyframes mg-jump-cut-steady {
    to {
      translate: 20cqw 0;
    }
  }
  @keyframes mg-jump-cut-reframe {
    0%,
    34% {
      scale: 1;
      translate: 0 0;
    }
    34.01%,
    67% {
      scale: 1.3;
      translate: 5cqw 3cqw;
    }
    67.01%,
    100% {
      scale: 1.12;
      translate: -5cqw 1cqw;
    }
  }
</style>

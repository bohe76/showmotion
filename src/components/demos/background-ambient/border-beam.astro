---
// Border Beam 데모 — 카드 뒤에서 빛 한 조각이 그려진 정사각형이 돌고, 카드 안쪽 면이 가운데를 덮어 테두리로만 보인다
// 각도 변수(@property)를 움직이면 매 프레임 다시 칠하므로 transform 회전을 쓴다
---
<div class="border-beam" data-demo-root aria-hidden="true">
  <div class="bb-card">
    <span class="bb-spin"></span>
    <div class="bb-face">
      <span class="bb-mark">A</span>
      <span class="bb-bar"></span>
      <span class="bb-bar bb-bar--short"></span>
    </div>
  </div>
</div>

<style>
  .border-beam {
    display: grid;
    place-items: center;
  }
  .bb-card {
    position: relative;
    display: grid;
    width: 52%;
    aspect-ratio: 4 / 3;
    padding: 2px;
    overflow: hidden;
    background: var(--line);
    border-radius: 10px;
  }
  .bb-spin {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 160%;
    aspect-ratio: 1;
    background: conic-gradient(transparent 0 72%, var(--accent) 92%, transparent 100%);
    animation: border-beam-spin 4s linear infinite;
    translate: -50% -50%;
  }
  .bb-face {
    position: relative;
    display: grid;
    align-content: center;
    gap: 8px;
    padding: 0 14%;
    background: var(--surface);
    border-radius: 8px;
  }
  .bb-mark {
    display: grid;
    place-items: center;
    width: 26%;
    aspect-ratio: 1;
    margin-bottom: 4px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .bb-bar {
    height: 10px;
    background: var(--ink);
    border-radius: 2px;
  }
  .bb-bar--short {
    width: 60%;
    height: 8px;
    background: var(--demo-muted);
  }
  @keyframes border-beam-spin {
    to {
      transform: rotate(1turn);
    }
  }
</style>

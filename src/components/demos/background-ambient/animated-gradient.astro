---
// Animated Gradient 데모 — 같은 색 순서를 두 번 이어 칠한 2배 폭 층을 -50% 옮겨 이음매 없이 흐르게 한다
// background-position 대신 transform 으로 움직여 매 프레임 다시 칠하지 않는다
---
<div class="animated-gradient" data-demo-root aria-hidden="true">
  <div class="ag-tilt">
    <div class="ag-layer"></div>
  </div>
  <div class="ag-card">
    <span class="ag-bar"></span>
    <span class="ag-bar ag-bar--short"></span>
  </div>
</div>

<style>
  .animated-gradient {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .ag-tilt {
    position: absolute;
    inset: -40%;
    transform: rotate(-18deg);
  }
  .ag-layer {
    width: 200%;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--accent) 0%,
      var(--highlight) 16.66%,
      var(--surface) 33.33%,
      var(--accent) 50%,
      var(--highlight) 66.66%,
      var(--surface) 83.33%,
      var(--accent) 100%
    );
    animation: animated-gradient-pan 12s linear infinite;
  }
  .ag-card {
    position: relative;
    display: grid;
    gap: 8px;
    width: 42%;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .ag-bar {
    height: 10px;
    background: var(--ink);
    border-radius: 2px;
  }
  .ag-bar--short {
    width: 60%;
    height: 8px;
    background: var(--demo-muted);
  }
  @keyframes animated-gradient-pan {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

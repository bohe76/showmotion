---
// Progressive Blur 데모 — 작은 페이지([data-scroller])의 위·아래 가장자리로 갈수록 내용이 점점 더 흐려진다
// 흐림 세기가 다른 층 4개를 겹치고 층마다 다른 구간만 mask 로 남겨 흐림이 계단 없이 올라가게 한다
// 위 가장자리는 스크롤을 내리면(--scroll) 나타나고, 아래 가장자리는 끝에 닿으면 사라진다 — 더 볼 내용이 있는 쪽에만 흐림
// 상세 페이지의 큰 스테이지에서도 스크롤할 거리가 남도록 내용을 스테이지 높이의 두 배쯤 둔다
const items = ['A', 64, 'B', 82, 58, 'C', 76, 'D', 90, 62, 'E', 70, 'F', 84, 'G', 66, 'H', 78, 60, 'I', 88, 'J', 72, 'K', 80, 'L', 68];
const layers = [1, 2, 3, 4];
---
<div class="progressive-blur" data-demo-root aria-hidden="true">
  <div class="pb-frame">
    <div class="pb-page" data-scroller>
      {items.map((item) =>
        typeof item === 'string' ? (
          <span class="pb-tile">{item}</span>
        ) : (
          <span class="pb-bar" style={`width: ${item}%`}></span>
        ),
      )}
    </div>
    <div class="pb-edge pb-edge--top">
      {layers.map(() => <span class="pb-layer"></span>)}
    </div>
    <div class="pb-edge pb-edge--bottom">
      {layers.map(() => <span class="pb-layer"></span>)}
    </div>
  </div>
</div>

<style>
  .progressive-blur {
    display: grid;
    /* 행을 스테이지 높이로 묶어야 안쪽 페이지가 넘치지 않고 스크롤된다 */
    grid-template-rows: minmax(0, 1fr);
    padding: 14px 14% 0;
  }
  .pb-frame {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 6px 6px 0 0;
  }
  .pb-page {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 16px;
    overflow-y: auto;
    /* 끝까지 스크롤해도 바깥 페이지로 넘어가지 않는다 */
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .pb-tile {
    display: grid;
    place-items: center;
    height: 44px;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 4px;
  }
  .pb-bar {
    height: 10px;
    background: var(--ink);
    border-radius: 2px;
  }
  .pb-edge {
    position: absolute;
    left: 0;
    right: 0;
    height: 34%;
    pointer-events: none;
  }
  .pb-edge--top {
    top: 0;
    /* 위쪽은 스크롤을 조금만 내려도 다 나타난다 */
    --edge: min(1, calc(var(--scroll, 0) * 6));
    transform: scaleY(-1);
  }
  .pb-edge--bottom {
    bottom: 0;
    --edge: min(1, calc((1 - var(--scroll, 0)) * 6));
  }
  /* 아래로 갈수록 강해지는 흐림 — 위 가장자리는 scaleY(-1)로 뒤집어 같은 층을 쓴다
     투명도는 층 자신에 준다 — 부모에 opacity 를 주면 backdrop-filter 가 뒤의 내용을 보지 못한다 */
  .pb-layer {
    position: absolute;
    inset: 0;
    opacity: var(--edge);
  }
  .pb-layer:nth-child(1) {
    -webkit-backdrop-filter: blur(1px);
    backdrop-filter: blur(1px);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 25%, #000 50%, transparent 75%);
  }
  .pb-layer:nth-child(2) {
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    mask-image: linear-gradient(to bottom, transparent 25%, #000 50%, #000 75%, transparent 100%);
  }
  .pb-layer:nth-child(3) {
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    mask-image: linear-gradient(to bottom, transparent 50%, #000 75%, #000 100%);
  }
  .pb-layer:nth-child(4) {
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    mask-image: linear-gradient(to bottom, transparent 75%, #000 100%);
  }
</style>

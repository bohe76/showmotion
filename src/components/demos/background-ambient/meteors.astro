---
// Meteors 데모 — 꼬리가 달린 작은 점 8개가 서로 다른 때에 왼쪽 위에서 오른쪽 아래로 비스듬히 떨어진다
// 떨어지는 구간은 주기의 앞쪽 일부뿐이라 나머지 시간에는 보이지 않는다 — 불규칙하게 쏟아지는 느낌
const meteors = [
  [8, -4, 0, 4.2],
  [30, -6, 1.6, 5],
  [52, -2, 3.1, 4.6],
  [70, 4, 0.7, 5.4],
  [18, 16, 2.4, 4.8],
  [44, 12, 4, 5.8],
  [-4, 30, 3.4, 5.2],
  [62, -8, 2, 6],
];
---
<div class="meteors" data-demo-root aria-hidden="true">
  {meteors.map(([x, y, delay, duration]) => (
    <span
      class="mt-meteor"
      style={`left: ${x}%; top: ${y}%; animation-delay: ${delay}s; animation-duration: ${duration}s`}
    ></span>
  ))}
</div>

<style>
  .meteors {
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }
  .mt-meteor {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent);
    opacity: 0;
    animation: meteors-fall 5s linear infinite;
  }
  /* 꼬리는 움직이는 방향의 반대쪽(회전된 +x)으로 뻗는다 */
  .mt-meteor::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18cqw;
    height: 1px;
    background: linear-gradient(to right, var(--accent), transparent);
    translate: 0 -50%;
  }
  @keyframes meteors-fall {
    0% {
      opacity: 1;
      transform: rotate(215deg) translateX(0);
    }
    40% {
      opacity: 1;
    }
    55%,
    100% {
      opacity: 0;
      transform: rotate(215deg) translateX(-90cqw);
    }
  }
</style>

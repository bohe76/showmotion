---
// Lamp Effect 데모 — .is-playing 이 붙으면 빛나는 선이 가운데에서 넓어지고, 아래로 빛 원뿔이 퍼진 뒤 제목이 떠오른다
// 클래스가 없으면 최종 상태(불이 켜진 채)로 보인다
---
<div class="lamp-effect" data-demo-root aria-hidden="true">
  <span class="lp-glow"></span>
  <span class="lp-cone"></span>
  <span class="lp-line"></span>
  <div class="lp-title">
    <span class="lp-bar"></span>
    <span class="lp-bar lp-bar--short"></span>
  </div>
</div>

<style>
  .lamp-effect {
    position: relative;
    overflow: hidden;
  }
  .lp-glow {
    position: absolute;
    top: 22%;
    left: 50%;
    width: 50%;
    height: 30%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 40%, transparent), transparent);
    translate: -50% 0;
  }
  .lp-cone {
    position: absolute;
    top: 36%;
    left: 50%;
    width: 72%;
    height: 44%;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--accent) 38%, transparent), transparent);
    clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%);
    transform-origin: top;
    translate: -50% 0;
  }
  .lp-line {
    position: absolute;
    top: 36%;
    left: 50%;
    width: 42%;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 12px var(--accent);
    translate: -50% -50%;
  }
  .lp-title {
    position: absolute;
    top: 58%;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 40%;
    translate: -50% 0;
  }
  .lp-bar {
    width: 100%;
    height: 12px;
    background: var(--ink);
    border-radius: 2px;
  }
  .lp-bar--short {
    width: 62%;
    height: 8px;
    background: var(--muted);
  }
  .lamp-effect.is-playing .lp-line {
    animation: lamp-effect-widen 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .lamp-effect.is-playing .lp-cone,
  .lamp-effect.is-playing .lp-glow {
    animation: lamp-effect-spread 1100ms cubic-bezier(0.22, 1, 0.36, 1) 150ms both;
  }
  .lamp-effect.is-playing .lp-title {
    animation: lamp-effect-rise 700ms cubic-bezier(0.22, 1, 0.36, 1) 600ms both;
  }
  @keyframes lamp-effect-widen {
    from {
      opacity: 0.4;
      transform: scaleX(0.25);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }
  @keyframes lamp-effect-spread {
    from {
      opacity: 0;
      transform: scaleX(0.4);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }
  @keyframes lamp-effect-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

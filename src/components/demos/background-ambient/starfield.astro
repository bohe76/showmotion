---
// Starfield 데모 — 크기가 다른 별 20개가 각자 다른 속도로 반짝이고, 별이 놓인 판 전체가 아주 천천히 돈다
// 판은 스테이지보다 크게 잡아 돌아도 빈 구석이 보이지 않는다
const stars = [
  [12, 18, 3, 3.2, 0], [26, 42, 2, 2.6, -1], [38, 12, 4, 4, -2], [52, 30, 2, 3, -0.5],
  [66, 16, 3, 2.8, -1.8], [80, 38, 2, 3.6, -2.4], [18, 64, 2, 3.4, -0.8], [34, 78, 3, 2.9, -1.4],
  [48, 58, 2, 3.8, -2.8], [60, 72, 4, 3.1, -0.3], [74, 60, 2, 2.7, -1.1], [88, 76, 3, 3.5, -2],
  [8, 44, 2, 3.3, -1.6], [44, 90, 2, 2.5, -0.9], [92, 12, 2, 3.7, -2.2], [58, 46, 3, 3, -1.3],
  [22, 88, 2, 2.8, -0.6], [84, 90, 2, 3.2, -1.9], [30, 54, 3, 3.4, -2.6], [70, 28, 2, 2.6, -0.2],
];
---
<div class="starfield" data-demo-root aria-hidden="true">
  <div class="sf-field">
    {stars.map(([x, y, size, duration, delay]) => (
      <span
        class="sf-star"
        style={`left: ${x}%; top: ${y}%; width: ${size}px; height: ${size}px; animation-duration: ${duration}s; animation-delay: ${delay}s`}
      ></span>
    ))}
  </div>
</div>

<style>
  .starfield {
    position: relative;
    overflow: hidden;
  }
  .sf-field {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 130%;
    aspect-ratio: 1;
    translate: -50% -50%;
    animation: starfield-drift 160s linear infinite;
  }
  .sf-star {
    position: absolute;
    background: var(--ink);
    border-radius: 50%;
    animation: starfield-twinkle 3s ease-in-out infinite;
  }
  .sf-star:nth-child(4n) {
    background: var(--accent);
  }
  @keyframes starfield-drift {
    to {
      transform: rotate(1turn);
    }
  }
  @keyframes starfield-twinkle {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.7);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }
</style>

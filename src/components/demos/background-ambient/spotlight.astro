---
// Spotlight 데모 — .is-playing 이 붙으면 왼쪽 위 구석에서 비스듬한 빛 기둥이 밀려 들어와 제목 위에 자리 잡으며 밝아진다
// 클래스가 없으면 최종 상태(빛이 자리 잡은 채)로 보인다
---
<div class="spotlight" data-demo-root aria-hidden="true">
  <span class="sl-beam"></span>
  <div class="sl-title">
    <span class="sl-bar"></span>
    <span class="sl-bar sl-bar--short"></span>
  </div>
</div>

<style>
  .spotlight {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .sl-beam {
    position: absolute;
    top: -8%;
    left: -12%;
    width: 120%;
    height: 44%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 42%, transparent), transparent);
    transform-origin: 0 50%;
    rotate: 30deg;
  }
  .sl-title {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 42%;
  }
  .sl-bar {
    width: 100%;
    height: 12px;
    background: var(--ink);
    border-radius: 2px;
  }
  .sl-bar--short {
    width: 62%;
    height: 8px;
    background: var(--muted);
  }
  .spotlight.is-playing .sl-beam {
    animation: spotlight-sweep 1400ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes spotlight-sweep {
    from {
      opacity: 0;
      transform: translate(-45%, -30%) scale(0.6);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
  }
</style>

---
// Mesh Gradient 데모 — 가장자리가 투명한 둥근 색 덩어리 4개가 서로 겹쳐 섞이며 각자 다른 궤도로 천천히 떠돈다
// 덩어리는 radial-gradient 로 흐리게 두고 transform 으로만 옮긴다
const blobs = [
  ['accent', 8, 6, 22, 0],
  ['highlight', 44, -8, 18, -6],
  ['demo-muted', 52, 40, 26, -12],
  ['accent', -6, 44, 20, -4],
] as const;
---
<div class="mesh-gradient" data-demo-root aria-hidden="true">
  {blobs.map(([color, x, y, duration, delay]) => (
    <span
      class="mg-blob"
      style={`--c: var(--${color}); left: ${x}%; top: ${y}%; animation-duration: ${duration}s; animation-delay: ${delay}s`}
    ></span>
  ))}
</div>

<style>
  .mesh-gradient {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }
  .mg-blob {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, var(--c), transparent);
    animation: mesh-gradient-drift 20s ease-in-out infinite;
  }
  .mg-blob:nth-child(2n) {
    animation-direction: reverse;
  }
  @keyframes mesh-gradient-drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(18%, 14%) scale(1.15);
    }
    66% {
      transform: translate(-14%, 10%) scale(0.9);
    }
  }
</style>

---
// Determinate Progress Bar 데모 — .is-playing 이 붙으면 막대가 고르지 않은 걸음으로 72% 까지 차고 숫자도 함께 오른다, 없으면 72%
// 진행도 하나를 루트의 등록 속성으로 움직인다 — 막대 폭은 --determinate-progress-bar-p(number), 숫자는 같은 값의 정수판 -n(counter)
---
<div class="determinate-progress-bar" data-demo-root aria-hidden="true">
  <div class="dpb-panel">
    <div class="dpb-head">
      <span class="dpb-label"></span>
      <span class="dpb-value"></span>
    </div>
    <div class="dpb-track">
      <div class="dpb-fill"></div>
    </div>
  </div>
</div>

<style>
  @property --determinate-progress-bar-p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  @property --determinate-progress-bar-n {
    syntax: '<integer>';
    inherits: true;
    initial-value: 0;
  }
  .determinate-progress-bar {
    --determinate-progress-bar-p: 72;
    --determinate-progress-bar-n: 72;
    display: grid;
    place-items: center;
  }
  .dpb-panel {
    display: grid;
    gap: 12px;
    width: 64%;
  }
  .dpb-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .dpb-label {
    width: 40%;
    height: 8px;
    background: var(--demo-muted);
    border-radius: 2px;
  }
  .dpb-value {
    min-width: 4ch;
    text-align: right;
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    counter-reset: determinate-progress-bar var(--determinate-progress-bar-n);
  }
  .dpb-value::after {
    content: counter(determinate-progress-bar) '%';
  }
  .dpb-track {
    height: 10px;
    overflow: hidden;
    background: var(--line);
    border-radius: 999px;
  }
  .dpb-fill {
    width: calc(var(--determinate-progress-bar-p) * 1%);
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }
  .determinate-progress-bar.is-playing {
    animation: determinate-progress-bar-fill 2200ms ease-in-out both;
  }
  /* 실제 작업처럼 빨라졌다 느려졌다 하며 찬다 */
  @keyframes determinate-progress-bar-fill {
    0% {
      --determinate-progress-bar-p: 0;
      --determinate-progress-bar-n: 0;
    }
    30% {
      --determinate-progress-bar-p: 24;
      --determinate-progress-bar-n: 24;
    }
    55% {
      --determinate-progress-bar-p: 38;
      --determinate-progress-bar-n: 38;
    }
  }
</style>

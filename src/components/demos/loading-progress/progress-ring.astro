---
// Progress Ring 데모 — .is-playing 이 붙으면 고리의 호가 12시 방향부터 65% 까지 자라고 가운데 숫자가 함께 오른다, 없으면 65%
// pathLength 100 이라 dashoffset 이 곧 "남은 %" 다 (100 → 35). 숫자는 정수로 등록한 --progress-ring-n 을 같은 시간·곡선으로 움직여 맞춘다
---
<div class="progress-ring" data-demo-root aria-hidden="true">
  <div class="pr-ring">
    <svg class="pr-svg" viewBox="0 0 100 100">
      <circle class="pr-track" cx="50" cy="50" r="40" />
      <circle class="pr-arc" cx="50" cy="50" r="40" pathLength="100" transform="rotate(-90 50 50)" />
    </svg>
    <span class="pr-value"></span>
  </div>
</div>

<style>
  @property --progress-ring-n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  .progress-ring {
    display: grid;
    place-items: center;
    container-type: inline-size;
  }
  .pr-ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 34%;
    aspect-ratio: 1;
  }
  .pr-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pr-track,
  .pr-arc {
    fill: none;
    stroke-width: 8;
  }
  .pr-track {
    stroke: var(--line);
  }
  .pr-arc {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 35;
  }
  .pr-value {
    position: relative;
    font-size: clamp(1.1rem, 6cqi, 2.2rem);
    font-weight: 800;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    --progress-ring-n: 65;
    counter-reset: progress-ring var(--progress-ring-n);
  }
  .pr-value::after {
    content: counter(progress-ring) '%';
  }
  .progress-ring.is-playing .pr-arc {
    animation: progress-ring-arc 1400ms cubic-bezier(0.33, 1, 0.68, 1) both;
  }
  .progress-ring.is-playing .pr-value {
    animation: progress-ring-count 1400ms cubic-bezier(0.33, 1, 0.68, 1) both;
  }
  @keyframes progress-ring-arc {
    from {
      stroke-dashoffset: 100;
    }
  }
  @keyframes progress-ring-count {
    from {
      --progress-ring-n: 0;
    }
  }
</style>

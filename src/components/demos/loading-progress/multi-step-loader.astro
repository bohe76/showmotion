---
// Multi-Step Loader 데모 — .is-playing 이 붙으면 단계 네 줄이 위에서부터 하나씩 밝혀지고 체크된다, 없으면 모두 체크된 상태
// 단계마다 700ms — 줄이 밝아지는 것(row)과 체크가 튀어나오는 것(check)을 같은 --i 지연으로 맞춘다
import Check from '@lucide/astro/icons/check';

const steps = [68, 54, 76, 48];
---
<div class="multi-step-loader" data-demo-root aria-hidden="true">
  <ul class="msl-list">
    {steps.map((width, i) => (
      <li class="msl-step" style={`--i: ${i}`}>
        <span class="msl-mark">
          <span class="msl-done"><Check class="msl-tick" size={14} stroke-width={3} aria-hidden="true" /></span>
        </span>
        <span class="msl-bar" style={`width: ${width}%`}></span>
      </li>
    ))}
  </ul>
</div>

<style>
  .multi-step-loader {
    display: grid;
    place-items: center;
  }
  .msl-list {
    display: grid;
    gap: 4px;
    width: 60%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .msl-step {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 4px;
  }
  .msl-mark {
    flex: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--demo-muted);
    border-radius: 50%;
  }
  .msl-done {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin: -2px;
    background: var(--accent);
    border-radius: 50%;
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 */
  .msl-done :global(.msl-tick) {
    color: var(--on-accent);
  }
  .msl-bar {
    height: 8px;
    background: var(--ink);
    border-radius: 2px;
  }
  .multi-step-loader.is-playing .msl-step {
    animation: multi-step-loader-row 700ms ease-out both;
    animation-delay: calc(var(--i) * 700ms);
  }
  .multi-step-loader.is-playing .msl-done {
    animation: multi-step-loader-check 300ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i) * 700ms + 450ms);
  }
  /* 차례가 오기 전에는 흐리게(both 로 0% 상태를 지연 동안 유지), 차례일 때 배경이 잠깐 밝아진다 */
  @keyframes multi-step-loader-row {
    0% {
      opacity: 0.4;
      background: transparent;
    }
    25% {
      opacity: 1;
      background: var(--highlight);
    }
    100% {
      opacity: 1;
      background: transparent;
    }
  }
  @keyframes multi-step-loader-check {
    from {
      opacity: 0;
      transform: scale(0);
    }
  }
</style>

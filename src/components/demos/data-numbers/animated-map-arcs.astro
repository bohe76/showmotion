---
// Animated Map Arcs 데모 — 점 무늬 지도 위에서 도시 사이 호가 그려졌다 지워지고, 도착한 도시에서 원이 퍼진다
// 대륙은 타원 몇 개로 자른 점 무늬로만 흉내 낸다 — 실제 지도가 아니다
// 호: pathLength 100 + dasharray 100 100 이라 dashoffset 100(안 보임) → 0(다 그려짐) → -100(앞부터 지워짐)으로 한 바퀴가 이어진다
const cities = [
  [95, 100],
  [205, 100],
  [300, 95],
  [130, 200],
  [320, 205],
];
const arcs = [
  { d: 'M 95 100 Q 150 40 205 100', to: [205, 100] },
  { d: 'M 205 100 Q 252 38 300 95', to: [300, 95] },
  { d: 'M 130 200 Q 225 125 320 205', to: [320, 205] },
];
---
<div class="animated-map-arcs" data-demo-root aria-hidden="true">
  <svg class="ama-svg" viewBox="0 0 400 300">
    <defs>
      <pattern id="animated-map-arcs-dots" width="9" height="9" patternUnits="userSpaceOnUse">
        <circle class="ama-grid-dot" cx="4.5" cy="4.5" r="1.6" />
      </pattern>
      <clipPath id="animated-map-arcs-land">
        <ellipse cx="95" cy="105" rx="62" ry="45" />
        <ellipse cx="132" cy="205" rx="28" ry="50" />
        <ellipse cx="205" cy="105" rx="30" ry="32" />
        <ellipse cx="215" cy="190" rx="32" ry="48" />
        <ellipse cx="295" cy="105" rx="78" ry="46" />
        <ellipse cx="322" cy="208" rx="32" ry="20" />
      </clipPath>
    </defs>
    <rect width="400" height="300" fill="url(#animated-map-arcs-dots)" clip-path="url(#animated-map-arcs-land)" />
    {arcs.map((arc, i) => (
      <>
        <path class="ama-arc" pathLength="100" d={arc.d} style={`--i: ${i}`} />
        <circle class="ama-pulse" cx={arc.to[0]} cy={arc.to[1]} r="5" style={`--i: ${i}`} />
      </>
    ))}
    {cities.map(([x, y]) => <circle class="ama-city" cx={x} cy={y} r="4.5" />)}
  </svg>
</div>

<style>
  .animated-map-arcs {
    display: grid;
    place-items: center;
  }
  .ama-svg {
    width: 100%;
    height: 100%;
  }
  .ama-grid-dot {
    fill: var(--demo-muted);
  }
  .ama-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100 100;
    animation: animated-map-arcs-draw 4.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.5s);
  }
  .ama-city {
    fill: var(--ink);
  }
  .ama-pulse {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: animated-map-arcs-pulse 4.5s ease-out infinite;
    animation-delay: calc(var(--i) * -1.5s);
  }
  @keyframes animated-map-arcs-draw {
    0% {
      stroke-dashoffset: 100;
    }
    40%,
    60% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -100;
    }
  }
  /* 호가 도착하는 순간(40%)에 맞춰 도착 도시에서 원이 퍼진다 */
  @keyframes animated-map-arcs-pulse {
    0%,
    38% {
      opacity: 0;
      transform: scale(1);
    }
    40% {
      opacity: 1;
      transform: scale(1);
    }
    75%,
    100% {
      opacity: 0;
      transform: scale(3.5);
    }
  }
</style>

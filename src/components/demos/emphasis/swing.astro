---
// Swing 데모 — .is-playing 이 붙으면 걸린 간판이 윗변을 축으로 흔들리다 잦아든다, 없으면 제자리(최종 상태)
---
<div class="swing" data-demo-root aria-hidden="true">
  <div class="sw-rail"></div>
  <div class="sw-hang">
    <div class="sw-strings"></div>
    <div class="sw-sign">A</div>
  </div>
</div>

<style>
  .swing {
    display: grid;
    align-content: center;
    justify-items: center;
  }
  .sw-rail {
    width: 50%;
    height: 4px;
    border-radius: 2px;
    background: var(--ink);
  }
  .sw-hang {
    display: grid;
    justify-items: center;
    width: clamp(88px, 32%, 180px);
    /* 레일에 걸린 윗변 가운데가 회전축 */
    transform-origin: top center;
  }
  .sw-strings {
    width: 60%;
    height: 22px;
    border-inline: 2px solid var(--muted);
  }
  .sw-sign {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .swing.is-playing .sw-hang {
    animation: swing-sway 1.1s ease-in-out both;
  }
  @keyframes swing-sway {
    0%,
    100% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(15deg);
    }
    40% {
      transform: rotate(-10deg);
    }
    60% {
      transform: rotate(5deg);
    }
    80% {
      transform: rotate(-5deg);
    }
  }
</style>

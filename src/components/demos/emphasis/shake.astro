---
// Shake 데모 — .is-playing 이 붙으면 오류 난 입력 칸이 좌우로 빠르게 떨린다, 없으면 제자리(최종 상태)
---
<div class="shake" data-demo-root aria-hidden="true">
  <div class="sk-form">
    <div class="sk-label"></div>
    <div class="sk-field"><span class="sk-value"></span></div>
    <div class="sk-error"></div>
  </div>
</div>

<style>
  .shake {
    display: grid;
    place-items: center;
  }
  .sk-form {
    display: grid;
    gap: 8px;
    width: 58%;
  }
  .sk-label {
    width: 30%;
    height: 8px;
    border-radius: 2px;
    background: var(--ink);
  }
  .sk-field {
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 12px;
    background: var(--surface);
    border: 2px solid var(--accent);
    border-radius: 6px;
  }
  .sk-value {
    width: 46%;
    height: 8px;
    border-radius: 2px;
    background: var(--demo-muted);
  }
  .sk-error {
    width: 52%;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }
  .shake.is-playing .sk-field {
    animation: shake-x 0.6s linear both;
  }
  @keyframes shake-x {
    0%,
    100% {
      transform: translateX(0);
    }
    12%,
    37%,
    62% {
      transform: translateX(-8px);
    }
    25%,
    50%,
    75% {
      transform: translateX(8px);
    }
    87% {
      transform: translateX(-3px);
    }
  }
</style>

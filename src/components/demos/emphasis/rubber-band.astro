---
// Rubber Band 데모 — .is-playing 이 붙으면 블록이 가로로 늘고 세로로 눌리며 고무줄처럼 튕긴다, 없으면 제자리(최종 상태)
---
<div class="rubber-band" data-demo-root aria-hidden="true">
  <div class="rb-box">A</div>
</div>

<style>
  .rubber-band {
    display: grid;
    place-items: center;
  }
  .rb-box {
    display: grid;
    place-items: center;
    width: clamp(72px, 30%, 160px);
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .rubber-band.is-playing .rb-box {
    animation: rubber-band-stretch 1s both;
  }
  @keyframes rubber-band-stretch {
    0%,
    100% {
      transform: scale(1, 1);
    }
    30% {
      transform: scale(1.25, 0.75);
    }
    40% {
      transform: scale(0.75, 1.25);
    }
    50% {
      transform: scale(1.15, 0.85);
    }
    65% {
      transform: scale(0.95, 1.05);
    }
    75% {
      transform: scale(1.05, 0.95);
    }
  }
</style>

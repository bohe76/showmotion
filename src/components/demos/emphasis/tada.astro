---
// Tada 데모 — .is-playing 이 붙으면 블록이 살짝 줄었다가 커진 채 좌우로 흔들리고 원래 크기로 돌아온다, 없으면 제자리(최종 상태)
---
<div class="tada" data-demo-root aria-hidden="true">
  <div class="td-box">A</div>
</div>

<style>
  .tada {
    display: grid;
    place-items: center;
  }
  .td-box {
    display: grid;
    place-items: center;
    width: clamp(72px, 30%, 160px);
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
  }
  .tada.is-playing .td-box {
    animation: tada-flourish 1s both;
  }
  @keyframes tada-flourish {
    0%,
    100% {
      transform: scale(1) rotate(0);
    }
    10%,
    20% {
      transform: scale(0.9) rotate(-3deg);
    }
    30%,
    50%,
    70%,
    90% {
      transform: scale(1.1) rotate(3deg);
    }
    40%,
    60%,
    80% {
      transform: scale(1.1) rotate(-3deg);
    }
  }
</style>

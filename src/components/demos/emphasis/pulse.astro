---
// Pulse 데모 — 블록이 느리고 일정하게 살짝 커졌다 줄기를 반복한다
---
<div class="pulse" data-demo-root aria-hidden="true">
  <div class="pl-box">A</div>
</div>

<style>
  .pulse {
    display: grid;
    place-items: center;
  }
  .pl-box {
    display: grid;
    place-items: center;
    width: clamp(72px, 30%, 160px);
    aspect-ratio: 16 / 10;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 6px;
    animation: pulse-breathe 2s ease-in-out infinite;
  }
  @keyframes pulse-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }
</style>

---
import type { AnyMotion } from '../data/types';
import { ui, type Locale } from '../i18n/locales';
import { demoFor } from './demos/registry';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import LoaderCircle from '@lucide/astro/icons/loader-circle';
import Box from '@lucide/astro/icons/box';

// 데모 스테이지 — 카드와 상세 페이지가 함께 쓴다. 재생 제어는 src/scripts/gallery.ts 가 data-demo 값으로 나눠 붙인다
interface Props {
  motion: AnyMotion;
  locale: Locale;
  // 제어 버튼이 어느 모션의 버튼인지 스크린리더에 알리는 이름 요소 id
  nameId: string;
  size?: 'card' | 'large';
}

const { motion, locale, nameId, size = 'card' } = Astro.props;
const t = ui[locale];
const Demo = demoFor(motion);
const kind = motion.demo;
// once·click 은 다시 보기(click 은 스테이지를 누른 것과 같다), loop 는 일시정지/재생, play 는 재생(눌러야 움직인다). 나머지는 직접 조작이라 버튼이 없다
const control = kind === 'once' || kind === 'click' ? 'replay' : kind === 'loop' ? 'toggle' : kind === 'play' ? 'play' : null;
// 퇴장(exit) 모션은 재생이 끝나면 사라진 채로 남으므로, 잠시 뒤 처음 모습으로 다시 나타나게 한다 (gallery.ts)
const returns = kind === 'once' && motion.trigger.startsWith('exit');
// 모션 그래픽의 3D 무대: gallery.ts 가 이 값을 보고 three.js 를 불러온다
// 상세 페이지의 큰 데모에도 카드에도 붙인다 — 화면 가까이에 온 스테이지만 3D 로 바꿔 끼운다(2026-10-02 사용자 결정)
const mg3d = 'stage3d' in motion && motion.stage3d ? motion.id : undefined;
const hint = kind === 'hover' || kind === 'click' || kind === 'drag' || kind === 'scroll' || kind === 'cursor' ? t.hint[kind] : null;
---
<div class:list={['stage', `stage--${size}`]} data-demo={kind} data-return={returns ? '' : undefined} data-mg3d={mg3d}>
  <Demo />
  <!-- 3D 무대를 기다리는 동안의 표시 — 처음 불러올 때도, 내려 두었다가 다시 올릴 때도 보인다. 데모처럼 장식이라 스크린리더에는 알리지 않는다 -->
  {mg3d && (
    <span class="stage-loading" aria-hidden="true">
      <LoaderCircle class="icon" size={size === 'large' ? 40 : 28} aria-hidden="true" />
    </span>
  )}
  <!-- 목록 카드의 3D 표시 — 이 카드의 데모가 3D 무대라는 것만 알린다(누르는 것이 아니다). 이름은 마우스를 올리면 뜨는 툴팁으로 전한다 -->
  <!-- 스테이지가 넘치는 것을 잘라 내므로 툴팁은 아이콘 아래에, 왼쪽에 맞춰 띄운다. 데모처럼 스크린리더에는 알리지 않는다 -->
  {mg3d && size === 'card' && (
    <span class="stage-3d" data-tooltip={t.mg.stage3d} data-tooltip-side="bottom" data-tooltip-align="start" aria-hidden="true">
      <Box class="icon" size={16} aria-hidden="true" />
    </span>
  )}
  <!-- 3D 무대는 JS 로 올라온다 — JS 가 꺼져 있으면 숨겨 둔 2D 장면을 그대로 보여 주고, 3D 표시도 감춘다 -->
  {mg3d && (
    <noscript>
      <style is:inline>
        .stage[data-mg3d] .mgf-screen > * { visibility: visible !important; }
        .stage-loading { display: none !important; }
        .stage-3d { display: none !important; }
      </style>
    </noscript>
  )}
  {hint && <p class="stage-hint" aria-hidden="true">{hint}</p>}
  <!-- JS 로 동작하는 버튼은 hidden 으로 렌더하고 initGallery 가 노출한다 -->
  <!-- 아이콘만 보이고, 이름은 aria-label(스크린리더)과 data-tooltip(마우스·키보드 포커스 툴팁)로 전한다 -->
  {control === 'replay' && (
    <button
      type="button"
      class="stage-control"
      hidden
      aria-label={t.replay}
      aria-describedby={nameId}
      data-tooltip={t.replay}
      data-control
    >
      <RotateCcw class="icon" size={16} aria-hidden="true" />
    </button>
  )}
  {control === 'play' && (
    <button
      type="button"
      class="stage-control"
      hidden
      aria-label={t.play}
      aria-describedby={nameId}
      data-tooltip={t.play}
      data-control
    >
      <Play class="icon" size={16} aria-hidden="true" />
    </button>
  )}
  {control === 'toggle' && (
    <button
      type="button"
      class="stage-control"
      hidden
      aria-label={t.pause}
      aria-describedby={nameId}
      data-tooltip={t.pause}
      data-control
      data-state="playing"
      data-label-pause={t.pause}
      data-label-play={t.play}
    >
      <Pause class="icon icon-pause" size={16} aria-hidden="true" />
      <Play class="icon icon-play" size={16} aria-hidden="true" />
    </button>
  )}
</div>

<style>
  .stage {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--stage);
    /* 전체 페이지에는 데모가 수백 개다 — 화면 밖 스테이지는 그리지 않는다.
       카드(subgrid)에 걸면 행 높이가 무너지므로 크기가 비율로 정해진 스테이지에만 건다 */
    content-visibility: auto;
  }
  .stage--card {
    border-bottom: 1px solid var(--line);
  }
  .stage--large {
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  /* 데모가 스테이지를 채우도록 루트를 늘린다 */
  .stage > :global([data-demo-root]) {
    width: 100%;
    height: 100%;
  }
  /* 3D 무대가 있는 데모: three.js 캔버스가 올라올 때까지 2D 장면을 숨긴다 — 안 그러면 2D 가 잠깐 보였다가 3D 로 바뀐다
     캔버스는 그대로 보인다. 못 올리면 gallery.ts 가 data-mg3d-off 를 붙여 2D 를 되살린다 */
  .stage[data-mg3d]:not([data-mg3d-off]) :global(.mgf-screen > :not(canvas)) {
    visibility: hidden;
  }
  /* 그동안 화면 한가운데에 도는 표시를 둔다(2026-10-02 사용자 지시 — UI 는 움직이지 않는다는 규칙의 예외)
     화면은 MgFrame 의 .mgf-screen 이고, 그 아래 44px 은 시간 막대 줄이다 */
  .stage-loading {
    position: absolute;
    top: calc((100% - 44px) / 2);
    left: 50%;
    display: grid;
    color: var(--accent);
    translate: -50% -50%;
    animation: stage-loading-spin 900ms linear infinite;
  }
  /* 3D 가 올라와 있거나(on) 2D 로 보여 주는 동안(off)에는 표시가 없다 — 둘 다 아닌 때가 기다리는 때다 (gallery.ts) */
  .stage[data-mg3d-on] .stage-loading,
  .stage[data-mg3d-off] .stage-loading {
    display: none;
  }
  @keyframes stage-loading-spin {
    to {
      rotate: 360deg;
    }
  }
  /* 3D 표시는 왼쪽 위 — 스테이지 가장자리와 화면(.mgf-screen) 사이의 여백에 들어가 데모를 가리지 않는다. 오른쪽은 누르는 것(재생 버튼)의 자리라 왼쪽에 둔다
     테두리·배경 없이 아이콘만 둔다(2026-10-03 사용자 결정 — 카드에 배지를 달지 않는다는 규칙의 예외)
     자리는 카드의 둥근 모서리(반지름 8px)와 화면의 둥근 모서리(4px) 사이의 한가운데다 — 직선 테두리 기준의 가운데(6px)는 바깥 모서리에 붙어 보인다(2026-10-03 사용자 결정)
     카드 폭이 달라져도 가운데에 있도록 여백에서 계산한다(사용자 지시) — 여백은 MgFrame 의 화면 크기에서 나온다(폭 84%, 16:9, 시간 막대 줄 44px. 그쪽을 바꾸면 여기도 고친다)
       가로 여백 = 스테이지 폭의 8% · 세로 여백 = 스테이지 높이의 18.5% − 22px
       자리 = 여백의 절반 − 아이콘의 절반(8px) + 둥근 모서리 보정(1.6px — 두 모서리가 깎인 만큼의 평균)
     round() 는 반 픽셀에 걸려 선이 흐려지지 않게 한다. 모르는 브라우저는 앞의 값을 쓴다 */
  .stage-3d {
    position: absolute;
    top: calc(9.25% - 17.4px);
    top: round(calc(9.25% - 17.4px), 1px);
    left: calc(4% - 6.4px);
    left: round(calc(4% - 6.4px), 1px);
    z-index: 2;
    display: grid;
    color: var(--muted);
  }
  /* 2D 로 보여 주는 동안에는 표시도 감춘다 — 3D 가 아닌데 남아 있으면 틀린 정보다 */
  .stage[data-mg3d-off] .stage-3d {
    display: none;
  }
  /* 안내는 왼쪽 아래 — 데모 내용을 덜 가리고, 오른쪽 아래의 제어 버튼과 한 줄에 선다 */
  .stage-hint {
    position: absolute;
    bottom: 10px;
    left: 10px;
    /* 스테이지 전체를 덮는 데모(라이트박스·페이지 전환)보다 위에 둔다 */
    z-index: 2;
    max-width: calc(100% - 64px);
    margin: 0;
    padding: 3px 8px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    pointer-events: none;
  }
  .stage-control {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 150ms ease-out;
  }
  .stage-control:hover {
    border-color: var(--ink);
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다. loop 는 상태(data-state)에 맞는 아이콘만 보인다 */
  .stage-control[data-state='playing'] :global(.icon-play),
  .stage-control[data-state='paused'] :global(.icon-pause) {
    display: none;
  }
  [hidden] {
    display: none !important;
  }
</style>

---
import SiteLayout from './SiteLayout.astro';
import MotionCard from './MotionCard.astro';
import { motions, motionsIn } from '../data/motions';
import { categories, categoryName, type CategoryId } from '../data/categories';
import { categorySubpath, pageHref, siteName, ui, type Locale } from '../i18n/locales';
import { splitPlaceholders } from '../i18n/placeholder';
import { categoryData, homeData } from '../layouts/structured-data';

// 목록 페이지 — 전체(카테고리 없음) 또는 카테고리 하나
interface Props {
  locale: Locale;
  category?: CategoryId;
}

const { locale, category } = Astro.props;
const t = ui[locale];
const note = splitPlaceholders(t.promptNote);
const list = category ? motionsIn(category) : motions;
const name = category ? categoryName(category) : null;
const title = name ? `${name} — ${siteName}` : t.metaTitle;
const description = name ? t.categoryDescription(name, list.length) : t.metaDescription;
const jsonLd = category ? categoryData(Astro.site!, locale, category) : homeData(Astro.site!, locale);
---
<SiteLayout
  locale={locale}
  subpath={category ? categorySubpath(category) : ''}
  title={title}
  description={description}
  current={category ?? 'all'}
  liveSearch={!category}
  jsonLd={jsonLd}
>
  <section class="intro">
    {name ? <h1 lang="en">{name}</h1> : <h1>{t.tagline}</h1>}
    {!name && <p>{t.intro}</p>}
    <p class="meta">
      <span class="count" data-list-count>{t.count(list.length)}</span>
      <span>{note.map((s) => (s.placeholder ? <mark class="ph">{s.text}</mark> : s.text))}</span>
    </p>
  </section>

  {!category && (
    <div class="search-result" data-search-result hidden>
      <p class="search-status" role="status" aria-live="polite" data-search-status></p>
      <p class="search-similar" data-search-similar hidden></p>
    </div>
  )}

  {category ? (
    <div class="grid" data-grid>
      {list.map((motion) => <MotionCard motion={motion} locale={locale} />)}
    </div>
  ) : (
    <>
      <!-- 카테고리 레일: 넓은 화면에서 오른쪽 여백 가운데에 눈금 15개. 올리면(포커스하면) 이름이 눈금 왼쪽에 한꺼번에 나온다.
           카드보다 앞에 둬서 키보드로도 카드 259개를 지나기 전에 닿는다 -->
      <nav class="rail" aria-label={t.sectionsLabel} data-rail>
        <ol>
          {categories.map((c) => (
            <li>
              <a href={`#${c.id}`} data-rail-link>
                <span class="rail-name" lang="en">{c.name}</span>
                <span class="rail-tick" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <!-- 전체 페이지는 카테고리별 섹션으로 나눈다. 제목은 카테고리 페이지 링크, 옆 숫자는 검색하면 남은 개수로 바뀐다 -->
      <div class="sections" data-grid>
        {categories.map((c) => {
          const items = motionsIn(c.id);
          return (
            <section class="section" id={c.id} data-section aria-labelledby={`section-${c.id}`}>
              <h2 class="section-title" id={`section-${c.id}`}>
                <a href={pageHref(locale, categorySubpath(c.id))} lang="en">{c.name}</a>
                <span class="section-count" data-section-count>{items.length}</span>
              </h2>
              <div class="grid">
                {items.map((motion) => <MotionCard motion={motion} locale={locale} headingLevel={3} />)}
              </div>
            </section>
          );
        })}
      </div>
    </>
  )}
</SiteLayout>

<style>
  .intro {
    padding: 36px 0 28px;
  }
  /* 긴 제목만 읽기 좋은 폭으로 묶는다. 소개 문단·개수·안내 줄(.meta)은 전체 폭을 써서 데스크톱에서 한 줄로 끝난다 */
  .intro h1 {
    max-width: 720px;
  }
  .intro h1 {
    margin: 0 0 14px;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .intro p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .intro .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .intro .count {
    font-weight: 600;
    color: var(--ink);
  }
  .search-result {
    margin: -8px 0 20px;
  }
  .search-result p {
    margin: 0;
  }
  .search-status {
    font-weight: 600;
  }
  .search-similar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 8px !important;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .search-similar :global(button) {
    padding: 2px 0;
    font: inherit;
    font-weight: 600;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding-bottom: 64px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* 섹션 모양은 상세 페이지의 관련 모션 묶음과 같다 — 위 선 + 제목 + 그리드 */
  .sections {
    padding-bottom: 64px;
  }
  .section {
    padding-top: 28px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 16px;
  }
  .section + .section {
    margin-top: 48px;
  }
  .section .grid {
    margin-top: 16px;
    padding-bottom: 0;
  }
  .section-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-size: 1.25rem;
  }
  .section-title a {
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .section-title a:hover,
  .section-title a:focus-visible {
    text-decoration: underline;
  }
  .section-count {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }

  /* 카테고리 레일 — 화면 오른쪽 끝에서 24px 안쪽, 맨 위·아래 버튼과 같은 축. 눈금이 카드에 닿지 않는 폭(1280px 이상)·높이에서만 보인다.
     평소엔 눈금 칸(40px)만 마우스를 받는다: 숨은 이름 자리가 카드 위를 덮어 클릭을 가로채지 않게 */
  .rail {
    display: none;
  }
  @media (min-width: 1280px) and (min-height: 640px) {
    .rail {
      display: block;
      position: fixed;
      top: 50%;
      right: 24px;
      z-index: 29;
      transform: translateY(-50%);
      pointer-events: none;
    }
  }
  .rail ol {
    margin: 0;
    padding: 6px 0;
    list-style: none;
  }
  /* 키보드 포커스만 이름을 연다 — :focus-within 이면 마우스로 누른 뒤 포커스가 남아 이름이 계속 떠 있다 */
  .rail:hover ol,
  .rail:has(:focus-visible) ol {
    pointer-events: auto;
  }
  /* --s: 맥 Dock 처럼 포인터(키보드 포커스)에 가까울수록 커지는 배율(최대 1.6) — site.ts setupRail 이 정한다 */
  .rail a {
    --s: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 20px;
    padding-left: 14px;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color 150ms ease-out;
  }
  .rail a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  /* 사이트 UI 에서 유일하게 움직이는 곳: 이름이 오른쪽에서 8px 들어오며 나타나고, 포커스 근처가 커진다(AGENTS.md 규칙 5 예외) */
  .rail-name {
    opacity: 0;
    transform: translateX(8px) scale(var(--s));
    transform-origin: right center;
    transition:
      opacity 150ms ease-out,
      transform 150ms ease-out;
  }
  .rail-tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 100%;
    pointer-events: auto;
  }
  .rail-tick::before {
    content: '';
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: var(--muted);
    opacity: 0.5;
    transform: scaleX(var(--s));
    transition:
      background-color 150ms ease-out,
      opacity 150ms ease-out,
      transform 150ms ease-out;
  }
  .rail:hover .rail-name,
  .rail:has(:focus-visible) .rail-name {
    opacity: 1;
    transform: translateX(0) scale(var(--s));
  }
  /* 좁은 여백(1.6배 이름이 카드에 닿음, site.ts 가 is-compact 를 붙인다): 다른 이름은 숨기고 가리킨 이름만 배지로 1.6배.
     숨은 이름 자리는 마우스를 받지 않는다 — 카드 클릭을 가로채지 않게 */
  .rail.is-compact ol {
    pointer-events: none;
  }
  .rail.is-compact .rail-name {
    opacity: 0 !important;
  }
  .rail.is-compact a:hover .rail-name,
  .rail.is-compact a:focus-visible .rail-name {
    opacity: 1 !important;
    margin-right: 4px;
    padding: 3px 8px;
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: 999px;
    transform: translateX(0) scale(1.6);
  }
  .rail a:hover,
  .rail a:focus-visible {
    color: var(--ink);
  }
  .rail a:hover .rail-tick::before,
  .rail a:focus-visible .rail-tick::before {
    background: var(--ink);
    opacity: 1;
  }
  .rail a[aria-current='true'] {
    color: var(--accent);
  }
  .rail a[aria-current='true'] .rail-tick::before {
    width: 24px;
    background: var(--accent);
    opacity: 1;
  }
  [hidden] {
    display: none !important;
  }
</style>

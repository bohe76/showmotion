---
import SiteLayout from './SiteLayout.astro';
import MotionCard from './MotionCard.astro';
import { motions, motionsIn } from '../data/motions';
import { categoryName, type CategoryId } from '../data/categories';
import { categorySubpath, siteName, ui, type Locale } from '../i18n/locales';
import { splitPlaceholders } from '../i18n/placeholder';
import { categoryData, homeData } from '../layouts/structured-data';

// 목록 페이지 — 전체(카테고리 없음) 또는 카테고리 하나
interface Props {
  locale: Locale;
  category?: CategoryId;
}

const { locale, category } = Astro.props;
const t = ui[locale];
const note = splitPlaceholders(t.promptNote);
const list = category ? motionsIn(category) : motions;
const name = category ? categoryName(category) : null;
const title = name ? `${name} — ${siteName}` : t.metaTitle;
const description = name ? t.categoryDescription(name, list.length) : t.metaDescription;
const jsonLd = category ? categoryData(Astro.site!, locale, category) : homeData(Astro.site!, locale);
---
<SiteLayout
  locale={locale}
  subpath={category ? categorySubpath(category) : ''}
  title={title}
  description={description}
  current={category ?? 'all'}
  liveSearch={!category}
  jsonLd={jsonLd}
>
  <section class="intro">
    {name ? <h1 lang="en">{name}</h1> : <h1>{t.tagline}</h1>}
    {!name && <p>{t.intro}</p>}
    <p class="meta">
      <span class="count" data-list-count>{t.count(list.length)}</span>
      <span>{note.map((s) => (s.placeholder ? <mark class="ph">{s.text}</mark> : s.text))}</span>
    </p>
  </section>

  {!category && (
    <div class="search-result" data-search-result hidden>
      <p class="search-status" role="status" aria-live="polite" data-search-status></p>
      <p class="search-similar" data-search-similar hidden></p>
    </div>
  )}

  <div class="grid" data-grid>
    {list.map((motion) => <MotionCard motion={motion} locale={locale} />)}
  </div>
</SiteLayout>

<style>
  .intro {
    padding: 36px 0 28px;
  }
  /* 긴 제목만 읽기 좋은 폭으로 묶는다. 소개 문단·개수·안내 줄(.meta)은 전체 폭을 써서 데스크톱에서 한 줄로 끝난다 */
  .intro h1 {
    max-width: 720px;
  }
  .intro h1 {
    margin: 0 0 14px;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .intro p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .intro .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .intro .count {
    font-weight: 600;
    color: var(--ink);
  }
  .search-result {
    margin: -8px 0 20px;
  }
  .search-result p {
    margin: 0;
  }
  .search-status {
    font-weight: 600;
  }
  .search-similar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 8px !important;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .search-similar :global(button) {
    padding: 2px 0;
    font: inherit;
    font-weight: 600;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding-bottom: 64px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  [hidden] {
    display: none !important;
  }
</style>

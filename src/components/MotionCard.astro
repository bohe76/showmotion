---
import type { Motion } from '../data/types';
import { localized, motionTitle, searchTerms, searchWords } from '../data/motions';
import { ui, localeMeta, pageHref, motionSubpath, type Locale } from '../i18n/locales';
import DemoStage from './DemoStage.astro';
import CircleArrowRight from '@lucide/astro/icons/circle-arrow-right';

interface Props {
  motion: Motion;
  locale: Locale;
  // 제목 수준 — 전체 페이지는 카테고리 제목(h2) 아래라 h3
  headingLevel?: 2 | 3;
}

const { motion, locale, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const t = ui[locale];
const promptId = `prompt-${motion.id}`;
const nameId = `name-${motion.id}`;
const localName = motion.localName[locale];
const title = motionTitle(motion, locale);
const description = localized(motion.description, locale);
const useFor = localized(motion.useFor, locale);
const prompt = localized(motion.prompt, locale);
const promptLang = prompt.fallback ? 'en' : localeMeta[locale].tag;
const detailHref = pageHref(locale, motionSubpath(motion.id));
---
<!-- 카드의 직계 자식 5개(stage, head, description, use-for, actions)가 그리드 subgrid 행에 맞춰 정렬된다 -->
<article
  class="card"
  id={motion.id}
  data-motion-card
  data-name={motion.name}
  data-search={searchTerms(motion).join('|')}
  data-words={searchWords(motion, locale)}
  aria-labelledby={nameId}
>
  <DemoStage motion={motion} locale={locale} nameId={nameId} />

  <div class="head">
    <!-- 제목이 상세 페이지 링크다. 오른쪽 아이콘은 링크라는 표시(스크린리더에는 숨기고, 링크 이름은 제목 글자) -->
    <!-- 툴팁("자세히 보기")은 링크 오른쪽 끝, 아이콘 위에 뜬다 -->
    <Heading class="name" id={nameId}>
      <a class="name-link" href={detailHref} data-tooltip={t.viewDetails}><span lang="en">{motion.name}</span>{localName && ` (${localName})`}<CircleArrowRight class="name-icon" size={24} stroke-width={2} aria-hidden="true" /></a>
    </Heading>
    {motion.aliases.length > 0 && (
      <p class="aliases"><span class="label">{t.aliases}</span> <span lang="en">{motion.aliases.join(', ')}</span></p>
    )}
  </div>

  <p class="description" lang={description.fallback ? 'en' : undefined}>{description.text}</p>

  <div class="use-for">
    <p class="section-label">{t.useFor}</p>
    <p lang={useFor.fallback ? 'en' : undefined}>{useFor.text}</p>
  </div>

  <div class="actions">
    <button type="button" class="copy" hidden aria-describedby={nameId} data-copy={promptId}>
      {t.copyPrompt}
    </button>
    <button
      type="button"
      class="view"
      hidden
      aria-describedby={nameId}
      aria-haspopup="dialog"
      data-view={promptId}
      data-title={title}
    >
      {t.viewPrompt}
    </button>
    <span class="copy-status" role="status" aria-live="polite"></span>
    <!-- JS 가 없으면 버튼 대신 상세 페이지로 보낸다 — 상세 페이지는 프롬프트 전문을 스크립트 없이 보여 준다 -->
    <noscript>
      <a class="view noscript-link" href={detailHref}>{t.viewPrompt}</a>
    </noscript>
  </div>

  <!-- 프롬프트 원문: 화면에는 공통 모달로만 보여 준다 (display:none 이라 그리드 행을 차지하지 않는다) -->
  <pre id={promptId} hidden lang={promptLang}>{prompt.text}</pre>
</article>

<style>
  .card {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    /* 열을 0 까지 줄 수 있게 해야 Marquee 트랙(max-content) 폭이 스테이지를 밀어내지 않는다 */
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    scroll-margin-top: 24px;
  }
  [hidden] {
    display: none !important;
  }
  .head {
    padding: 18px 18px 0;
  }
  .name {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .name-link {
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .name-link:hover,
  .name-link:focus-visible {
    text-decoration: underline;
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다 */
  .name-link :global(.name-icon) {
    margin-left: 6px;
    vertical-align: -0.2em;
    color: var(--muted);
    transition: color 150ms ease-out;
  }
  .name-link:hover :global(.name-icon),
  .name-link:focus-visible :global(.name-icon) {
    color: var(--accent);
  }
  .aliases {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .label {
    font-weight: 600;
  }
  .description {
    margin: 0;
    padding: 12px 18px 16px;
    line-height: 1.55;
  }
  .use-for {
    margin: 0 18px;
    padding: 12px 0 16px;
    border-top: 1px solid var(--line);
  }
  .use-for p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .use-for .section-label {
    margin-bottom: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* 버튼 글자는 줄바꿈하지 않는다 — 폭은 글자 폭에서 시작해 남는 공간을 나눠 채운다.
     두 버튼이 한 줄에 안 들어가는 언어·카드 폭이면 버튼째 다음 줄로 내려가 각자 전체 폭을 쓴다 */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-end;
    align-self: end;
    gap: 8px;
    /* 버튼(40px)이 스크립트 실행 뒤 나타나도 레이아웃이 밀리지 않게 높이를 미리 확보한다 */
    min-height: 58px;
    padding: 0 18px 18px;
  }
  .noscript-link {
    display: grid;
    place-items: center;
    flex-basis: 100%;
    text-decoration: none;
  }
  .copy,
  .view {
    flex: 1 1 auto;
    white-space: nowrap;
  }
  .copy {
    min-height: 40px;
    padding: 8px 16px;
    font: inherit;
    font-weight: 600;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .copy:hover {
    background: var(--accent-strong);
  }
  .view {
    min-height: 40px;
    padding: 8px 14px;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 150ms ease-out;
  }
  .view:hover {
    border-color: var(--ink);
  }
  /* 결과는 복사 버튼 라벨로 보여 주고, 이 영역은 스크린리더 안내용으로만 둔다 */
  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

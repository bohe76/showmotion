---
// 모션 그래픽 데모의 공통 부품 — 글줄 묶음. 머리줄(작고 흐린 낱말 하나) + 글줄 몇 개가 한 묶음이고, 묶음 여럿이 한 기둥으로 선다
// 크레딧·문단·데이터처럼 "글이 많이 있다"는 것을 보여 주는 자리 채움이다(Credit Roll, Title Crawl, Streaming Text)
// 글은 알파벳을 차례로 끊어 만든 낱말 모양의 묶음이다 — 가짜 문장·가짜 이름을 쓰지 않는다
// 데모는 자기 루트 아래에서 :global(.mgl | .mgl-block | .mgl-head | .mgl-line) 를 잡는다
// 크기는 모두 .mgl 의 font-size(기본 4.2cqw)에 대한 비율(em)이다 — 데모가 font-size 하나만 바꾸면 묶음 전체가 같이 커지거나 준다
// 이 파일은 demos/ 밖에 둔다 — demos/registry.ts 가 demos/*/ 의 파일을 모두 데모로 본다

interface Props {
  // 묶음 수
  blocks?: number;
  // 묶음마다 글줄 수
  lines?: number;
  // 묶음 머리줄을 둘지
  heads?: boolean;
  // 글자를 이만큼 건너뛰고 시작한다 — 한 화면에 여러 개를 놓을 때 서로 다른 글이 되게 한다
  skip?: number;
}

const { blocks = 4, lines = 2, heads = true, skip = 0 } = Astro.props;

// 낱말 길이를 돌려 쓰며 알파벳을 차례로 끊는다: ABC · DEFG · HI · JKLMN …
const lengths = [3, 4, 2, 5, 3, 4];
let letter = skip;
let count = skip;
function word(): string {
  const length = lengths[count++ % lengths.length];
  return Array.from({ length }, () => String.fromCharCode(65 + (letter++ % 26))).join('');
}
function line(words: number): string {
  return Array.from({ length: words }, word).join(' ');
}
const content = Array.from({ length: blocks }, (_, b) => ({
  head: heads ? line(1) : '',
  lines: Array.from({ length: lines }, (_, l) => line(2 + ((b + l) % 2))),
}));
---
<div class="mgl">
  {content.map((block) => (
    <div class="mgl-block">
      {block.head && <span class="mgl-head">{block.head}</span>}
      {block.lines.map((text) => <span class="mgl-line">{text}</span>)}
    </div>
  ))}
</div>

<style>
  .mgl,
  .mgl-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .mgl {
    gap: 1em;
    font-size: 4.2cqw;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--ink);
  }
  .mgl-head {
    font-size: 0.62em;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
</style>

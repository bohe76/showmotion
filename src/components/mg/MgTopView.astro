---
// 모션 그래픽 카메라 데모의 "위에서 보기" — 같은 장면을 위에서 내려다본 그림 (규약: docs/content/prompt_writing_guide.md §조작 줄)
// 화면만 봐서는 "배경이 다르게 밀린다"로만 보이는 차이의 원인을 보여 준다: 카메라가 제자리에서 도는지(Pan), 몸이 움직이는지(Truck)
// MgFrame 안에서 MgScene 다음에 둔다. 데모 루트에 data-view="top" 이 붙으면 장면을 덮고 나타난다(상세 페이지의 시점 조작)
// 데모는 자기 루트 아래에서 :global(.mgt-cam) 을 움직인다 — 원점이 카메라 위치라 rotate 는 제자리 회전, translate 는 이동이다
//
// 화면과 기하가 맞아야 한다: 화면에 보이는 것 = 시야(부채꼴) 안에 있는 것 (2026-10-02 사용자 지적)
// 그래서 블록을 보기 좋은 자리에 두지 않고 계산해서 놓는다. 거리 z 인 줄에서 시야의 폭은 W = 2 × tan × z 이고,
// 화면 가로 위치 s(가운데 0, 양 끝 ±0.5)·화면 폭 비율 w 인 블록은 가운데에서 s × W 떨어진 곳에 폭 w × W 로 놓인다
// → 가까운 줄(A)은 시야가 좁은 곳이라 작고 가운데로 모이고, 먼 줄(C)은 크고 넓게 퍼진다
// 줄의 거리는 MgScene 의 --mg-z-near · --mg-z-far (가운데 = 1). 카메라 데모의 이동량도 같은 값에서 나온다
import Video from '@lucide/astro/icons/video';

// 장면(MgScene)의 블록 — 화면 가로 위치 s 와 화면 폭 비율 w. MgScene 의 배치를 바꾸면 여기도 맞춘다
// 레이어는 화면 폭의 2배이고 왼쪽으로 반 넘친다: 레이어의 left l%, 폭 p% → 화면 가운데 기준 s = (2l + p − 100) / 100, w = 2p / 100
const onScreen = (left: number, width: number) => ({ s: (2 * left + width - 100) / 100, w: (2 * width) / 100 });
// 뒤 줄은 그림 밖으로 나가는 양 끝 둘씩을 빼고 그린다
const far = [24, 35.5, 56.5, 68].map((left) => onScreen(left, 8));
const near = [27, 67].map((left) => onScreen(left, 7));
const place = (o: { s: number; w: number }) => `--s: ${o.s.toFixed(3)}; --w: ${o.w}`;
---
<div class="mgt">
  <!-- 카메라: 시야(부채꼴)와 아이콘. 블록보다 먼저 그려 시야가 블록 아래에 깔린다 -->
  <div class="mgt-cam">
    <span class="mgt-view"></span>
    <Video class="mgt-icon" aria-hidden="true" />
  </div>
  {far.map((o) => <span class="mgt-o mgt-c" style={place(o)}>C</span>)}
  <span class="mgt-o mgt-b" style="--s: 0; --w: 0.18">B</span>
  {near.map((o) => <span class="mgt-o mgt-a" style={place(o)}>A</span>)}
</div>

<style>
  .mgt {
    /* 가운데 줄(B)까지의 거리, 시야 반각의 탄젠트, 카메라의 세로 위치 */
    --mgt-unit: 19cqw;
    --mgt-tan: 1.15;
    --mgt-cam-y: 51cqw;
    /* 가운데 줄에서의 시야 폭 = 화면 폭에 해당하는 거리. 카메라 데모가 이동량을 여기서 계산한다 */
    --mgt-mid-width: calc(2 * var(--mgt-tan) * var(--mgt-unit));
    position: absolute;
    inset: 0;
    display: none;
    font-weight: 700;
    line-height: 1;
    background: var(--surface);
  }
  :global([data-demo-root][data-view='top']) .mgt {
    display: block;
  }
  .mgt-o {
    --mgt-row-width: calc(2 * var(--mgt-tan) * var(--z) * var(--mgt-unit));
    position: absolute;
    top: calc(var(--mgt-cam-y) - var(--z) * var(--mgt-unit) - var(--h) / 2);
    left: calc(50cqw + (var(--s) - var(--w) / 2) * var(--mgt-row-width));
    display: grid;
    place-items: center;
    width: calc(var(--w) * var(--mgt-row-width));
    height: var(--h);
    border-radius: 2px;
  }
  .mgt-c {
    --z: var(--mg-z-far);
    --h: 4cqw;
    font-size: 3cqw;
    color: var(--muted);
    background: var(--demo-muted);
  }
  .mgt-b {
    --z: 1;
    --h: 5cqw;
    font-size: 3.4cqw;
    color: var(--on-accent);
    background: var(--accent);
  }
  .mgt-a {
    --z: var(--mg-z-near);
    --h: 3cqw;
    font-size: 2cqw;
    color: var(--surface);
    background: var(--ink);
  }
  /* 카메라 위치(크기 0 인 점). 자식은 이 점을 기준으로 놓는다 */
  .mgt-cam {
    position: absolute;
    top: var(--mgt-cam-y);
    left: 50cqw;
    width: 0;
    height: 0;
  }
  /* 시야: 카메라에서 위로 벌어지는 부채꼴. 돌아가도 끝이 보이지 않게 그림보다 길게 그린다 */
  .mgt-view {
    --mgt-view-length: 90cqw;
    position: absolute;
    bottom: 0;
    left: calc(var(--mgt-tan) * var(--mgt-view-length) * -1);
    width: calc(2 * var(--mgt-tan) * var(--mgt-view-length));
    height: var(--mgt-view-length);
    background: var(--highlight);
    clip-path: polygon(50% 100%, 0 0, 100% 0);
    opacity: 0.7;
  }
  /* 아이콘은 Lucide 컴포넌트가 그리므로 :global 로 잡는다. 캠코더가 오른쪽을 보고 있어 위를 보게 돌린다. 렌즈 끝이 카메라 위치에 온다 */
  .mgt-cam :global(.mgt-icon) {
    position: absolute;
    top: -0.5cqw;
    left: -2.5cqw;
    width: 5cqw;
    height: 5cqw;
    color: var(--ink);
    rotate: -90deg;
  }
</style>

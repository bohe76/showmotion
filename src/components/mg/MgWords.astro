---
// 모션 그래픽 데모의 공통 부품 — 낱말 줄. 낱말 모양의 글자 묶음(ABC · DEFG …)을 한 줄로 놓는다
// 가짜 문장 대신 쓰는 자리 채움이다 — 자막·제목처럼 "낱말 단위"가 보여야 하는 용어가 쓴다(Karaoke Captions, Pop Captions, Pop-In)
// 데모는 자기 루트 아래에서 :global(.mgw | .mgw-word) 를 잡는다. 낱말마다 --i(0 부터)가 있어 차례(지연)를 계산할 수 있다
// 글자 크기는 .mgw 의 font-size 하나로 정한다(기본 4.5cqw) — 데모가 덮어쓴다
// 이 파일은 demos/ 밖에 둔다 — demos/registry.ts 가 demos/*/ 의 파일을 모두 데모로 본다

interface Props {
  // 낱말들. 같은 낱말을 쓰는 데모끼리는 기본값을 그대로 둔다(Karaoke ↔ Pop Captions 가 같은 낱말·같은 박자다)
  words?: string[];
  // 영상(장면) 위에 얹는 글자 — 바탕색 외곽선을 둘러 어떤 장면 위에서도 읽힌다
  outline?: boolean;
}

const { words = ['ABC', 'DEFG', 'HI', 'JKL', 'MNOP'], outline = false } = Astro.props;
---
<div class:list={['mgw', { 'mgw-outline': outline }]}>
  {words.map((word, i) => <span class="mgw-word" style={`--i: ${i}`}>{word}</span>)}
</div>

<style>
  .mgw {
    display: flex;
    gap: 0.4em;
    font-size: 4.5cqw;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    color: var(--ink);
  }
  /* 획은 글자 윤곽의 안팎으로 반씩 걸린다 — 채움을 나중에 칠해 바깥쪽 반만 외곽선으로 남긴다 */
  .mgw-outline .mgw-word {
    -webkit-text-stroke: 0.24em var(--surface);
    paint-order: stroke fill;
  }
</style>

---
// 화면 효과 데모가 같이 쓰는 "영상" — 공통 장면(MgScene)에서 주인공 B 가 화면을 가로질러 간다. 효과는 얹을 영상이 있어야 보인다
// 효과 데모 열 개가 모두 같은 영상을 쓴다 — 영상이 같아야 효과끼리의 차이만 보인다(Glitch · RGB Split · Datamosh · VHS Look 등)
// B 의 움직임(시간의 %): 천천히 흐르다가(0~14) 휙 건너가고(14~22) 천천히 흐르다가(22~62) 다시 휙 건너가고(62~70) 천천히 흐른다(70~100)
//   빠른 순간이 둘이다 — 효과가 없는 앞쪽과 효과가 걸린 뒤쪽을 한 번의 재생 안에서 견줄 수 있다(Motion Blur 는 둘째 질주에만 번짐을 건다)
// 쓰는 법: 화면 틀 안에 <MgFxFootage /> 를 넣는다. 데모 루트에 .is-playing 이 붙으면 저절로 재생된다(길이는 MgFrame 의 --mg-duration)
//   한 데모에 여러 번 넣어도 모두 같은 박자로 간다(가로 띠로 잘라 어긋내는 Glitch, 블록으로 쪼개는 Datamosh)
//   B 자체(.mgs-b)의 animation 은 여기서 쓰고 있다 — 데모가 B 에 움직임을 더하려면 B 가 든 레이어(.mgs-mid)나 B 의 의사 요소에 건다
// 이 파일은 demos/ 밖에 둔다 — demos/registry.ts 가 demos/*/ 의 파일을 모두 데모로 본다
import MgScene from './MgScene.astro';

interface Props {
  // MgScene 의 bleed 그대로 — 영상을 통째로 밀거나 일그러뜨려 가장자리가 딸려 오는 데모가 켠다
  bleed?: boolean;
}

const { bleed = false } = Astro.props;
---
<div class="mgfx"><MgScene bleed={bleed} /></div>

<style>
  .mgfx {
    position: absolute;
    inset: 0;
  }
  .mgfx :global(.mgs-b) {
    translate: -23cqw 0;
  }
  :global([data-demo-root].is-playing) .mgfx :global(.mgs-b) {
    animation: mg-fx-run var(--mg-duration) linear forwards;
  }
  @keyframes mg-fx-run {
    0% {
      translate: -23cqw 0;
    }
    14% {
      translate: -21cqw 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    22% {
      translate: -3cqw 0;
    }
    62% {
      translate: 3cqw 0;
      animation-timing-function: cubic-bezier(0.5, 0, 0.5, 1);
    }
    70% {
      translate: 21cqw 0;
    }
    100% {
      translate: 24cqw 0;
    }
  }
</style>

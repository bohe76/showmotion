---
// 모션 그래픽 데모의 공통 부품 — 로고 자리 채움. 도형 셋으로 짠 표식(네모 · 동그라미 · 막대)과 낱말 ABC 를 나란히 놓는다
// 가짜 브랜드 대신 쓴다 — 로고·작품이 "하나의 완성된 그림"으로 보여야 하는 용어가 쓴다(Logo Resolve, Logo Reveal, Liquid Motion, Perspective Tilt)
// 같은 표식을 써야 Logo Resolve 와 Logo Reveal 처럼 헷갈리는 용어의 차이가 보인다 — 끝 장면이 같고, 거기까지 가는 길만 다르다
// 데모는 자기 루트 아래에서 :global(.mgm | .mgm-mark | .mgm-word | .mgm-piece) 를 잡는다
//   조각마다 --i 가 있다: 네모 0 · 동그라미 1 · 막대 2 · A 3 · B 4 · C 5. 조각 하나만 잡을 때는 .mgm-square | .mgm-circle | .mgm-bar | .mgm-letter
// 크기는 모두 .mgm 의 font-size(기본 15cqw = 표식 한 변)에 대한 비율(em)이다 — 데모가 font-size 하나만 바꾸면 전체가 같이 커지거나 준다
// 이 파일은 demos/ 밖에 둔다 — demos/registry.ts 가 demos/*/ 의 파일을 모두 데모로 본다

interface Props {
  // 표식 옆에 낱말(ABC)을 둘지
  word?: boolean;
}

const { word = true } = Astro.props;
---
<div class="mgm">
  <span class="mgm-mark">
    <span class="mgm-piece mgm-square" style="--i: 0"></span>
    <span class="mgm-piece mgm-circle" style="--i: 1"></span>
    <span class="mgm-piece mgm-bar" style="--i: 2"></span>
  </span>
  {word && (
    <span class="mgm-word">
      {['A', 'B', 'C'].map((letter, i) => <span class="mgm-piece mgm-letter" style={`--i: ${i + 3}`}>{letter}</span>)}
    </span>
  )}
</div>

<style>
  .mgm {
    display: flex;
    gap: 0.3em;
    align-items: center;
    font-size: 15cqw;
    line-height: 1;
    white-space: nowrap;
  }
  .mgm-mark {
    position: relative;
    flex: none;
    width: 1em;
    height: 1em;
  }
  .mgm-square,
  .mgm-circle,
  .mgm-bar {
    position: absolute;
  }
  .mgm-square {
    top: 0;
    left: 0;
    width: 0.56em;
    height: 0.56em;
    background: var(--accent);
    border-radius: 0.06em;
  }
  .mgm-circle {
    top: 0.11em;
    left: 0.66em;
    width: 0.34em;
    height: 0.34em;
    background: var(--ink);
    border-radius: 50%;
  }
  .mgm-bar {
    top: 0.68em;
    left: 0;
    width: 1em;
    height: 0.32em;
    background: var(--ink);
    border-radius: 0.06em;
  }
  .mgm-word {
    display: flex;
    font-size: 0.86em;
    font-weight: 800;
    color: var(--ink);
  }
  .mgm-letter {
    display: block;
  }
</style>

---
// 모션 그래픽 데모의 공통 장면 — 뒤(C)·가운데(B)·앞(A) 세 레이어 (규약: docs/content/prompt_writing_guide.md §모션 그래픽 데모)
// 모든 카메라·컷·시간 데모가 같은 장면을 쓴다. 같은 장면이라야 Pan 과 Truck 처럼 헷갈리는 용어의 차이가 보인다
// 레이어는 화면보다 넓다(화면 폭의 2배, 좌우로 반씩 넘침) — 카메라가 움직여도 가장자리가 비지 않는다
// 데모는 자기 루트 아래에서 :global(.mgs-far | .mgs-mid | .mgs-near | .mgs-layer | .mgs-b) 를 움직인다. 크기·이동은 화면 폭 기준(cqw)
// 이 파일은 demos/ 밖에 둔다 — demos/registry.ts 가 demos/*/ 의 파일을 모두 데모로 본다

interface Props {
  // 바닥과 앞 기둥을 화면 밖까지 잇는다(바닥은 좌우로도). 장면을 줄이거나 위로 밀거나 기울이는 데모(Zoom·Tilt·Roll 등)가 켠다
  // 기본은 꺼짐 — 화면 틀 안의 모습은 켜도 꺼도 같고, 꺼 두면 화면 밖에 아무것도 없다(다음 샷이 밀고 들어오는 전환 데모가 가려지지 않는다)
  bleed?: boolean;
}

const { bleed = false } = Astro.props;

// 뒤 레이어의 막대: 레이어 폭에 대한 왼쪽 위치(%)와 화면 높이에 대한 높이(%)
// 가운데(35.5~56.5%)는 비워 둔다 — 처음 화면에서 B 바로 뒤에 막대가 겹치지 않게. 글자는 막대 위쪽에 둬서 B 가 지나가도 가려지지 않는다
const far = [
  { left: 1, height: 38 },
  { left: 12.5, height: 46 },
  { left: 24, height: 36 },
  { left: 35.5, height: 50 },
  { left: 56.5, height: 40 },
  { left: 68, height: 48 },
  { left: 79.5, height: 36 },
  { left: 91, height: 44 },
];
---
<div class:list={['mgs', { 'mgs-bleed': bleed }]}>
  <div class="mgs-layer mgs-far">
    {far.map((bar) => <span class="mgs-c" style={`left: ${bar.left}%; height: ${bar.height}%`}>C</span>)}
  </div>
  <span class="mgs-ground"></span>
  <div class="mgs-layer mgs-mid">
    <span class="mgs-b">B</span>
  </div>
  <div class="mgs-layer mgs-near">
    <span class="mgs-a" style="left: 27%">A</span>
    <span class="mgs-a" style="left: 67%">A</span>
  </div>
</div>

<style>
  .mgs {
    position: absolute;
    inset: 0;
    font-weight: 700;
    line-height: 1;
  }
  /* 화면 왼쪽으로 반, 오른쪽으로 반 넘친다 — 레이어의 25%~75% 구간이 처음에 화면에 보인다 */
  .mgs-layer {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -50%;
    width: 200%;
  }
  .mgs-c,
  .mgs-b,
  .mgs-a {
    position: absolute;
    display: grid;
    place-items: center;
  }
  /* 뒤: 흐린 막대 줄 */
  .mgs-c {
    bottom: 24%;
    align-items: start;
    width: 8%;
    padding-top: 2cqw;
    font-size: 5cqw;
    color: var(--muted);
    background: var(--demo-muted);
    border-radius: 2px 2px 0 0;
  }
  /* 바닥은 움직이지 않는 단색 띠 — 레이어가 아니다 */
  .mgs-ground {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 24%;
    background: var(--stage);
    border-top: 1px solid var(--line);
  }
  /* 가운데: 주인공 블록. 화면 한가운데 바닥 위에 선다 */
  .mgs-b {
    bottom: 16%;
    left: calc(50% - 9cqw);
    width: 18cqw;
    aspect-ratio: 1;
    font-size: 8cqw;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 3px;
  }
  /* 앞: 화면 양 끝의 짙은 기둥 */
  .mgs-a {
    bottom: 0;
    width: 7%;
    height: 50%;
    font-size: 8cqw;
    color: var(--surface);
    background: var(--ink);
    border-radius: 3px 3px 0 0;
  }
  /* bleed: 바닥은 좌우로 반씩 넓어지고, 바닥과 앞 기둥은 아래로 화면 높이(56.25cqw)만큼 더 이어진다. 요소 자체의 크기는 그대로 두고 밑에 덧댄다 — 글자 자리가 달라지지 않는다
     1cqw 겹쳐 댄다: 딱 맞대면 장면을 줄이거나 기울였을 때 이음매에 실금이 보인다(겹침이 줄인 뒤에도 1px 을 넘어야 한다) */
  .mgs-bleed .mgs-ground {
    right: -50%;
    left: -50%;
  }
  .mgs-bleed .mgs-ground::after,
  .mgs-bleed .mgs-a::after {
    content: '';
    position: absolute;
    top: calc(100% - 1cqw);
    right: 0;
    left: 0;
    height: 56.25cqw;
    background: inherit;
  }
</style>

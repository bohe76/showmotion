---
import SiteLayout from './SiteLayout.astro';
import DemoStage from './DemoStage.astro';
import MotionCard from './MotionCard.astro';
import MgControls from './mg/MgControls.astro';
import type { AnyMotion, MgMotion } from '../data/types';
import { localized, motionTitle } from '../data/motions';
import { catalog, categorySubpathIn, listSubpath, motionSubpathOf, sectionOf } from '../data/sections';
import { motionData } from '../layouts/structured-data';
import { categoryName } from '../data/categories';
import { localeMeta, pageHref, repoUrl, siteName, ui, type Locale } from '../i18n/locales';
import { splitPlaceholders } from '../i18n/placeholder';
import CircleArrowLeft from '@lucide/astro/icons/circle-arrow-left';
import CodeXml from '@lucide/astro/icons/code-xml';
import ExternalLink from '@lucide/astro/icons/external-link';

// 모션 상세 페이지 — 이름으로 검색해 바로 들어오는 사람을 위한 한 모션의 모든 정보. 두 구역(Web / Motion Graphics)이 같이 쓴다
interface Props {
  locale: Locale;
  motion: AnyMotion;
}

const { locale, motion } = Astro.props;
const t = ui[locale];
const section = sectionOf(motion);
// 조작 줄은 모션 그래픽에만 있다. 변형이 둘 이상이면 조작 줄이 변형 목록을 대신한다
const mgMotion = section === 'mg' ? (motion as MgMotion) : null;
const Variants = mgMotion && motion.variants.length > 1 ? 'noscript' : Fragment;
const { categories, motionById, motionsIn, similar } = catalog(section);
const note = splitPlaceholders(section === 'mg' ? t.mg.promptNote : t.promptNote);
const nameId = `name-${motion.id}`;
const promptId = `prompt-${motion.id}`;
const localName = motion.localName[locale];
const description = localized(motion.description, locale);
const useFor = localized(motion.useFor, locale);
const prompt = localized(motion.prompt, locale);
const category = categoryName(motion.category);
// 이 데모의 소스 — 코드는 페이지에 싣지 않고(결정: 구현은 AI 가 한다), 보고 싶은 사람은 공개 저장소에서 본다
const sourceHref = `${repoUrl}/blob/main/src/components/demos/${motion.category}/${motion.id}.astro`;
const categoryHref = pageHref(locale, categorySubpathIn(section, motion.category));
// 돌아가기 버튼이 "사이트 안 목록에서 왔는지" 가리는 기준 — 이 언어·이 구역의 전체·카테고리 페이지 주소
const listPaths = [
  pageHref(locale, listSubpath(section)),
  ...categories.map((c) => pageHref(locale, categorySubpathIn(section, c.id))),
];

// 비슷한 모션: 눈으로 보면 헷갈리기 쉬운 모션 (src/data/similar.ts · mg.ts 의 mgSimilar, 카테고리가 달라도 된다) — 나란히 보며 정확한 이름을 찾게 한다
const lookAlikes = (similar[motion.id] ?? []).map((id) => motionById.get(id)!);

// 관련 모션: 같은 카테고리에서 이 모션 다음 순서부터 3개 (끝에 닿으면 처음으로). 비슷한 모션에 이미 나온 것은 뺀다
const siblings = motionsIn(motion.category);
const index = siblings.findIndex((m) => m.id === motion.id);
const related = [1, 2, 3]
  .map((step) => siblings[(index + step) % siblings.length])
  .filter(
    (m, i, list) =>
      m.id !== motion.id && list.findIndex((x) => x.id === m.id) === i && !lookAlikes.some((x) => x.id === m.id),
  );
---
<SiteLayout
  locale={locale}
  section={section}
  subpath={motionSubpathOf(motion)}
  title={`${motionTitle(motion, locale)} — ${siteName}`}
  description={description.text}
  jsonLd={motionData(Astro.site!, locale, motion)}
>
  <!-- 돌아가기: 기본은 카테고리 페이지. 사이트 안 목록에서 왔으면 스크립트가 브라우저 뒤로 가기로 바꿔 스크롤 위치를 지킨다 -->
  <!-- 아이콘만 보이고, 이름은 aria-label(스크린리더)과 data-tooltip(툴팁)으로 전한다. 화면 왼쪽 끝이라 툴팁을 왼쪽에 맞춘다 -->
  <a
    class="back"
    href={categoryHref}
    aria-label={t.back}
    data-tooltip={t.back}
    data-tooltip-align="start"
    data-back-link
    data-list-paths={JSON.stringify(listPaths)}
  >
    <CircleArrowLeft size={32} stroke-width={1.75} aria-hidden="true" />
  </a>

  <article class="detail" aria-labelledby={nameId} data-motion-card>
    <!-- 모션 그래픽은 데모 아래에 조작 줄(변형·길이·깊이·시점)이 붙는다 — DemoStage 바로 다음 형제여야 gallery.ts 가 찾는다 -->
    <div class="demo">
      <DemoStage motion={motion} locale={locale} nameId={nameId} size="large" />
      {mgMotion && <MgControls motion={mgMotion} locale={locale} />}
    </div>

    <div class="body">
      <p class="category"><a href={categoryHref} lang="en">{category}</a></p>
      <h1 class="name" id={nameId}><span lang="en">{motion.name}</span>{localName && ` (${localName})`}</h1>
      {motion.aliases.length > 0 && (
        <p class="aliases"><span class="label">{t.aliases}</span> <span lang="en">{motion.aliases.join(', ')}</span></p>
      )}
      <p class="description" lang={description.fallback ? 'en' : undefined}>{description.text}</p>

      <h2 class="section-label">{t.useFor}</h2>
      <p lang={useFor.fallback ? 'en' : undefined}>{useFor.text}</p>

      <!-- 모션 그래픽은 변형을 데모 아래 조작 줄에서 고르므로 여기에는 다시 적지 않는다(JS 가 꺼져 조작 줄이 없을 때만 보인다) -->
      {motion.variants.length > 0 && (
        <Variants>
          <h2 class="section-label">{t.variants}</h2>
          <ul class="variants" lang="en">
            {motion.variants.map((v) => <li>{v}</li>)}
          </ul>
        </Variants>
      )}

      <!-- 사이트 밖(공개 저장소)으로 나가는 유일한 링크 — 새 탭으로 연다. 웹 모션에만 둔다: 모션 그래픽(영상)은 붙여 쓸 코드가 아니라 뺀다 (2026-10-02 사용자 지시) -->
      <!-- "Variants" 처럼 소제목을 달고 그 아래 테두리 버튼으로 둔다 — 소제목이 위의 변형 칩과 구역을 가른다. 아이콘은 글자 옆 장식이라 스크린리더에 숨긴다 -->
      {section === 'web' && (
        <>
          <h2 class="section-label">{t.source}</h2>
          <p class="source">
            <a href={sourceHref} target="_blank" rel="noopener noreferrer">
              <CodeXml size={16} aria-hidden="true" />
              {t.viewSource}
              <ExternalLink size={14} aria-hidden="true" />
            </a>
          </p>
        </>
      )}
    </div>
  </article>

  <section class="prompt" aria-labelledby="prompt-heading">
    <h2 id="prompt-heading">{t.promptHeading}</h2>
    <p class="prompt-note">{note.map((s) => (s.placeholder ? <mark class="ph">{s.text}</mark> : s.text))}</p>
    <!-- 화면에서는 자리 표시를 형광펜으로 칠한다. 복사는 이 요소의 textContent 라 원문 그대로다 -->
    <pre id={promptId} class="prompt-text" lang={prompt.fallback ? 'en' : localeMeta[locale].tag} tabindex="0">{splitPlaceholders(prompt.text).map((s) => (s.placeholder ? <mark class="ph">{s.text}</mark> : s.text))}</pre>
    <div class="prompt-actions">
      <button type="button" class="copy" hidden aria-describedby={nameId} data-copy={promptId} data-copy-inline>
        {t.copyPrompt}
      </button>
      <span class="copy-status" role="status" aria-live="polite"></span>
    </div>
  </section>

  {lookAlikes.length > 0 && (
    <section class="related" aria-labelledby="similar-heading">
      <h2 id="similar-heading">{t.similar}</h2>
      <div class="grid">
        {lookAlikes.map((m) => <MotionCard motion={m} locale={locale} />)}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">{t.related(category)}</h2>
      <div class="grid">
        {related.map((m) => <MotionCard motion={m} locale={locale} />)}
      </div>
    </section>
  )}
</SiteLayout>

<style>
  /* 원 테두리는 아이콘(CircleArrowLeft)이 그리므로 링크 자체는 테두리 없이 — 모달 닫기 버튼과 같은 방식 */
  .back {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-top: 20px;
    color: var(--muted);
    border-radius: 50%;
    transition: color 150ms ease-out;
  }
  .back:hover {
    color: var(--ink);
  }
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 28px;
    align-items: start;
    padding: 20px 0 32px;
  }
  @media (max-width: 860px) {
    .detail {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .body p {
    margin: 0;
    line-height: 1.6;
  }
  .category {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .category a {
    color: var(--accent);
  }
  .name {
    margin: 6px 0 0;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .aliases {
    margin-top: 8px !important;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .label {
    font-weight: 600;
  }
  .description {
    margin-top: 16px !important;
    font-size: 1.05rem;
  }
  .section-label {
    margin: 22px 0 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .variants {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .variants li {
    padding: 2px 10px;
    font-size: 0.875rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  /* 소제목(Source) 아래의 테두리 버튼 — 이 페이지의 주 행동(프롬프트 복사, 틸 채움)보다 한 단계 낮게 둔다 */
  .source {
    margin-top: 4px !important;
  }
  .source a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    transition: border-color 150ms ease-out;
  }
  .source a:hover {
    border-color: var(--ink);
  }
  /* 새 탭 표시는 글자보다 흐리게 */
  .source a :global(svg:last-child) {
    color: var(--muted);
  }
  .prompt {
    padding-bottom: 40px;
  }
  /* 프롬프트 본문만 읽기 좋은 폭으로 묶는다. 위의 안내 줄(.prompt-note)은 전체 폭을 써서 데스크톱에서 한 줄로 끝난다 */
  .prompt-text,
  .prompt-actions {
    max-width: 760px;
  }
  .prompt h2,
  .related h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  .prompt-note {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .prompt-text {
    margin: 12px 0 0;
    padding: 14px;
    overflow: auto;
    font-size: 0.95rem;
    line-height: 1.65;
    white-space: pre-wrap;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .prompt-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 54px;
    padding-top: 14px;
  }
  .copy {
    min-height: 40px;
    padding: 8px 16px;
    font: inherit;
    font-weight: 600;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 150ms ease-out;
  }
  .copy:hover {
    background: var(--accent-strong);
  }
  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .copy-status.is-visible {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    white-space: normal;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .related {
    padding: 32px 0 64px;
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 16px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  [hidden] {
    display: none !important;
  }
</style>
